{%- comment -%}
  Renders a 5-star row filled to match a decimal rating.
  Uses full / half / empty stars so the visual matches the number shown.
  Usage: {% render 'rating-stars', rating: '4.7', size: 'text-sm' %}
{%- endcomment -%}
{%- assign rs_num = rating | default: 5 | times: 1.0 -%}
{%- assign rs_full = rs_num | floor -%}
{%- assign rs_remainder = rs_num | minus: rs_full -%}
{%- assign rs_half_index = rs_full | plus: 1 -%}
{%- assign rs_size = size | default: 'text-sm' -%}
<div class="flex gap-0.5">
  {%- for i in (1..5) -%}
    {%- if i <= rs_full -%}
      <span class="material-symbols-outlined text-[#C5A059] {{ rs_size }}" style="font-variation-settings:'FILL' 1,'wght' 400;">star</span>
    {%- elsif i == rs_half_index and rs_remainder >= 0.85 -%}
      <span class="material-symbols-outlined text-[#C5A059] {{ rs_size }}" style="font-variation-settings:'FILL' 1,'wght' 400;">star</span>
    {%- elsif i == rs_half_index and rs_remainder >= 0.25 -%}
      <span class="material-symbols-outlined text-[#C5A059] {{ rs_size }}" style="font-variation-settings:'FILL' 1,'wght' 400;">star_half</span>
    {%- else -%}
      <span class="material-symbols-outlined text-[#C5A059] {{ rs_size }}" style="font-variation-settings:'FILL' 0,'wght' 400;">star</span>
    {%- endif -%}
  {%- endfor -%}
</div>
