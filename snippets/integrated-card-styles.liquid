{% doc %}
Refined product cards shared across collection and recommendation grids.
@param {string} scope_id - Parent section element ID
{% enddoc %}
<style>
#{{ scope_id }} .ol-card-media-link{display:block;text-decoration:none;color:inherit}
#{{ scope_id }} .ol-card-name a{color:inherit;text-decoration:none}
#{{ scope_id }} .ol-card-name a:focus-visible,#{{ scope_id }} .ol-card-media-link:focus-visible,#{{ scope_id }} .orb-badge:focus-visible{outline:2px solid #8c7859;outline-offset:-2px}
#{{ scope_id }} .ol-card-grid{gap:18px 16px}
#{{ scope_id }} .ol-integrated-card{position:relative;display:flex;flex-direction:column;border:1px solid #dddcd5;border-radius:6px;background:#f8f7f3;text-decoration:none;min-width:0;overflow:hidden;box-shadow:none;transition:border-color .2s ease,box-shadow .2s ease}
#{{ scope_id }} .ol-integrated-card .ol-card-media{position:relative;inset:auto;width:100%;height:auto;aspect-ratio:1;border:0;border-radius:0;background:#eeece8;overflow:hidden}
#{{ scope_id }} .ol-integrated-card .ol-card-media img{width:100%;height:100%;object-fit:contain;padding:0;transition:transform .5s ease}
#{{ scope_id }} .ol-integrated-card .ol-card-info{position:relative;inset:auto;display:grid;flex:1;grid-template-columns:minmax(0,1fr) auto;align-content:start;align-items:center;gap:7px 10px;padding:13px 14px;background:#f8f7f3;min-width:0;min-height:0}
#{{ scope_id }} .ol-integrated-card .ol-card-info::before{display:none}
#{{ scope_id }} .ol-integrated-card .ol-card-name{grid-column:1;grid-row:1;order:0;font-family:'Newsreader',Georgia,serif;font-size:26px;font-weight:400;line-height:1.15;letter-spacing:-.025em;color:#242522;margin:0}
#{{ scope_id }} .ol-integrated-card .ol-card-price{grid-column:2;grid-row:1;order:3;display:flex;flex-wrap:wrap;align-items:baseline;gap:6px;margin:0;font-family:'Manrope',sans-serif;font-size:15px;font-weight:500;line-height:1.5;color:#242522;opacity:1;font-variant-numeric:tabular-nums;letter-spacing:0}
#{{ scope_id }} .ol-integrated-card .ol-card-price .now--sale{color:#242522}
#{{ scope_id }} .ol-integrated-card .ol-card-price s{font-size:11px!important;font-weight:400;color:#777873;opacity:1!important;margin-left:0!important;text-decoration-thickness:1px}
#{{ scope_id }} .ol-integrated-card .outlight-review-badge{grid-column:1 / -1;grid-row:2;order:1;margin:0;line-height:1.3}
#{{ scope_id }} .ol-integrated-card .orb-badge{gap:6px;font-size:11px;line-height:1.3;color:#74756f}
#{{ scope_id }} .ol-integrated-card .orb-count{font-size:11px;color:#74756f}
#{{ scope_id }} .ol-integrated-card .orb-stars{gap:1px;color:#8c7859}
#{{ scope_id }} .ol-integrated-card .orb-stars svg{width:10px;height:10px}
#{{ scope_id }} .ol-integrated-card .ol-card-category{position:absolute;top:14px;left:14px;right:auto;z-index:3;max-width:calc(100% - 28px);margin:0;padding:6px 8px;border:0;border-radius:0;background:#faf9f5e6;color:#494b45;font-family:'Manrope',sans-serif;font-size:9px;font-weight:500;line-height:1.2;letter-spacing:.09em;text-transform:uppercase;opacity:1}
#{{ scope_id }} .ol-integrated-card .ol-card-info .ol-stock{grid-column:1 / -1;grid-row:2;order:2;margin:0;font-size:11px;line-height:1.4;font-weight:400;letter-spacing:.015em}
#{{ scope_id }} .ol-integrated-card .ol-card-info .ol-stock--low{position:absolute;grid-column:auto;grid-row:auto;bottom:calc(100% + 10px);left:10px;z-index:4;display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border:1px solid #d4a18b55;border-radius:3px;background:#fff5ebf5;color:#873c26;font-weight:500}
#{{ scope_id }} .ol-integrated-card .ol-card-info .ol-stock[hidden]{display:none}
#{{ scope_id }} .ol-integrated-card .ol-card-info .ol-stock--sold{color:#74756f;font-weight:400;letter-spacing:0;text-transform:none}
#{{ scope_id }} .ol-integrated-card.ol-card-sold .ol-card-price{display:none}
#{{ scope_id }} .ol-integrated-card .ed-card__arrow,#{{ scope_id }} .ol-integrated-card .card__arrow,#{{ scope_id }} .ol-integrated-card .quick{display:none}
#{{ scope_id }} .ol-integrated-card:focus-visible{outline:2px solid #8c7859;outline-offset:5px}
@media(max-width:1100px){
#{{ scope_id }} .ol-integrated-card .ol-card-info{grid-template-columns:minmax(0,1fr);gap:5px;padding:11px 12px}
#{{ scope_id }} .ol-integrated-card .ol-card-price{grid-column:1;grid-row:3;margin-top:2px}
}
@media(max-width:680px){
#{{ scope_id }} .ol-card-grid{gap:12px 10px}
#{{ scope_id }} .ol-integrated-card .ol-card-info{padding:10px;min-height:0}
#{{ scope_id }} .ol-integrated-card .ol-card-name{font-size:23px}
#{{ scope_id }} .ol-integrated-card .ol-card-price{font-size:14px;gap:6px}
#{{ scope_id }} .ol-integrated-card .ol-card-price s{font-size:10px!important}
#{{ scope_id }} .ol-integrated-card .orb-badge,#{{ scope_id }} .ol-integrated-card .orb-count{font-size:10px}
#{{ scope_id }} .ol-integrated-card .ol-card-info .ol-stock--low{left:8px;bottom:calc(100% + 8px);padding:4px 6px;font-size:10px}
}
@media(prefers-reduced-motion:reduce){#{{ scope_id }} .ol-integrated-card .ol-card-media img{transition:none}}

#{{ scope_id }} .ol-integrated-card:hover:not(.ol-card-sold){border-color:#beb7a8;box-shadow:0 5px 18px #25262209}
#{{ scope_id }} .ol-sale-badge{position:absolute;z-index:4;top:12px;right:12px;background:#a2472e;color:#fff;padding:7px 9px;border-radius:3px;font:500 10px/1.2 'Manrope',sans-serif;letter-spacing:.025em}
#{{ scope_id }} .ol-integrated-card .ol-card-category{top:12px;left:12px;max-width:calc(100% - 110px);font-size:8px;letter-spacing:.05em;padding:6px 7px}
#{{ scope_id }} .ol-integrated-card .ol-stock--image.ol-stock--sold{inset:auto 12px 12px auto;padding:8px 12px;border:0;background:#363831ed;color:#fff;font-size:10px;font-weight:500}
@media(max-width:680px){#{{ scope_id }} .ol-sale-badge{top:8px;right:8px;padding:6px 7px;font-size:9px}#{{ scope_id }} .ol-integrated-card .ol-card-category{top:8px;left:8px;max-width:calc(100% - 77px);font-size:7px;line-height:1.3;padding:5px}#{{ scope_id }} .ol-integrated-card .ol-stock--image.ol-stock--sold{right:8px;bottom:8px;padding:7px 10px;font-size:9px}}
</style>
