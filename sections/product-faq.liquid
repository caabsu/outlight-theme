{%- comment -%}
  Product FAQ Section — Outlight
  Type-driven FAQ system. Auto-detects product category (plug-in lamp,
  indoor wall light, outdoor) from product.type + collections + optional
  metafield override (custom.faq_type ∈ {"plug-in","wall-indoor","outdoor"}).
  Renders 6 type-appropriate FAQs.
  Per-product opt-out: set product metafield custom.faq_hide (boolean) to true
  to suppress this section entirely on that product.
{%- endcomment -%}

{%- if product.metafields.custom.faq_hide -%}
  {%- comment -%} Product opted out of FAQ section via custom.faq_hide. {%- endcomment -%}
{%- else -%}

{%- liquid
  assign type_lc = product.type | downcase
  assign product_faq_type = 'plug-in'

  if type_lc contains 'outdoor' or type_lc contains 'path' or type_lc contains 'landscape'
    assign product_faq_type = 'outdoor'
  elsif type_lc contains 'wall' or type_lc contains 'sconce'
    assign product_faq_type = 'wall-indoor'
  elsif type_lc contains 'floor' or type_lc contains 'table' or type_lc contains 'desk' or type_lc contains 'bedside' or type_lc contains 'lamp'
    assign product_faq_type = 'plug-in'
  endif

  for col in product.collections
    assign h = col.handle | downcase
    if h == 'outdoor-lighting' or h == 'wall-lights' or h == 'path-lights' or h contains 'outdoor'
      assign product_faq_type = 'outdoor'
    elsif h == 'indoor-wall-lights'
      if product_faq_type != 'outdoor'
        assign product_faq_type = 'wall-indoor'
      endif
    endif
  endfor

  assign faq_type_override = product.metafields.custom.faq_type.value | downcase
  if faq_type_override == 'plug-in' or faq_type_override == 'wall-indoor' or faq_type_override == 'outdoor'
    assign product_faq_type = faq_type_override
  endif

  if product_faq_type == 'outdoor'
    assign q1 = "What's included in the box?"
    assign a1 = "The fixture, mounting plate, weather gasket, all required hardware, and a printed installation guide. Bulb included only where specifically noted on the product page."
    assign q2 = "What's the IP rating, and where can I install it?"
    assign a2 = "Built for outdoor use — the full IP rating is listed on each product page. Suitable for porches, exterior walls, patios, driveways, and entryways. Covered placement extends finish life in harsh weather."
    assign q3 = "Does it require an electrician to install?"
    assign a3 = "Yes — outdoor hardwiring should always be done by a licensed electrician. The fixture mounts to a standard outdoor-rated junction box; supplied gaskets and weather-sealed fittings protect the connection."
    assign q4 = "How fast does it ship?"
    assign a4 = 'clearance.delivery_faq' | t
    assign q5 = "Can I return it if it's not right?"
    assign a5 = 'policies.returns' | t
    assign q6 = "What's the warranty?"
    assign a6 = 'policies.warranty' | t
  elsif product_faq_type == 'wall-indoor'
    assign q1 = "What's included in the box?"
    assign a1 = "The fixture, mounting plate, all required hardware (screws, anchors, wire nuts), and a printed installation guide. Bulb included only where specifically noted on the product page."
    assign q2 = "Does it require an electrician to install?"
    assign a2 = "Yes — this is a hardwired fixture, and we strongly recommend a licensed electrician. It mounts to a standard US junction box; most installs take under 30 minutes once the box is exposed."
    assign q3 = "What bulb does it use, and is it dimmable?"
    assign a3 = "Bulb base and quantity are listed on the product page (typically E12, E14, or G9 for sconces). The fixture is fully dimmable when wired to a compatible dimmer with a dimmable bulb."
    assign q4 = "How fast does it ship?"
    assign a4 = 'clearance.delivery_faq' | t
    assign q5 = "Can I return it if it's not right?"
    assign a5 = 'policies.returns' | t
    assign q6 = "What's the warranty?"
    assign a6 = 'policies.warranty' | t
  else
    assign q1 = "What's included in the box?"
    assign a1 = "The lamp body, an attached inline-switch cord ready to plug into any standard US outlet, and a warm LED bulb. Setup takes about a minute — no tools required."
    assign q2 = "What bulb does it use, and is it dimmable?"
    assign a2 = "Standard Edison-screw fitting (E26 for most floor and table lamps, E14 for smaller desk lamps — see the product page for the exact base). Ships with a warm LED (≈2700–3000 K) and is dimmable when paired with a standard wall dimmer or a smart bulb."
    assign q3 = "How long is the cord, and where does the switch sit?"
    assign a3 = "Approximately 6 ft / 1.8 m — long enough to reach a wall outlet from a sofa-side, nightstand, or desk position. The on/off switch sits inline on the cord, within easy reach."
    assign q4 = "How fast does it ship?"
    assign a4 = 'clearance.delivery_faq' | t
    assign q5 = "Can I return it if it's not right?"
    assign a5 = 'policies.returns' | t
    assign q6 = "What's the warranty?"
    assign a6 = 'policies.warranty' | t
  endif

  capture qs_raw
    echo q1
    echo '|||'
    echo q2
    echo '|||'
    echo q3
    echo '|||'
    echo q4
    echo '|||'
    echo q5
    echo '|||'
    echo q6
  endcapture
  capture as_raw
    echo a1
    echo '|||'
    echo a2
    echo '|||'
    echo a3
    echo '|||'
    echo a4
    echo '|||'
    echo a5
    echo '|||'
    echo a6
  endcapture
  assign qs = qs_raw | split: '|||'
  assign as = as_raw | split: '|||'
-%}

<style>
  .pf-accordion-content { max-height:0; overflow:hidden; transition:max-height 0.5s cubic-bezier(0.16,1,0.3,1); }
  .pf-accordion-content.open { max-height:600px; }
  .pf-accordion-icon { transition:transform 0.3s ease; display:inline-block; }
  .pf-accordion-trigger.open .pf-accordion-icon { transform:rotate(45deg); }
  .heading-thin { font-family:'Newsreader',serif; font-weight:200; font-variation-settings:'opsz' 72; }
</style>

<section style="background-color:#F9F9FB;">
  <div class="max-w-[1920px] mx-auto px-5 md:px-12 py-16 md:py-24">

    {%- comment -%} Header — centered {%- endcomment -%}
    <div class="text-center mb-12 md:mb-16">
      <span class="font-label block mb-4" style="font-size:0.6rem;text-transform:uppercase;letter-spacing:0.25em;color:#C5A059;">{{ section.settings.label }}</span>
      <h2 class="heading-thin text-[#131314] tracking-tight" style="font-size:2.4rem;">{{ section.settings.heading }}</h2>
    </div>

    {%- comment -%} FAQ list — max-width for readability {%- endcomment -%}
    <div style="max-width:820px;margin:0 auto;">
      {%- for q in qs -%}
        {%- assign idx = forloop.index -%}
        {%- assign idx_str = idx | prepend: '0' | slice: -2, 2 -%}
        {%- assign a_text = as[forloop.index0] | strip -%}
        {%- assign q_text = q | strip -%}
        <div style="border-top:1px solid rgba(19,19,20,0.06);">
          <button
            class="pf-accordion-trigger w-full flex items-center justify-between py-6"
            onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open');"
          >
            <div class="flex items-center" style="gap:24px;">
              <span class="font-label" style="font-size:0.6rem;color:rgba(197,160,89,0.5);">{{ idx_str }}</span>
              <span class="font-headline font-[300] text-[#131314]" style="font-size:1.15rem;text-align:left;">{{ q_text }}</span>
            </div>
            <span class="pf-accordion-icon font-body" style="font-size:1.2rem;color:rgba(19,19,20,0.3);">+</span>
          </button>
          <div class="pf-accordion-content"{% if forloop.last %} style="border-bottom:1px solid rgba(19,19,20,0.06);"{% endif %}>
            <div style="padding:0 0 24px 42px;">
              <p class="font-body font-light text-[#596065] leading-relaxed" style="font-size:0.9rem;">{{ a_text }}</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- endif -%}

{% schema %}
{
  "name": "Product FAQ",
  "tag": "section",
  "class": "product-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked"
    }
  ],
  "presets": [
    {
      "name": "Product FAQ"
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
