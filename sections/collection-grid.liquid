{% comment %}
  collection-grid.liquid
  Reusable Indoor / Outdoor collection grid section.
  - Desktop: 12-column grid with 1px gaps between cards, configurable per block.
  - Mobile: 2-column grid.
  - Each block is a collection card with configurable col-span (7 or 5), height, and index label.
  - The section can be dropped twice on the home page (once for Indoor, once for Outdoor).
{% endcomment %}

{%- assign blocks_count = section.blocks.size -%}

<section class="bg-[#F9F9FB] px-5 md:px-12 pt-16 md:pt-24 pb-10 md:pb-16" id="section-{{ section.id }}">
  <div class="max-w-[1920px] mx-auto">

    {%- comment %} Section heading + View All link {%- endcomment %}
    <div class="flex items-baseline justify-between mb-10 md:mb-16">
      <h2 class="font-headline text-3xl md:text-5xl font-[200] text-[#131314] tracking-tight">
        {{- section.settings.heading | escape -}}
      </h2>
      {%- if section.settings.view_all_url != blank -%}
        <a
          href="{{ section.settings.view_all_url }}"
          class="font-label text-[0.6rem] md:text-[0.78rem] uppercase tracking-[0.15em] text-[#2d3338]/55 hover:text-[#131314] transition-colors duration-300"
        >View All →</a>
      {%- endif -%}
    </div>

    {%- comment %} ── Desktop grid ── {%- endcomment %}
    <div class="hidden md:grid grid-cols-12 gap-[1px] bg-[#131314]/8">
      {%- for block in section.blocks -%}
        {%- assign col_span = block.settings.grid_span | default: '5' -%}
        {%- assign card_height = block.settings.height | default: 400 -%}
        {%- assign card_index = block.settings.index | default: forloop.index -%}

        {%- assign collection = block.settings.collection -%}
        {%- assign card_url = collection.url | default: '#' -%}
        {%- assign card_title = collection.title | default: 'Collection' -%}

        <a
          href="{{ card_url }}"
          class="collection-card col-span-{{ col_span }} group block relative bg-[#F9F9FB]"
          {{ block.shopify_attributes }}
        >
          <div class="relative overflow-hidden" style="height: {{ card_height }}px;">

            {%- comment %} Image or warm gradient fallback {%- endcomment %}
            {%- if collection.featured_image != blank -%}
              <img
                src="{{ collection.featured_image | image_url: width: 1200 }}"
                alt="{{ collection.featured_image.alt | default: card_title | escape }}"
                class="img-placeholder w-full h-full object-cover"
                loading="lazy"
              >
            {%- else -%}
              {%- assign fallback_index = forloop.index | modulo: 7 | plus: 1 -%}
              <div class="img-placeholder img-warm-{{ fallback_index }} w-full h-full"></div>
            {%- endif -%}

            {%- comment %} Gradient overlay {%- endcomment %}
            <div class="absolute inset-0 bg-gradient-to-t from-[#131314]/50 via-transparent to-transparent"></div>

            {%- comment %} Inset decorative border {%- endcomment %}
            <div class="absolute inset-4 border border-white/15 pointer-events-none"></div>
            <div class="border-draw absolute inset-4 pointer-events-none"></div>

            {%- comment %} Index label {%- endcomment %}
            <div class="absolute top-8 left-8">
              <span class="font-label text-[0.55rem] uppercase tracking-[0.2em] text-white/30">
                {{- card_index | escape -}}
              </span>
            </div>

            {%- comment %} Title + arrow button {%- endcomment %}
            <div class="absolute bottom-8 left-8 right-8 flex items-end justify-between">
              <div>
                <span class="font-headline text-2xl md:text-3xl font-[200] text-white block">
                  {{- card_title | escape -}}
                </span>
              </div>
              <div class="w-8 h-8 border border-white/10 flex items-center justify-center group-hover:border-[#C5A059]/40 transition-colors duration-400">
                <span class="material-symbols-outlined text-white/25 group-hover:text-[#C5A059] text-base transition-colors duration-400">arrow_forward</span>
              </div>
            </div>

          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- comment %} ── Mobile grid ── {%- endcomment %}
    <div class="grid md:hidden grid-cols-2 gap-x-3 gap-y-[1px]">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- assign card_url = collection.url | default: '#' -%}
        {%- assign card_title = collection.title | default: 'Collection' -%}

        {%- comment %} Last odd card spans full width on mobile {%- endcomment %}
        {%- assign is_last = false -%}
        {%- assign last_index = blocks_count | minus: 1 -%}
        {%- if forloop.index0 == last_index and blocks_count != even -%}
          {%- assign is_last = true -%}
        {%- endif -%}

        <a
          href="{{ card_url }}"
          class="collection-card group block bg-[#F9F9FB]{% if is_last %} col-span-2{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="relative overflow-hidden {% if is_last %}aspect-[2/1]{% else %}aspect-[3/4]{% endif %}">

            {%- if collection.featured_image != blank -%}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.featured_image.alt | default: card_title | escape }}"
                class="img-placeholder w-full h-full object-cover"
                loading="lazy"
              >
            {%- else -%}
              {%- assign fallback_index = forloop.index | modulo: 7 | plus: 1 -%}
              <div class="img-placeholder img-warm-{{ fallback_index }} w-full h-full"></div>
            {%- endif -%}

            <div class="absolute inset-0 bg-gradient-to-t from-[#131314]/50 via-transparent to-transparent"></div>
            <div class="absolute inset-2 border border-white/12 pointer-events-none"></div>
            <div class="border-draw absolute inset-2 pointer-events-none"></div>

            <div class="absolute bottom-4 left-4 right-4">
              <span class="font-headline text-base font-[200] text-white block">
                {{- card_title | escape -}}
              </span>
            </div>

          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "collection-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Indoor Lighting"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "\"View All\" link URL"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "select",
          "id": "grid_span",
          "label": "Desktop column span",
          "options": [
            { "value": "7", "label": "7 columns (wide)" },
            { "value": "5", "label": "5 columns (narrow)" }
          ],
          "default": "5"
        },
        {
          "type": "range",
          "id": "height",
          "label": "Card height (desktop)",
          "min": 300,
          "max": 600,
          "step": 10,
          "unit": "px",
          "default": 400
        },
        {
          "type": "text",
          "id": "index",
          "label": "Index label (e.g. 01)",
          "default": "01"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Grid",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "grid_span": "7",
            "height": 520,
            "index": "01"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "grid_span": "5",
            "height": 520,
            "index": "02"
          }
        }
      ]
    }
  ]
}
{% endschema %}
