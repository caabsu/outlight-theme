<style>
  /* ═══════════════════════════════════════════════════════════
     ATELIER — Editorial Whitespace Design
     Premium, luxury article layout with generous breathing room
     ═══════════════════════════════════════════════════════════ */

  .article-shell {
    max-width: 52rem;
    margin-left: auto;
    margin-right: auto;
  }

  .article-text-rail {
    max-width: 42rem;
  }

  /* ── Title ── */
  .article-title {
    font-family: Newsreader, serif;
    font-size: clamp(3rem, 5.5vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #131314;
    max-width: 48rem;
    font-weight: 300;
  }

  /* ── Headings ── */
  .article-rte h2,
  .article-rte h3,
  .article-rte h4 {
    font-family: Newsreader, serif;
    color: #131314;
    letter-spacing: -0.02em;
  }

  .article-rte h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.05;
    font-weight: 300;
    margin-top: 0;
    margin-bottom: 1.4rem;
  }

  .article-rte h3 {
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    line-height: 1.14;
    font-weight: 400;
    margin-top: 3rem;
    margin-bottom: 0.9rem;
  }

  /* ── Body copy ── */
  .article-rte p {
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .article-rte h2 + p,
  .article-rte h3 + p {
    color: rgba(19, 19, 20, 0.86);
  }

  /* ── Lists ── */
  .article-rte ul,
  .article-rte ol {
    margin: 1.2rem 0 2rem;
    padding-left: 1.6rem;
  }

  .article-rte ul { list-style: disc; }
  .article-rte ol { list-style: decimal; }

  .article-rte li {
    padding-left: 0.25rem;
    margin-bottom: 0.85rem;
    line-height: 1.88;
  }

  /* ── Inline elements ── */
  .article-rte strong {
    font-weight: 600;
    color: #131314;
  }

  .article-rte a {
    color: #131314;
    text-decoration: underline;
    text-decoration-color: rgba(197, 160, 89, 0.55);
    text-underline-offset: 0.2em;
    transition: color 0.3s ease;
  }

  .article-rte a:hover {
    color: #C5A059;
  }

  .article-rte code {
    font-size: 0.92em;
    background: rgba(19, 19, 20, 0.04);
    padding: 0.12rem 0.35rem;
    border-radius: 2px;
  }

  /* ── Gold horizontal rule (Atelier signature) ── */
  .article-rte hr,
  .atelier-rule {
    border: 0;
    border-top: 1px solid rgba(197, 160, 89, 0.3);
    margin: 3.5rem 0;
  }

  .atelier-rule--header {
    margin: 2.5rem 0 3rem;
  }

  /* ── Blockquote / Pull quote (Atelier signature) ── */
  .article-rte blockquote {
    margin: 3.5rem 0 3.5rem -1.5rem;
    padding: 2.5rem 0 2.5rem 2.5rem;
    border-left: 1px solid rgba(197, 160, 89, 0.35);
    position: relative;
    background: none;
  }

  .article-rte blockquote::before {
    content: '\201C';
    font-family: Newsreader, serif;
    font-size: 5rem;
    font-weight: 200;
    color: rgba(197, 160, 89, 0.22);
    position: absolute;
    top: -0.6rem;
    left: 2.5rem;
    line-height: 1;
    pointer-events: none;
  }

  .article-rte blockquote p {
    font-family: Newsreader, serif;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.65;
    font-weight: 300;
    font-style: italic;
    color: rgba(19, 19, 20, 0.65);
    margin-bottom: 0;
  }

  /* ── Tables (warm background panel) ── */
  .article-table-wrap {
    background: #f8f5ef;
    border-radius: 3px;
    padding: 1.8rem 2rem;
    margin: 2rem 0 2.8rem;
  }

  .article-rte table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .article-rte th,
  .article-rte td {
    text-align: left;
    vertical-align: top;
    padding: 0.95rem 1rem 0.95rem 0;
    border-bottom: 1px solid rgba(19, 19, 20, 0.08);
  }

  .article-rte th {
    font-family: Manrope, sans-serif;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(19, 19, 20, 0.5);
    font-weight: 500;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(19, 19, 20, 0.12);
  }

  .article-rte td a {
    font-weight: 500;
  }

  .article-rte tbody tr:last-child td {
    border-bottom: none;
  }

  /* ── Figures / Images ── */
  .article-rte figure {
    margin: 3.5rem 0 3.5rem;
    max-width: 100%;
  }

  .article-rte figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }

  .article-rte figcaption {
    margin-top: 1.1rem;
    font-family: Manrope, sans-serif;
    font-size: 0.68rem;
    line-height: 1.55;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(19, 19, 20, 0.48);
    max-width: 34rem;
    text-align: left;
    font-weight: 400;
  }

  @media (min-width: 768px) {
    .article-rte figure.article-figure-wide {
      max-width: 100%;
    }

    /* ── Breakout: extends beyond text rail to shell width ── */
    .article-rte figure.article-figure-breakout {
      max-width: none;
      width: calc(100% + 10rem);
      margin-left: -5rem;
      margin-right: -5rem;
    }

    /* ── Aside: floats right with text wrap ── */
    .article-rte figure.article-figure-aside {
      float: right;
      width: 48%;
      margin: 0.5rem 0 2rem 2.5rem;
      clear: right;
    }

    .article-rte figure.article-figure-aside-left {
      float: left;
      width: 48%;
      margin: 0.5rem 2.5rem 2rem 0;
      clear: left;
    }

    /* ── Pair: two images side-by-side ── */
    .article-rte .article-figure-pair {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin: 3.5rem 0;
    }

    .article-rte .article-figure-pair figure {
      margin: 0;
    }

    .article-rte .article-figure-pair figcaption {
      margin-top: 0.8rem;
      font-size: 0.62rem;
    }

    /* ── Inset: smaller centered image for detail shots ── */
    .article-rte figure.article-figure-inset {
      max-width: 70%;
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* Mobile: all layout variants collapse to full-width stack */
  @media (max-width: 767px) {
    .article-rte figure.article-figure-breakout,
    .article-rte figure.article-figure-aside,
    .article-rte figure.article-figure-aside-left,
    .article-rte figure.article-figure-inset {
      float: none;
      width: 100%;
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    .article-rte .article-figure-pair {
      display: block;
    }

    .article-rte .article-figure-pair figure {
      margin: 2rem 0;
    }
  }

  /* ── Intro section ── */
  .article-intro {
    margin-bottom: 0;
  }

  /* ── Drop cap (Atelier signature) ── */
  .article-intro .article-lead {
    font-family: Newsreader, serif;
    font-size: clamp(1.18rem, 1.8vw, 1.4rem);
    line-height: 1.78;
    color: rgba(19, 19, 20, 0.88);
    font-weight: 300;
  }

  .article-intro .article-lead::first-letter {
    font-family: Newsreader, serif;
    float: left;
    font-size: 4.6rem;
    line-height: 0.78;
    font-weight: 400;
    color: #C5A059;
    padding-right: 0.55rem;
    padding-top: 0.14rem;
  }

  /* ── Sections (Atelier spacing + gold rules) ── */
  .article-section {
    margin-top: 0;
    padding-top: 3.5rem;
    border-top: 1px solid rgba(197, 160, 89, 0.3);
  }

  .article-section:first-of-type {
    margin-top: 3.5rem;
  }

  .article-section--utility {
    padding-top: 3rem;
    border-top: 1px solid rgba(197, 160, 89, 0.3);
  }

  .article-section--utility h2 {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    line-height: 1.06;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .article-section--utility ul,
  .article-section--utility ol {
    margin-bottom: 1.25rem;
  }

  .article-section--utility li {
    margin-bottom: 0.7rem;
  }

  .article-section--guide h2,
  .article-section--quick h2 {
    color: #131314;
  }

  .article-section--snapshot figure {
    margin-top: 2.2rem;
  }

  .article-section--faq {
    padding-top: 3.5rem;
    border-top: 1px solid rgba(197, 160, 89, 0.3);
  }

  .article-section--faq h2 {
    margin-top: 0;
  }

  /* ── FAQ styling ── */
  .article-rte .faq-item {
    border-top: 1px solid rgba(19, 19, 20, 0.06);
    padding: 1.5rem 0;
  }

  .article-rte .faq-item:first-of-type {
    border-top: none;
  }

  /* ── Footer nav ── */
  .article-footer-nav {
    border-top: 1px solid rgba(197, 160, 89, 0.3);
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .article-title {
      font-size: clamp(2.4rem, 10vw, 3.4rem);
      max-width: 100%;
    }

    .article-intro {
      margin-bottom: 0;
    }

    .article-section {
      padding-top: 2.8rem;
    }

    .article-rte blockquote {
      margin-left: 0;
      padding-left: 1.5rem;
    }

    .article-rte blockquote::before {
      font-size: 3.5rem;
      left: 1.5rem;
    }

    .article-table-wrap {
      padding: 1.2rem 1rem;
      margin-left: -0.5rem;
      margin-right: -0.5rem;
    }

    .article-intro .article-lead::first-letter {
      font-size: 3.6rem;
    }
  }
</style>

<section class="pt-[36px] md:pt-[52px]">
  <!-- ── Header ── -->
  <div class="px-5 md:px-12 pt-10 md:pt-16 pb-4 md:pb-6">
    <div class="article-shell">
      <nav class="font-label text-[0.55rem] md:text-[0.62rem] uppercase tracking-[0.18em] text-[#7d8387] mb-6 md:mb-8">
        <a href="{{ routes.root_url }}" class="hover:text-[#C5A059] transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="{{ blog.url }}" class="hover:text-[#C5A059] transition-colors">{{ blog.title }}</a>
      </nav>

      <span class="font-label text-[0.55rem] md:text-[0.62rem] uppercase tracking-[0.28em] text-[#C5A059] block mb-6 md:mb-8">
        {{ section.settings.label }}
      </span>

      <h1 class="article-title mb-6 md:mb-8">
        {{ article.title }}
      </h1>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[#7d8387] mb-0">
        <time class="font-body text-[0.82rem] md:text-[0.9rem] font-light" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%B %d, %Y' }}
        </time>
        {% if article.author != blank %}
          <span class="w-[3px] h-[3px] rounded-full bg-[#C5A059]"></span>
          <span class="font-body text-[0.82rem] md:text-[0.9rem] font-light">By {{ article.author }}</span>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- ── Gold rule after header ── -->
  <div class="px-5 md:px-12">
    <div class="article-shell">
      <hr class="atelier-rule atelier-rule--header">
    </div>
  </div>

  <!-- ── Hero image ── -->
  {% if article.image %}
    <div class="px-5 md:px-12 pb-4 md:pb-6">
      <div class="article-shell">
        {{ article.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '800,1200,1600,1800', sizes: '(min-width: 1024px) 48rem, 100vw', class: 'w-full aspect-[16/9] object-cover rounded-[2px]' }}
      </div>
    </div>
  {% endif %}

  <!-- ── Article body ── -->
  <div class="px-5 md:px-12 pb-20 md:pb-28">
    <div class="article-shell rte article-rte font-body text-[1rem] md:text-[1.04rem] leading-[1.92] font-light text-[#131314]">
      <div class="article-text-rail" data-article-body>
        {{ article.content }}
      </div>
    </div>

    <!-- ── Footer navigation ── -->
    <div class="article-shell article-footer-nav mt-16 md:mt-20 pt-6 flex items-center justify-between gap-4">
      <a href="{{ blog.url }}" class="font-label text-[0.62rem] uppercase tracking-[0.16em] text-[#131314] hover:text-[#C5A059] transition-colors">
        &larr; Back to {{ blog.title }}
      </a>
      {% if section.settings.primary_collection_url != blank %}
        <a href="{{ section.settings.primary_collection_url }}" class="font-label text-[0.62rem] uppercase tracking-[0.16em] text-[#131314] hover:text-[#C5A059] transition-colors">
          {{ section.settings.primary_collection_label | default: 'Shop collection' }} &rarr;
        </a>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function() {
    var body = document.querySelector('[data-article-body]');
    if (!body || body.dataset.enhanced === 'true') return;

    var children = Array.prototype.slice.call(body.children);
    if (!children.length) return;

    /* ── Wrap intro (before first H2) ── */
    var firstHeadingIndex = children.findIndex(function(node) {
      return node.tagName === 'H2';
    });

    if (firstHeadingIndex > 0) {
      var intro = document.createElement('div');
      intro.className = 'article-intro';
      children.slice(0, firstHeadingIndex).forEach(function(node, index) {
        if (index === 0 && node.tagName === 'P') {
          node.classList.add('article-lead');
        }
        intro.appendChild(node);
      });
      body.insertBefore(intro, body.firstChild);
    } else if (firstHeadingIndex === -1 && body.firstElementChild && body.firstElementChild.tagName === 'P') {
      body.firstElementChild.classList.add('article-lead');
    }

    /* ── Wrap tables in warm background panel ── */
    var tables = body.querySelectorAll('table');
    tables.forEach(function(table) {
      if (table.parentElement && table.parentElement.classList.contains('article-table-wrap')) return;
      var wrapper = document.createElement('div');
      wrapper.className = 'article-table-wrap';
      table.parentNode.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });

    /* ── Wrap H2-led sections ── */
    var nodes = Array.prototype.slice.call(body.children);
    var currentSection = null;

    function classifySection(section, headingText) {
      var normalized = (headingText || '').trim().toLowerCase();
      section.classList.add('article-section');

      if (normalized === 'quick answer') {
        section.classList.add('article-section--utility', 'article-section--quick');
      } else if (normalized === 'in this guide') {
        section.classList.add('article-section--utility', 'article-section--guide');
      } else if (normalized.indexOf('at a glance') !== -1) {
        section.classList.add('article-section--snapshot');
      } else if (normalized === 'faq') {
        section.classList.add('article-section--faq');
      }
    }

    nodes.forEach(function(node) {
      if (node.tagName === 'H2') {
        currentSection = document.createElement('section');
        classifySection(currentSection, node.textContent);
        body.appendChild(currentSection);
      }

      if (currentSection) {
        currentSection.appendChild(node);
      }
    });

    body.dataset.enhanced = 'true';
  })();
</script>

{% schema %}
{
  "name": "Main article",
  "tag": "section",
  "class": "section-main-article",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "primary_collection_label",
      "label": "Footer collection label",
      "default": "Shop indoor lighting"
    },
    {
      "type": "url",
      "id": "primary_collection_url",
      "label": "Footer collection URL"
    }
  ],
  "presets": [
    {
      "name": "Main article"
    }
  ]
}
{% endschema %}
