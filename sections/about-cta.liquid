{%- comment -%}
  about-cta.liquid — Editorial About closing CTA
  Two-column close: typographic statement + standards list, with CTAs.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign promise_blocks = section.blocks | where: 'type', 'promise' -%}

<style>
  #ed-aboutcta-{{ section.id }}{
    --ink:#131314;--paper:#F9F9FB;--gold:#C5A059;--warm:#f4f0eb;
    --body:#2d3338;--hairline:rgba(19,19,20,.14);--measure:1320px;
    display:block;background:var(--paper);font-family:'Manrope',sans-serif;
    padding:0 0 100px;
  }
  #ed-aboutcta-{{ section.id }} *{box-sizing:border-box;}
  #ed-aboutcta-{{ section.id }} .ed-wrap{
    max-width:var(--measure);margin:0 auto;padding:0 40px;
  }
  #ed-aboutcta-{{ section.id }} .ed-label{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:11px;
    letter-spacing:.26em;text-transform:uppercase;color:var(--body);
  }
  #ed-aboutcta-{{ section.id }} .cta{
    border-top:1px solid var(--ink);padding-top:74px;
    display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:start;
  }
  #ed-aboutcta-{{ section.id }} .cta__label{display:block;margin-bottom:24px;}
  #ed-aboutcta-{{ section.id }} .cta h2{
    font-family:'Newsreader',serif;font-weight:200;
    font-size:clamp(2.3rem,4.4vw,3.5rem);line-height:1.06;letter-spacing:-.012em;
    color:var(--ink);margin:0;max-width:16ch;
  }
  #ed-aboutcta-{{ section.id }} .cta h2 em{font-style:italic;font-weight:300;color:var(--gold);}
  #ed-aboutcta-{{ section.id }} .cta__lede{
    margin:28px 0 0;max-width:440px;font-size:15.5px;line-height:1.74;
    color:var(--body);font-weight:300;
  }
  #ed-aboutcta-{{ section.id }} .cta__actions{
    margin-top:40px;display:flex;align-items:center;gap:30px;flex-wrap:wrap;
  }
  #ed-aboutcta-{{ section.id }} .ed-btn{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:12px;
    letter-spacing:.18em;text-transform:uppercase;padding:18px 38px;
    background:var(--ink);color:var(--paper);border:1px solid var(--ink);
    transition:background .4s ease,color .4s ease;display:inline-block;text-align:center;
  }
  #ed-aboutcta-{{ section.id }} .ed-btn:hover{background:transparent;color:var(--ink);}
  #ed-aboutcta-{{ section.id }} .ed-btn--ghost{
    background:transparent;color:var(--ink);border:none;padding:0;position:relative;
    font-family:'Manrope',sans-serif;font-weight:500;font-size:12px;
    letter-spacing:.18em;text-transform:uppercase;display:inline-block;
  }
  #ed-aboutcta-{{ section.id }} .ed-btn--ghost .underline{
    display:block;height:1px;background:var(--ink);margin-top:6px;
    transform-origin:left;transform:scaleX(1);
    transition:transform .45s cubic-bezier(.16,.84,.44,1);
  }
  #ed-aboutcta-{{ section.id }} .ed-btn--ghost:hover .underline{transform:scaleX(0);}
  #ed-aboutcta-{{ section.id }} .cta__promises{
    border-top:1px solid var(--hairline);
  }
  #ed-aboutcta-{{ section.id }} .promise{
    display:flex;gap:20px;align-items:baseline;padding:18px 0;
    border-bottom:1px solid var(--hairline);
  }
  #ed-aboutcta-{{ section.id }} .promise__num{
    font-family:'Newsreader',serif;font-style:italic;font-weight:300;
    font-size:16px;color:var(--gold);flex:none;width:26px;
  }
  #ed-aboutcta-{{ section.id }} .promise__text{
    font-family:'Newsreader',serif;font-weight:300;font-size:18px;
    line-height:1.4;color:var(--ink);
  }
  #ed-aboutcta-{{ section.id }} .promise__text em{font-style:italic;color:var(--gold);}
  @media (max-width:880px){
    #ed-aboutcta-{{ section.id }}{padding-bottom:64px;}
    #ed-aboutcta-{{ section.id }} .ed-wrap{padding:0 22px;}
    #ed-aboutcta-{{ section.id }} .cta{
      grid-template-columns:1fr;gap:44px;padding-top:54px;
    }
  }
  @media (max-width:680px){
    #ed-aboutcta-{{ section.id }} .ed-wrap{padding:0 20px;}
    #ed-aboutcta-{{ section.id }} .cta h2{max-width:none;}
    #ed-aboutcta-{{ section.id }} .cta__lede{max-width:none;}
    #ed-aboutcta-{{ section.id }} .cta__actions{
      margin-top:32px;gap:20px;flex-direction:column;align-items:stretch;
    }
    #ed-aboutcta-{{ section.id }} .cta__actions .ed-btn{width:100%;padding:17px 24px;}
    #ed-aboutcta-{{ section.id }} .cta__actions .ed-btn--ghost{align-self:flex-start;}
    #ed-aboutcta-{{ section.id }} .promise__text{font-size:16px;}
  }
</style>

<section id="ed-aboutcta-{{ section.id }}">
  <div class="ed-wrap">
    <div class="cta">

      <div class="cta__type">
        {%- if s.label != blank -%}
          <span class="cta__label ed-label">{{ s.label | escape }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2>{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <p class="cta__lede">{{ s.subheading | escape }}</p>
        {%- endif -%}
        <div class="cta__actions">
          {%- if s.primary_button_label != blank -%}
            <a href="{{ s.primary_button_url | default: '/collections/best-sellers' }}" class="ed-btn">
              {{ s.primary_button_label | escape }}
            </a>
          {%- endif -%}
          {%- if s.secondary_button_label != blank -%}
            <a href="{{ s.secondary_button_url | default: '/collections' }}" class="ed-btn--ghost">
              {{ s.secondary_button_label | escape }}
              <span class="underline"></span>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if promise_blocks.size > 0 -%}
        <div class="cta__promises">
          {%- for block in promise_blocks -%}
            <div class="promise" {{ block.shopify_attributes }}>
              {%- if block.settings.number != blank -%}
                <span class="promise__num">{{ block.settings.number | escape }}</span>
              {%- endif -%}
              <span class="promise__text">
                {%- if block.settings.emphasis != blank -%}
                  <em>{{ block.settings.emphasis | escape }}</em> {{ block.settings.text | escape }}
                {%- else -%}
                  {{ block.settings.text | escape }}
                {%- endif -%}
              </span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About CTA",
  "tag": "section",
  "class": "ed-aboutcta-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "03 — The standards we hold"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>An LA brand, est. 2024 — <em>here to finish the room.</em></p>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We're a young brand, and we'd rather be honest about that than dress it up. What we promise is concrete: a curated range, every piece quality-checked, and a service backbone built to make buying lighting online feel safe."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Reviews & guarantees"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button URL"
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "emphasis",
          "label": "Emphasis phrase (gold italic)",
          "default": "Estimated 4-day"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Line text",
          "default": "shipping from a US warehouse."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About CTA",
      "blocks": [
        {
          "type": "promise",
          "settings": {
            "number": "01",
            "emphasis": "Estimated 4-day",
            "text": "shipping from a US warehouse."
          }
        },
        {
          "type": "promise",
          "settings": {
            "number": "02",
            "emphasis": "30-day",
            "text": "return request window; policy terms apply."
          }
        },
        {
          "type": "promise",
          "settings": {
            "number": "03",
            "emphasis": "2-year",
            "text": "warranty on outdoor fixtures."
          }
        },
        {
          "type": "promise",
          "settings": {
            "number": "04",
            "emphasis": "24-hour",
            "text": "support, from real people."
          }
        }
      ]
    }
  ]
}
{% endschema %}
