{%- comment -%}
  about-story.liquid — Editorial About story
  Split image + copy with a label, serif heading, body paragraphs and a pull quote.
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #ed-aboutstory-{{ section.id }}{
    --ink:#131314;--paper:#F9F9FB;--gold:#C5A059;--warm:#f4f0eb;
    --body:#2d3338;--hairline:rgba(19,19,20,.14);
    display:block;background:var(--paper);font-family:'Manrope',sans-serif;
    padding-top:96px;
  }
  #ed-aboutstory-{{ section.id }} *{box-sizing:border-box;}
  #ed-aboutstory-{{ section.id }} .aboutstory{
    display:grid;grid-template-columns:1fr 1fr;align-items:stretch;
  }
  #ed-aboutstory-{{ section.id }} .aboutstory__img{
    position:relative;overflow:hidden;min-height:580px;margin:0;
  }
  #ed-aboutstory-{{ section.id }} .aboutstory__img img{
    width:100%;height:100%;object-fit:cover;position:absolute;inset:0;
  }
  #ed-aboutstory-{{ section.id }} .aboutstory__ph{
    position:absolute;inset:0;
    background:linear-gradient(155deg,#3a342a 0%,#1a160f 100%);
  }
  #ed-aboutstory-{{ section.id }} .aboutstory__img figcaption{
    position:absolute;left:30px;bottom:28px;color:var(--paper);
    font-family:'Manrope',sans-serif;font-weight:400;font-size:10.5px;
    letter-spacing:.18em;text-transform:uppercase;
  }
  #ed-aboutstory-{{ section.id }} .aboutstory__copy{
    padding:84px 80px;display:flex;flex-direction:column;justify-content:center;
  }
  #ed-aboutstory-{{ section.id }} .ed-label{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:11px;
    letter-spacing:.26em;text-transform:uppercase;color:var(--body);
  }
  #ed-aboutstory-{{ section.id }} .aboutstory__copy h2{
    font-family:'Newsreader',serif;font-weight:200;
    font-size:clamp(2.2rem,3.6vw,3.3rem);line-height:1.08;letter-spacing:-.01em;
    margin:22px 0 0;color:var(--ink);
  }
  #ed-aboutstory-{{ section.id }} .aboutstory__copy h2 em{
    font-style:italic;font-weight:300;color:var(--gold);
  }
  #ed-aboutstory-{{ section.id }} .aboutstory__body p{
    font-size:15.5px;line-height:1.78;color:var(--body);font-weight:300;
    margin:24px 0 0;
  }
  #ed-aboutstory-{{ section.id }} .aboutstory__pull{
    font-family:'Newsreader',serif;font-style:italic;font-weight:300;
    font-size:clamp(1.25rem,1.9vw,1.55rem);line-height:1.45;color:var(--ink);
    margin:32px 0 0;padding-left:24px;border-left:1px solid var(--gold);
  }
  @media (max-width:880px){
    #ed-aboutstory-{{ section.id }}{padding-top:64px;}
    #ed-aboutstory-{{ section.id }} .aboutstory{grid-template-columns:1fr;}
    #ed-aboutstory-{{ section.id }} .aboutstory__img{min-height:340px;order:-1;}
    #ed-aboutstory-{{ section.id }} .aboutstory__copy{padding:52px 24px;}
  }
  @media (max-width:680px){
    #ed-aboutstory-{{ section.id }} .aboutstory__copy{padding:44px 20px;}
    #ed-aboutstory-{{ section.id }} .aboutstory__body p{font-size:15px;margin-top:20px;}
    #ed-aboutstory-{{ section.id }} .aboutstory__pull{margin-top:26px;padding-left:18px;}
  }
</style>

<section id="ed-aboutstory-{{ section.id }}">
  <div class="aboutstory">
    <figure class="aboutstory__img">
      {%- if s.image != blank -%}
        <img
          src="{{ s.image | image_url: width: 1200 }}"
          srcset="{{ s.image | image_url: width: 700 }} 700w, {{ s.image | image_url: width: 1200 }} 1200w"
          sizes="(max-width:880px) 100vw, 50vw"
          alt="{{ s.image.alt | escape | default: 'A warm room lit by Outlight lamps after dark' }}"
          width="{{ s.image.width }}"
          height="{{ s.image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="aboutstory__ph"></div>
      {%- endif -%}
      {%- if s.image_caption != blank -%}
        <figcaption>{{ s.image_caption | escape }}</figcaption>
      {%- endif -%}
    </figure>

    <div class="aboutstory__copy">
      {%- if s.label != blank -%}
        <span class="ed-label">{{ s.label | escape }}</span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2>{{ s.heading }}</h2>
      {%- endif -%}
      <div class="aboutstory__body">
        {%- if s.paragraph_1 != blank -%}
          <p>{{ s.paragraph_1 | escape }}</p>
        {%- endif -%}
        {%- if s.paragraph_2 != blank -%}
          <p>{{ s.paragraph_2 | escape }}</p>
        {%- endif -%}
      </div>
      {%- if s.pull_quote != blank -%}
        <blockquote class="aboutstory__pull">{{ s.pull_quote | escape }}</blockquote>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Story",
  "tag": "section",
  "class": "ed-aboutstory-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "01 — Our point of view"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Decorated by daylight. <em>Abandoned after dark.</em></p>"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "Most homes are styled for the day. The furniture is chosen, the room is composed — and then the sun goes down and a single overhead fixture takes over. Flat, even, a little anonymous. The room is still there, but the evening version of it never quite arrives."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Outlight exists for that hour. We believe a living room, an entry, or a bedside should feel as considered at 9pm as it does at noon — warm, layered, and finished. That conviction is the whole brief: lighting chosen for how a room feels once the lamps are the only thing on."
    },
    {
      "type": "textarea",
      "id": "pull_quote",
      "label": "Pull quote",
      "default": "The enemy was never the dark. It was flat overhead glare standing in for atmosphere."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption",
      "default": "Fig. 02 — The room, after dark"
    }
  ],
  "presets": [
    {
      "name": "About Story"
    }
  ]
}
{% endschema %}
