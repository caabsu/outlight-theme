{% comment %}
  Product Reviews Section — V2 Centered
  Outlight Theme v2
  Hardcoded reviews — replace with app integration (e.g. Judge.me, Okendo) as needed.
{% endcomment %}

<div id="product-reviews" class="bg-[#F9F9FB] py-16 md:py-24 px-5 md:px-12">
  <div class="max-w-[1920px] mx-auto">

    {%- comment -%} Centered summary header {%- endcomment -%}
    <div class="text-center mb-10 md:mb-14">
      <span class="font-label text-[0.5rem] md:text-[0.55rem] uppercase tracking-[0.3em] text-[#C5A059] block mb-4">Customer Reviews</span>
      <div class="flex items-center justify-center gap-2 md:gap-3 mb-3">
        <div class="flex gap-0.5">
          <span class="material-symbols-outlined text-[#C5A059] text-sm md:text-lg" style="font-variation-settings:'FILL' 1,'wght' 400;">star</span>
          <span class="material-symbols-outlined text-[#C5A059] text-sm md:text-lg" style="font-variation-settings:'FILL' 1,'wght' 400;">star</span>
          <span class="material-symbols-outlined text-[#C5A059] text-sm md:text-lg" style="font-variation-settings:'FILL' 1,'wght' 400;">star</span>
          <span class="material-symbols-outlined text-[#C5A059] text-sm md:text-lg" style="font-variation-settings:'FILL' 1,'wght' 400;">star</span>
          <span class="material-symbols-outlined text-[#C5A059] text-sm md:text-lg" style="font-variation-settings:'FILL' 1,'wght' 400;">star</span>
        </div>
        <span class="font-headline text-2xl md:text-3xl font-[200] text-[#131314]">{{ section.settings.average_rating }}</span>
      </div>
      <span class="font-body text-[0.7rem] md:text-[0.82rem] font-light text-[#2d3338]/55 block mb-5 md:mb-6">
        Based on {{ section.settings.review_count }} verified reviews
      </span>
      <button class="px-6 md:px-8 py-2.5 md:py-3 border border-[#131314]/10 font-label text-[0.55rem] md:text-[0.65rem] uppercase tracking-[0.12em] text-[#131314] hover:bg-[#131314] hover:text-[#F9F9FB] transition-all">
        Write a Review
      </button>
    </div>

    {%- comment -%} Desktop: two-column review cards {%- endcomment -%}
    <div class="hidden md:grid grid-cols-2 gap-[1px]" style="background:rgba(19,19,20,0.05);">

      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="bg-[#F9F9FB] p-8" {{ block.shopify_attributes }}>
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2">
                <span class="font-body text-[0.85rem] font-[400] text-[#131314]">{{ block.settings.reviewer_name }}</span>
                <span class="material-symbols-outlined text-[#C5A059] text-xs" style="font-variation-settings:'FILL' 1,'wght' 400;">verified</span>
              </div>
              <span class="font-body text-[0.62rem] font-light text-[#2d3338]/55">{{ block.settings.review_date }}</span>
            </div>
            <div class="flex gap-0.5 mb-4">
              {%- for i in (1..block.settings.star_rating) -%}
                <span class="material-symbols-outlined text-[#C5A059] text-sm" style="font-variation-settings:'FILL' 1,'wght' 400;">star</span>
              {%- endfor -%}
              {%- assign empty_stars = 5 | minus: block.settings.star_rating -%}
              {%- for i in (1..empty_stars) -%}
                <span class="material-symbols-outlined text-[#2d3338]/20 text-sm" style="font-variation-settings:'FILL' 0,'wght' 300;">star</span>
              {%- endfor -%}
            </div>
            <p class="font-body text-[0.85rem] font-[300] text-[#131314]/65 leading-relaxed mb-5">"{{ block.settings.review_text }}"</p>
            {%- if block.settings.review_image_1 != blank or block.settings.review_image_2 != blank -%}
              <div class="flex gap-2 mb-4">
                {%- if block.settings.review_image_1 != blank -%}
                  <img
                    src="{{ block.settings.review_image_1 | image_url: width: 128 }}"
                    alt="Review photo"
                    class="w-16 h-16 object-cover"
                    loading="lazy"
                    width="64"
                    height="64"
                  >
                {%- endif -%}
                {%- if block.settings.review_image_2 != blank -%}
                  <img
                    src="{{ block.settings.review_image_2 | image_url: width: 128 }}"
                    alt="Review photo"
                    class="w-16 h-16 object-cover"
                    loading="lazy"
                    width="64"
                    height="64"
                  >
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if block.settings.reviewed_item != blank -%}
              <div class="flex items-center gap-2">
                <span class="font-label text-[0.5rem] uppercase text-[#2d3338]/55">Item:</span>
                <span class="font-body text-[0.7rem] font-light text-[#2d3338]/55">{{ block.settings.reviewed_item }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    {%- comment -%} Mobile: stacked reviews {%- endcomment -%}
    <div class="md:hidden space-y-0">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="border-t border-[#131314]/5 py-5" {{ block.shopify_attributes }}>
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-1.5">
                <span class="font-body text-[0.88rem] font-[400] text-[#131314]">{{ block.settings.reviewer_name }}</span>
                <span class="material-symbols-outlined text-[#C5A059] text-[0.65rem]" style="font-variation-settings:'FILL' 1,'wght' 400;">verified</span>
              </div>
              <span class="font-body text-[0.65rem] font-light text-[#2d3338]/20">{{ block.settings.review_date }}</span>
            </div>
            <div class="flex gap-0.5 mb-3">
              {%- for i in (1..block.settings.star_rating) -%}
                <span class="material-symbols-outlined text-[#C5A059] text-xs" style="font-variation-settings:'FILL' 1,'wght' 400;">star</span>
              {%- endfor -%}
            </div>
            <p class="font-body text-[0.85rem] font-[300] text-[#131314]/60 leading-relaxed mb-3">"{{ block.settings.review_text }}"</p>
            {%- if block.settings.review_image_1 != blank or block.settings.review_image_2 != blank -%}
              <div class="flex gap-2 mb-2">
                {%- if block.settings.review_image_1 != blank -%}
                  <img
                    src="{{ block.settings.review_image_1 | image_url: width: 112 }}"
                    alt="Review photo"
                    class="w-14 h-14 object-cover"
                    loading="lazy"
                    width="56"
                    height="56"
                  >
                {%- endif -%}
                {%- if block.settings.review_image_2 != blank -%}
                  <img
                    src="{{ block.settings.review_image_2 | image_url: width: 112 }}"
                    alt="Review photo"
                    class="w-14 h-14 object-cover"
                    loading="lazy"
                    width="56"
                    height="56"
                  >
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if block.settings.reviewed_item != blank -%}
              <span class="font-body text-[0.7rem] font-light text-[#2d3338]/60">{{ block.settings.reviewed_item }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "class": "product-reviews",
  "settings": [
    {
      "type": "text",
      "id": "average_rating",
      "label": "Average Rating",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Total Review Count",
      "default": "220"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "Eleanor C."
        },
        {
          "type": "text",
          "id": "review_date",
          "label": "Review Date",
          "default": "2/26/2026"
        },
        {
          "type": "range",
          "id": "star_rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "The style is so versatile, it can go with any room decor and look perfectly in style. The warm glow creates such a calm atmosphere."
        },
        {
          "type": "image_picker",
          "id": "review_image_1",
          "label": "Review Photo 1"
        },
        {
          "type": "image_picker",
          "id": "review_image_2",
          "label": "Review Photo 2"
        },
        {
          "type": "text",
          "id": "reviewed_item",
          "label": "Reviewed Item (variant)",
          "default": "Aven — Large (57.1\")"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Reviews",
      "settings": {
        "average_rating": "4.9",
        "review_count": "220"
      },
      "blocks": [
        {
          "type": "review",
          "settings": {
            "reviewer_name": "Eleanor C.",
            "review_date": "2/26/2026",
            "star_rating": 5,
            "review_text": "The style is so versatile, it can go with any room decor and look perfectly in style. The warm glow creates such a calm atmosphere.",
            "reviewed_item": "Aven — Large (57.1\")"
          }
        },
        {
          "type": "review",
          "settings": {
            "reviewer_name": "Cuong N.",
            "review_date": "2/22/2026",
            "star_rating": 5,
            "review_text": "Beautiful floor lamp! Received within 4 days. Excellent service. The packaging was flawless and the lamp exceeded expectations.",
            "reviewed_item": "Aven — Large (57.1\")"
          }
        },
        {
          "type": "review",
          "settings": {
            "reviewer_name": "Marcia R.",
            "review_date": "2/19/2026",
            "star_rating": 5,
            "review_text": "I love my light in my MCM 1970 home. It's perfect. The craftsmanship is beautiful and it creates the most wonderful ambiance.",
            "reviewed_item": "Aven — Small (44.1\")"
          }
        },
        {
          "type": "review",
          "settings": {
            "reviewer_name": "Paola A.",
            "review_date": "2/18/2026",
            "star_rating": 5,
            "review_text": "Love the lamp, the service, the people. 100% and 5 stars. Flawless execution and countless compliments on our lamp.",
            "reviewed_item": "Aven — Large (57.1\")"
          }
        }
      ]
    }
  ]
}
{% endschema %}
