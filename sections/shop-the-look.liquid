{{ 'section-shop-the-look.css' | asset_url | stylesheet_tag }}

<section class="bg-[#F9F9FB] px-5 md:px-12 py-16 md:py-24" id="section-{{ section.id }}">
  <div class="max-w-[1920px] mx-auto">

    {%- assign block_count = section.blocks.size -%}

    <!-- ============================================================
         DESKTOP LAYOUT
    ============================================================ -->
    <div class="hidden md:block">

      <!-- Section header -->
      <div class="flex items-baseline justify-between mb-8">
        <div>
          <div class="flex items-center gap-4 mb-5">
            <div class="w-8 h-px bg-[#C5A059]"></div>
            <span class="font-label text-[0.7rem] uppercase tracking-[0.25em] text-[#C5A059]">Shop the Look</span>
          </div>
          <h2 class="heading-thin text-4xl text-[#131314] tracking-tight">{{ section.settings.heading | escape }}</h2>
        </div>
        {%- if section.settings.description != blank -%}
          <p class="font-body text-[0.85rem] font-light text-[#2d3338]/65 max-w-xs text-right">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>

      <!-- Grid: 8-col room scene + 4-col product stack -->
      <div class="grid grid-cols-12 gap-0">

        <!-- Room scene with pulse markers -->
        <div class="col-span-8 relative">
          {%- if section.settings.image != blank -%}
            <div class="relative w-full aspect-[4/3] overflow-hidden">
              <img
                src="{{ section.settings.image | image_url: width: 1400 }}"
                alt="{{ section.settings.heading | escape }}"
                width="{{ section.settings.image.width }}"
                height="{{ section.settings.image.height }}"
                loading="lazy"
                class="w-full h-full object-cover"
              >
              <!-- Pulse markers -->
              {%- for block in section.blocks -%}
                {%- assign px = block.settings.position_x -%}
                {%- assign py = block.settings.position_y -%}
                <div
                  class="absolute stl-marker"
                  style="top: {{ py }}%; left: {{ px }}%;"
                  data-index="{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="w-9 h-9 rounded-full border-2 border-white/50 bg-white/15 backdrop-blur-sm flex items-center justify-center cursor-pointer marker-pulse hover:bg-[#C5A059] hover:border-[#C5A059] transition-all group"
                       style="animation-delay: {{ forloop.index0 | times: 0.9 }}s;">
                    <span class="material-symbols-outlined text-white text-sm group-hover:text-[#131314]">add</span>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <!-- Fallback warm gradient when no image is set -->
            <div class="relative aspect-[4/3] w-full overflow-hidden" style="background: linear-gradient(155deg, #d4c4a8 0%, #b8a07a 40%, #a08960 100%);">
              {%- for block in section.blocks -%}
                {%- assign px = block.settings.position_x -%}
                {%- assign py = block.settings.position_y -%}
                <div
                  class="absolute stl-marker"
                  style="top: {{ py }}%; left: {{ px }}%;"
                  data-index="{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="w-9 h-9 rounded-full border-2 border-white/50 bg-white/15 backdrop-blur-sm flex items-center justify-center cursor-pointer marker-pulse hover:bg-[#C5A059] hover:border-[#C5A059] transition-all group"
                       style="animation-delay: {{ forloop.index0 | times: 0.9 }}s;">
                    <span class="material-symbols-outlined text-white text-sm group-hover:text-[#131314]">add</span>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <!-- Product card stack -->
        <div class="col-span-4 border-l border-[#131314]/6 flex flex-col">
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- assign is_last = false -%}
            {%- if forloop.last -%}{%- assign is_last = true -%}{%- endif -%}

            {%- if product != blank -%}
              <a
                href="{{ product.url }}"
                class="stl-card flex-1 p-6 group hover:bg-[#f4f0eb] transition-colors{% unless is_last %} border-b border-[#131314]/5{% endunless %}"
                data-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                <div class="flex items-center justify-between mb-4">
                  <span class="quote-thin text-lg text-[#C5A059]/40">0{{ forloop.index }}</span>
                  <span class="font-label text-[0.7rem] uppercase tracking-[0.08em] text-[#131314]/60 bg-[#f4f0eb] px-2.5 py-1">In Stock</span>
                </div>
                <div class="flex items-start gap-4">
                  {%- if product.featured_image != blank -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 200 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      width="64"
                      height="64"
                      loading="lazy"
                      class="w-16 h-16 shrink-0 object-cover"
                    >
                  {%- else -%}
                    <div class="w-16 h-16 shrink-0" style="background: linear-gradient(165deg, #e8ddd0 0%, #d4c4b0 100%);"></div>
                  {%- endif -%}
                  <div class="border-l-2 border-[#C5A059]/25 pl-4">
                    <span class="font-headline text-xl font-[300] text-[#131314] block group-hover:text-[#C5A059] transition-colors mb-0.5">{{ product.title | split: ' ' | first | escape }}</span>
                    {%- if block.settings.label != blank -%}
                      <span class="font-label text-[0.72rem] uppercase tracking-[0.08em] text-[#2d3338]/55 block mb-2">{{ block.settings.label | escape }}</span>
                    {%- else -%}
                      <span class="font-label text-[0.72rem] uppercase tracking-[0.08em] text-[#2d3338]/55 block mb-2">{{ product.type | escape }}</span>
                    {%- endif -%}
                    <span class="font-headline text-base font-[300] text-[#131314]">{{ product.price | money }}</span>
                  </div>
                </div>
              </a>
            {%- else -%}
              <!-- Placeholder when no product is set in the editor -->
              <div
                class="flex-1 p-6 border-b border-[#131314]/5 opacity-40"
                {{ block.shopify_attributes }}
              >
                <div class="flex items-center justify-between mb-4">
                  <span class="quote-thin text-lg text-[#C5A059]/40">0{{ forloop.index }}</span>
                  <span class="font-label text-[0.7rem] uppercase tracking-[0.08em] text-[#131314]/60 bg-[#f4f0eb] px-2.5 py-1">In Stock</span>
                </div>
                <div class="flex items-start gap-4">
                  <div class="w-16 h-16 shrink-0" style="background: linear-gradient(165deg, #e8ddd0 0%, #d4c4b0 100%);"></div>
                  <div class="border-l-2 border-[#C5A059]/25 pl-4">
                    <span class="font-headline text-xl font-[300] text-[#131314] block mb-0.5">Product Name</span>
                    <span class="font-label text-[0.72rem] uppercase tracking-[0.08em] text-[#2d3338]/55 block mb-2">{{ block.settings.label | default: 'Category' }}</span>
                    <span class="font-headline text-base font-[300] text-[#131314]">$000</span>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div><!-- /product stack -->

      </div><!-- /grid -->
    </div><!-- /desktop -->


    <!-- ============================================================
         MOBILE LAYOUT
    ============================================================ -->
    <div class="md:hidden">

      <!-- Header -->
      <div class="mb-4">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-5 h-px bg-[#C5A059]"></div>
          <span class="font-label text-[0.6rem] uppercase tracking-[0.25em] text-[#C5A059]">Shop the Look</span>
        </div>
        <h2 class="heading-thin text-[1.6rem] text-[#131314] tracking-tight mb-1">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="font-body text-[0.78rem] font-light text-[#2d3338]/60">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>

      <!-- Room scene, full width on mobile -->
      <div class="relative mb-4">
        {%- if section.settings.image != blank -%}
          <div class="relative aspect-[4/3] w-full overflow-hidden">
            <img
              src="{{ section.settings.image | image_url: width: 800 }}"
              alt="{{ section.settings.heading | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
              class="w-full h-full object-cover"
            >
            {%- for block in section.blocks -%}
              {%- assign px = block.settings.position_x -%}
              {%- assign py = block.settings.position_y -%}
              <div class="absolute" style="top: {{ py }}%; left: {{ px }}%;">
                <div class="w-7 h-7 rounded-full border-2 border-white/50 bg-white/15 flex items-center justify-center marker-pulse"
                     style="animation-delay: {{ forloop.index0 | times: 0.9 }}s;">
                  <span class="material-symbols-outlined text-white text-xs">add</span>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="relative aspect-[4/3] w-full" style="background: linear-gradient(155deg, #d4c4a8 0%, #b8a07a 40%, #a08960 100%);">
            {%- for block in section.blocks -%}
              {%- assign px = block.settings.position_x -%}
              {%- assign py = block.settings.position_y -%}
              <div class="absolute" style="top: {{ py }}%; left: {{ px }}%;">
                <div class="w-7 h-7 rounded-full border-2 border-white/50 bg-white/15 flex items-center justify-center marker-pulse"
                     style="animation-delay: {{ forloop.index0 | times: 0.9 }}s;">
                  <span class="material-symbols-outlined text-white text-xs">add</span>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product list -->
      <div class="border-t border-[#131314]/6">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- assign is_last = false -%}
          {%- if forloop.last -%}{%- assign is_last = true -%}{%- endif -%}

          {%- if product != blank -%}
            <a
              href="{{ product.url }}"
              class="flex items-center gap-4 py-5{% unless is_last %} border-b border-[#131314]/5{% endunless %}"
            >
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 200 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="64"
                  height="64"
                  loading="lazy"
                  class="w-16 h-16 shrink-0 object-cover"
                >
              {%- else -%}
                <div class="w-16 h-16 shrink-0" style="background: linear-gradient(165deg, #e8ddd0 0%, #d4c4b0 100%);"></div>
              {%- endif -%}
              <div class="flex-1 border-l-2 border-[#C5A059]/20 pl-4">
                <span class="font-headline text-[1.1rem] font-[300] text-[#131314] block mb-0.5">{{ product.title | split: ' ' | first | escape }}</span>
                {%- if block.settings.label != blank -%}
                  <span class="font-label text-[0.65rem] uppercase text-[#2d3338]/55 block mb-1">{{ block.settings.label | escape }}</span>
                {%- else -%}
                  <span class="font-label text-[0.65rem] uppercase text-[#2d3338]/55 block mb-1">{{ product.type | escape }}</span>
                {%- endif -%}
                <span class="font-headline text-[0.9rem] font-[300] text-[#131314]">{{ product.price | money }}</span>
              </div>
              <span class="font-label text-[0.58rem] uppercase text-[#131314]/55 bg-[#f4f0eb] px-2 py-1 self-start shrink-0">In Stock</span>
            </a>
          {%- else -%}
            <div class="flex items-center gap-4 py-5 border-b border-[#131314]/5 opacity-40" {{ block.shopify_attributes }}>
              <div class="w-16 h-16 shrink-0" style="background: linear-gradient(165deg, #e8ddd0 0%, #d4c4b0 100%);"></div>
              <div class="flex-1 border-l-2 border-[#C5A059]/20 pl-4">
                <span class="font-headline text-[1.1rem] font-[300] text-[#131314] block mb-0.5">Product Name</span>
                <span class="font-label text-[0.65rem] uppercase text-[#2d3338]/55 block mb-1">{{ block.settings.label | default: 'Category' }}</span>
                <span class="font-headline text-[0.9rem] font-[300] text-[#131314]">$000</span>
              </div>
              <span class="font-label text-[0.58rem] uppercase text-[#131314]/55 bg-[#f4f0eb] px-2 py-1 self-start shrink-0">In Stock</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div><!-- /mobile -->

  </div>
</section>

<style>
  @keyframes markerPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(197,160,89,0.35); }
    50%       { box-shadow: 0 0 0 10px rgba(197,160,89,0); }
  }
  .marker-pulse { animation: markerPulse 2.8s ease-in-out infinite; }
  .heading-thin  { font-family: 'Newsreader', serif; font-weight: 200; font-variation-settings: 'opsz' 72; }
  .quote-thin    { font-family: 'Newsreader', serif; font-weight: 200; font-style: italic; font-variation-settings: 'opsz' 72; }
  .stl-card.stl-active { background: #f4f0eb !important; }
  .stl-marker.stl-active > div { background: #C5A059 !important; border-color: #C5A059 !important; }
  .stl-marker.stl-active > div span { color: #131314 !important; }
</style>

<script>
(function(){
  var markers = document.querySelectorAll('.stl-marker');
  var cards = document.querySelectorAll('.stl-card');
  if (!markers.length || !cards.length) return;

  function highlight(idx) {
    markers.forEach(function(m) { m.classList.remove('stl-active'); });
    cards.forEach(function(c) { c.classList.remove('stl-active'); });
    if (markers[idx]) markers[idx].classList.add('stl-active');
    if (cards[idx]) {
      cards[idx].classList.add('stl-active');
      cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  markers.forEach(function(m) {
    m.addEventListener('click', function(e) {
      e.preventDefault();
      highlight(parseInt(m.dataset.index));
    });
  });

  cards.forEach(function(c) {
    c.addEventListener('mouseenter', function() {
      highlight(parseInt(c.dataset.index));
    });
  });
})();
</script>

{% schema %}
{
  "name": "Shop the Look",
  "tag": "section",
  "class": "section-shop-the-look",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Warm Sanctuary"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Build calm with warm, layered illumination."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Room scene image"
    }
  ],
  "blocks": [
    {
      "type": "product_pin",
      "name": "Product Pin",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "position_x",
          "label": "Marker X position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Marker Y position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "text",
          "id": "label",
          "label": "Category label",
          "default": "Modern Wall Light",
          "info": "Shown under the product name. Falls back to the product's type if blank."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the Look",
      "blocks": [
        {
          "type": "product_pin",
          "settings": {
            "position_x": 16,
            "position_y": 26,
            "label": "Modern Wall Light"
          }
        },
        {
          "type": "product_pin",
          "settings": {
            "position_x": 44,
            "position_y": 52,
            "label": "Arched Floor Lamp"
          }
        },
        {
          "type": "product_pin",
          "settings": {
            "position_x": 74,
            "position_y": 32,
            "label": "Ceramic Table Lamp"
          }
        }
      ]
    }
  ]
}
{% endschema %}
