<style>
  .ol-ta-product-img { transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .ol-ta-product-card:hover .ol-ta-product-img { transform: scale(1.04); }
  .ol-ta-action-card { transition: border-color 0.3s ease; }
  .ol-ta-action-card:hover { border-color: #C5A059; }
  .ol-ta-stat-box { border: 1px solid rgba(197,160,89,0.3); }
</style>

{% if request.design_mode or customer and customer.tags contains settings.trade_customer_tag %}

  <!-- ═══ HERO BANNER — DARK ═══ -->
  <section style="background-color: #131314;">
    <div class="max-w-[1440px] mx-auto px-5 md:px-12 py-14 md:py-20">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-10 md:gap-0">

        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-4">
            <div class="w-8 h-px" style="background-color:#C5A059;"></div>
            <span class="font-label text-[0.65rem] uppercase tracking-[0.2em] text-[#C5A059]">Trade Program</span>
          </div>
          <h1 class="heading-thin text-white text-[2.6rem] md:text-[3.6rem] lg:text-[4.4rem] leading-[1.05]" style="font-style: italic;">
            Welcome back,<br/>{{ customer.first_name | default: 'Designer' }}
          </h1>
          <div class="flex flex-wrap items-center gap-4 mt-1">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 border font-label text-[0.65rem] uppercase tracking-[0.15em] text-[#C5A059]" style="background: rgba(197,160,89,0.1); border-color: rgba(197,160,89,0.4);">
              <span class="material-symbols-outlined text-[14px]" style="font-variation-settings:'FILL' 1,'wght' 400,'opsz' 20;">verified</span>
              Trade Member
            </span>
            <span class="font-label text-[0.7rem] text-white/30 tracking-[0.06em]">Member since {{ customer.created_at | date: '%B %Y' }}</span>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="ol-ta-stat-box px-7 py-6 flex flex-col gap-1" style="min-width:120px;">
            <span class="heading-thin text-white text-[2.6rem] leading-none">{{ customer.orders_count }}</span>
            <span class="font-label text-[0.65rem] uppercase tracking-[0.14em] text-white/35 mt-1">Orders</span>
          </div>
          <div class="ol-ta-stat-box px-7 py-6 flex flex-col gap-1" style="min-width:120px; border-color: rgba(197,160,89,0.5); background: rgba(197,160,89,0.06);">
            <span class="heading-thin text-[#C5A059] text-[2.6rem] leading-none">30%</span>
            <span class="font-label text-[0.65rem] uppercase tracking-[0.14em] text-white/35 mt-1">Discount</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ DISCOUNT INFO BAR ═══ -->
  <section style="border-bottom: 1px solid #E8E8E8; background: #fdfcfa;">
    <div class="max-w-[1440px] mx-auto px-5 md:px-12 py-4 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-8">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px] text-[#C5A059]" style="font-variation-settings:'FILL' 1,'wght' 400,'opsz' 24;">check_circle</span>
        <span class="font-label text-[0.78rem] text-[#131314] tracking-[0.02em]">
          Your <strong class="font-medium">30% trade discount</strong> is applied automatically at checkout on all eligible products.
        </span>
      </div>
      <div class="hidden sm:block h-4 w-px bg-[#E8E8E8]"></div>
      <a href="{{ shop.url }}/policies/terms-of-service" class="font-label text-[0.72rem] uppercase tracking-[0.1em] text-[#C5A059] hover:text-[#131314] transition-colors duration-300 whitespace-nowrap">View Terms</a>
    </div>
  </section>

  <!-- ═══ QUICK ACTIONS ═══ -->
  <section style="border-bottom: 1px solid #E8E8E8;">
    <div class="max-w-[1440px] mx-auto px-5 md:px-12 py-16 md:py-20">
      <div class="flex items-center gap-4 mb-10">
        <div class="w-6 h-px" style="background-color:#C5A059;"></div>
        <span class="font-label text-[0.65rem] uppercase tracking-[0.2em] text-[#2d3338]/65">Quick Actions</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-[#E8E8E8]">
        <div class="ol-ta-action-card bg-white border border-transparent p-8 md:p-10 flex flex-col gap-6 group cursor-pointer">
          <div class="flex items-start justify-between">
            <span class="material-symbols-outlined text-[28px] text-[#2d3338]/55 group-hover:text-[#C5A059] transition-colors duration-300">grid_view</span>
            <span class="material-symbols-outlined text-[18px] text-[#2d3338]/20 group-hover:text-[#C5A059]/50 transition-colors duration-300">arrow_outward</span>
          </div>
          <div>
            <h3 class="font-label text-[0.85rem] font-medium text-[#131314] tracking-tight mb-2">Shop Collection</h3>
            <p class="font-label text-[0.75rem] text-[#2d3338]/60 leading-relaxed">Browse the full Outlight catalogue with your 30% trade pricing applied automatically.</p>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-2 font-label text-[0.7rem] uppercase tracking-[0.12em] text-[#C5A059] hover:gap-3 transition-all duration-300 mt-auto">
            Browse Now <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
          </a>
        </div>
        <div class="ol-ta-action-card bg-white border border-transparent p-8 md:p-10 flex flex-col gap-6 group cursor-pointer">
          <div class="flex items-start justify-between">
            <span class="material-symbols-outlined text-[28px] text-[#2d3338]/55 group-hover:text-[#C5A059] transition-colors duration-300">receipt_long</span>
            <span class="material-symbols-outlined text-[18px] text-[#2d3338]/20 group-hover:text-[#C5A059]/50 transition-colors duration-300">arrow_outward</span>
          </div>
          <div>
            <h3 class="font-label text-[0.85rem] font-medium text-[#131314] tracking-tight mb-2">Order History</h3>
            <p class="font-label text-[0.75rem] text-[#2d3338]/60 leading-relaxed">Track and manage your past orders, download invoices, and request returns.</p>
          </div>
          <a href="#trade-orders" class="inline-flex items-center gap-2 font-label text-[0.7rem] uppercase tracking-[0.12em] text-[#C5A059] hover:gap-3 transition-all duration-300 mt-auto">
            View Orders <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
          </a>
        </div>
        <div class="ol-ta-action-card bg-white border border-transparent p-8 md:p-10 flex flex-col gap-6 group cursor-pointer">
          <div class="flex items-start justify-between">
            <span class="material-symbols-outlined text-[28px] text-[#2d3338]/55 group-hover:text-[#C5A059] transition-colors duration-300">support_agent</span>
            <span class="material-symbols-outlined text-[18px] text-[#2d3338]/20 group-hover:text-[#C5A059]/50 transition-colors duration-300">arrow_outward</span>
          </div>
          <div>
            <h3 class="font-label text-[0.85rem] font-medium text-[#131314] tracking-tight mb-2">Contact Concierge</h3>
            <p class="font-label text-[0.75rem] text-[#2d3338]/60 leading-relaxed">Reach your dedicated trade concierge for specifications, custom orders, or project support.</p>
          </div>
          <a href="mailto:{{ section.settings.concierge_email }}" class="inline-flex items-center gap-2 font-label text-[0.7rem] uppercase tracking-[0.12em] text-[#C5A059] hover:gap-3 transition-all duration-300 mt-auto">
            Get In Touch <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ DEDICATED CONCIERGE ═══ -->
  <section style="border-bottom: 1px solid #E8E8E8;">
    <div class="max-w-[1440px] mx-auto px-5 md:px-12 py-16 md:py-20">
      <div class="flex items-center gap-4 mb-8">
        <div class="font-label text-[0.62rem] uppercase tracking-[0.14em] text-[#2d3338]/60">Your Dedicated Contact</div>
        <div class="flex-1 h-px bg-[#131314]/8"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-5 border border-[#131314]/10" style="border-left: 4px solid #C5A059;">
          <div class="p-7 flex flex-col gap-6">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-full shrink-0 flex items-center justify-center" style="background: linear-gradient(135deg, #c9a96e 0%, #8a6d3b 100%);">
                <span class="font-label text-[0.75rem] text-white uppercase tracking-wider font-medium">{{ section.settings.concierge_name | slice: 0 }}</span>
              </div>
              <div>
                <div class="font-label text-[0.62rem] uppercase tracking-[0.12em] text-[#C5A059] mb-1">Trade Concierge Specialist</div>
                <div class="font-label text-[0.9rem] text-[#131314] font-medium">{{ section.settings.concierge_name }}</div>
                <div class="font-label text-[0.68rem] text-[#2d3338]/55 mt-0.5">{{ section.settings.concierge_location }}</div>
              </div>
              <div class="ml-auto flex items-center gap-1.5 mt-1 shrink-0">
                <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
                <span class="font-label text-[0.6rem] text-[#2d3338]/65">Available</span>
              </div>
            </div>
            <div class="h-px bg-[#131314]/8"></div>
            <a href="mailto:{{ section.settings.concierge_email }}" class="flex items-center gap-3 group">
              <span class="material-symbols-outlined text-[1rem] text-[#C5A059]/70 group-hover:text-[#C5A059] transition-colors">mail</span>
              <span class="font-label text-[0.72rem] text-[#2d3338] group-hover:text-[#131314] transition-colors">{{ section.settings.concierge_email }}</span>
            </a>
            <a href="mailto:{{ section.settings.concierge_email }}" class="w-full border border-[#131314]/12 py-3 font-label text-[0.68rem] uppercase tracking-[0.12em] text-[#131314] hover:bg-[#131314] hover:text-white transition-all duration-300 flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-[0.95rem]">chat_bubble_outline</span>
              Send a Message
            </a>
          </div>
        </div>
        <div class="md:col-span-7 flex flex-col justify-center md:pl-4">
          <p class="heading-thin text-[1.5rem] md:text-[1.8rem] text-[#131314] leading-[1.3] mb-5">
            "Your studio deserves lighting that <span style="font-style:italic;">thinks</span> at the same level."
          </p>
          <p class="font-body text-[0.8rem] leading-[1.8] text-[#2d3338]/70 max-w-[440px] mb-6">{{ section.settings.concierge_name }} is available {{ section.settings.concierge_hours }}. For project consultations, specification sheets, or bespoke orders, reach out directly.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-[0.95rem] text-[#C5A059]">schedule</span>
              <span class="font-label text-[0.68rem] text-[#2d3338]/60">Response &lt; 2 hrs on weekdays</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TRADE BENEFITS ═══ -->
  <section style="border-bottom: 1px solid #E8E8E8;">
    <div class="max-w-[1440px] mx-auto px-5 md:px-12 py-16 md:py-20">
      <div class="flex items-center gap-4 mb-12">
        <div class="w-6 h-px" style="background-color:#C5A059;"></div>
        <span class="font-label text-[0.65rem] uppercase tracking-[0.2em] text-[#2d3338]/65">Trade Benefits</span>
      </div>
      <div class="flex flex-col md:flex-row md:items-start gap-10 md:gap-20 mb-14">
        <h2 class="heading-thin text-[#131314] text-[2rem] md:text-[2.6rem] leading-[1.1] flex-shrink-0">Your membership,<br/>your advantage.</h2>
        <p class="font-label text-[0.8rem] text-[#2d3338]/60 leading-relaxed md:pt-2 max-w-[440px]">The Outlight Trade Program is designed for architects, interior designers, and hospitality professionals who specify lighting at scale.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[#E8E8E8]">
        <div class="bg-white p-8 flex flex-col gap-4">
          <div class="flex items-center gap-3"><span class="material-symbols-outlined text-[22px] text-[#C5A059]" style="font-variation-settings:'FILL' 1,'wght' 400,'opsz' 24;">check_circle</span><h3 class="font-label text-[0.82rem] font-medium text-[#131314] tracking-tight">30% Off All Products</h3></div>
          <p class="font-label text-[0.75rem] text-[#2d3338]/60 leading-relaxed pl-[34px]">A flat 30% discount across the entire collection, applied automatically at checkout on every order.</p>
        </div>
        <div class="bg-white p-8 flex flex-col gap-4">
          <div class="flex items-center gap-3"><span class="material-symbols-outlined text-[22px] text-[#C5A059]" style="font-variation-settings:'FILL' 1,'wght' 400,'opsz' 24;">check_circle</span><h3 class="font-label text-[0.82rem] font-medium text-[#131314] tracking-tight">Dedicated Concierge</h3></div>
          <p class="font-label text-[0.75rem] text-[#2d3338]/60 leading-relaxed pl-[34px]">Your personal Outlight contact for specifications, samples, project timelines, and post-purchase support.</p>
        </div>
        <div class="bg-white p-8 flex flex-col gap-4">
          <div class="flex items-center gap-3"><span class="material-symbols-outlined text-[22px] text-[#C5A059]" style="font-variation-settings:'FILL' 1,'wght' 400,'opsz' 24;">check_circle</span><h3 class="font-label text-[0.82rem] font-medium text-[#131314] tracking-tight">Final Sizes and Finishes</h3></div>
          <p class="font-label text-[0.75rem] text-[#2d3338]/60 leading-relaxed pl-[34px]">Choose from the remaining sizes and finishes in stock. Custom orders are no longer available.</p>
        </div>
        <div class="bg-white p-8 flex flex-col gap-4">
          <div class="flex items-center gap-3"><span class="material-symbols-outlined text-[22px] text-[#C5A059]" style="font-variation-settings:'FILL' 1,'wght' 400,'opsz' 24;">check_circle</span><h3 class="font-label text-[0.82rem] font-medium text-[#131314] tracking-tight">Lighting for Your Projects</h3></div>
          <p class="font-label text-[0.75rem] text-[#2d3338]/60 leading-relaxed pl-[34px]">Explore sculptural lighting for your next project during our Clearance Sale.</p>
        </div>
        <div class="bg-white p-8 flex flex-col gap-4">
          <div class="flex items-center gap-3"><span class="material-symbols-outlined text-[22px] text-[#C5A059]" style="font-variation-settings:'FILL' 1,'wght' 400,'opsz' 24;">check_circle</span><h3 class="font-label text-[0.82rem] font-medium text-[#131314] tracking-tight">Priority Shipping</h3></div>
          <p class="font-label text-[0.75rem] text-[#2d3338]/60 leading-relaxed pl-[34px]">Trade orders are prioritised in our fulfilment queue. Expedited and white-glove delivery available on request.</p>
        </div>
        <div class="bg-white p-8 flex flex-col gap-4">
          <div class="flex items-center gap-3"><span class="material-symbols-outlined text-[22px] text-[#C5A059]" style="font-variation-settings:'FILL' 1,'wght' 400,'opsz' 24;">check_circle</span><h3 class="font-label text-[0.82rem] font-medium text-[#131314] tracking-tight">Ongoing Account Support</h3></div>
          <p class="font-label text-[0.75rem] text-[#2d3338]/60 leading-relaxed pl-[34px]">Net-30 payment terms, consolidated invoicing, and a dedicated account portal for all project documentation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ RECENT ORDERS ═══ -->
  <section id="trade-orders" style="border-bottom: 1px solid #E8E8E8; background: #fdfcfa;">
    <div class="max-w-[1440px] mx-auto px-5 md:px-12 py-16 md:py-20">
      <div class="flex items-center justify-between mb-10">
        <div class="flex items-center gap-4">
          <div class="w-6 h-px" style="background-color:#C5A059;"></div>
          <span class="font-label text-[0.65rem] uppercase tracking-[0.2em] text-[#2d3338]/65">Recent Orders</span>
        </div>
        <a href="{{ routes.account_url }}" class="font-label text-[0.7rem] uppercase tracking-[0.1em] text-[#2d3338]/55 hover:text-[#131314] transition-colors duration-300">View All</a>
      </div>

      <!-- Table header -->
      <div class="hidden md:grid pb-4 mb-2" style="grid-template-columns: 2fr 1fr 1fr 1fr 1fr; gap: 1.5rem; border-bottom: 1px solid #E8E8E8;">
        <span class="font-label text-[0.65rem] uppercase tracking-[0.14em] text-[#2d3338]/65">Order</span>
        <span class="font-label text-[0.65rem] uppercase tracking-[0.14em] text-[#2d3338]/65">Date</span>
        <span class="font-label text-[0.65rem] uppercase tracking-[0.14em] text-[#2d3338]/65">Items</span>
        <span class="font-label text-[0.65rem] uppercase tracking-[0.14em] text-[#2d3338]/65">Total</span>
        <span class="font-label text-[0.65rem] uppercase tracking-[0.14em] text-[#2d3338]/65">Status</span>
      </div>

      {% if customer.orders.size > 0 %}
        {% for order in customer.orders limit: 5 %}
          <div class="hidden md:grid py-5 border-b border-[#E8E8E8]" style="grid-template-columns: 2fr 1fr 1fr 1fr 1fr; gap: 1.5rem; align-items: center;">
            <a href="{{ order.customer_url }}" class="font-label text-[0.8rem] text-[#C5A059] hover:text-[#131314] transition-colors">#{{ order.name }}</a>
            <span class="font-label text-[0.78rem] text-[#2d3338]/70">{{ order.created_at | date: '%b %d, %Y' }}</span>
            <span class="font-label text-[0.78rem] text-[#2d3338]/70">{{ order.line_items.size }}</span>
            <span class="font-label text-[0.78rem] text-[#131314] font-medium">{{ order.total_price | money }}</span>
            <span class="font-label text-[0.68rem] uppercase tracking-[0.1em] px-2.5 py-1 inline-block" style="background: rgba(197,160,89,0.1); color: #C5A059;">{{ order.financial_status | replace: '_', ' ' | capitalize }}</span>
          </div>
          <div class="md:hidden flex flex-col gap-1 py-4 border-b border-[#E8E8E8]">
            <div class="flex justify-between"><a href="{{ order.customer_url }}" class="font-label text-[0.8rem] text-[#C5A059]">#{{ order.name }}</a><span class="font-label text-[0.78rem] text-[#131314] font-medium">{{ order.total_price | money }}</span></div>
            <div class="flex justify-between"><span class="font-label text-[0.72rem] text-[#2d3338]/60">{{ order.created_at | date: '%b %d, %Y' }}</span><span class="font-label text-[0.65rem] uppercase text-[#C5A059]">{{ order.financial_status | replace: '_', ' ' | capitalize }}</span></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="flex flex-col items-center justify-center py-20 gap-6" style="border-bottom: 1px solid #E8E8E8;">
          <span class="material-symbols-outlined text-[48px] text-[#2d3338]/15" style="font-variation-settings:'FILL' 0,'wght' 200,'opsz' 48;">receipt_long</span>
          <div class="text-center">
            <p class="font-label text-[0.82rem] text-[#131314] mb-1">No orders yet</p>
            <p class="font-label text-[0.75rem] text-[#2d3338]/65">Your confirmed trade orders will appear here.</p>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-2 px-6 py-3 bg-[#131314] font-label text-[0.7rem] uppercase tracking-[0.12em] text-white hover:bg-[#C5A059] hover:text-[#131314] transition-colors duration-300">
            Browse Now <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
          </a>
        </div>
      {% endif %}
    </div>
  </section>

{% else %}
  <!-- NOT LOGGED IN / NOT A TRADE MEMBER -->
  <section class="min-h-screen flex flex-col items-center justify-center px-5 text-center py-32">
    <span class="font-label text-[0.6rem] uppercase tracking-[0.25em] text-[#C5A059] block mb-6">Trade Program</span>
    <h1 class="heading-thin text-4xl md:text-6xl text-[#131314] tracking-tight mb-6">Access Restricted</h1>
    {% if customer %}
      <p class="font-body text-[0.95rem] font-light text-[#2d3338]/65 leading-relaxed max-w-md mb-8">Your account does not currently have trade member access. Apply to the trade program to unlock 30% off every order.</p>
      <a href="{{ section.settings.apply_url }}" class="inline-flex items-center gap-2 px-10 py-4 font-label text-[0.75rem] uppercase tracking-[0.15em] text-[#131314] hover:opacity-90 transition-opacity" style="background:#C5A059;">Apply for Trade Access</a>
    {% else %}
      <p class="font-body text-[0.95rem] font-light text-[#2d3338]/65 leading-relaxed max-w-md mb-8">Please log in to your trade account to access this page.</p>
      <a href="{{ routes.account_login_url }}" class="inline-flex items-center gap-2 px-10 py-4 font-label text-[0.75rem] uppercase tracking-[0.15em] text-[#131314] hover:opacity-90 transition-opacity" style="background:#C5A059;">Log In</a>
      <a href="{{ section.settings.apply_url }}" class="block mt-4 font-label text-[0.7rem] uppercase tracking-[0.15em] text-[#2d3338]/55 hover:text-[#131314] transition-colors border-b border-[#131314]/20 pb-0.5 mx-auto">Apply for Trade Access</a>
    {% endif %}
  </section>
{% endif %}

{% schema %}
{
  "name": "Trade Account",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "concierge_name",
      "label": "Concierge name",
      "default": "Sebastien"
    },
    {
      "type": "text",
      "id": "concierge_email",
      "label": "Concierge email",
      "default": "sebastien@outlight.dk"
    },
    {
      "type": "text",
      "id": "concierge_location",
      "label": "Concierge location/timezone",
      "default": "Copenhagen Studio · GMT+1"
    },
    {
      "type": "text",
      "id": "concierge_hours",
      "label": "Concierge availability hours",
      "default": "Monday through Friday, 9–18 CET"
    },
    {
      "type": "url",
      "id": "apply_url",
      "label": "Trade application page URL"
    }
  ],
  "presets": [
    {
      "name": "Trade Account"
    }
  ]
}
{% endschema %}
