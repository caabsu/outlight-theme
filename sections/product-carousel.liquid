{% assign clearance_percent = settings.clearance_discount_percent | default: 60 %}
{% assign clearance_remaining = 100 | minus: clearance_percent %}
{%- comment -%}
  product-carousel.liquid — Editorial "Best Sellers" image-led grid
  (variation-1-editorial-r3). Loops a collection's products as image-first cards.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign grid_collection = collections[s.collection] -%}
{%- assign limit = s.products_to_show | default: 8 -%}

<style>
  #ed-grid-{{ section.id }}{
    --ink:#131314;--paper:#F9F9FB;--gold:#C5A059;--warm:#f4f0eb;
    --body:#2d3338;--hairline:rgba(19,19,20,.14);--measure:1320px;
    background:var(--paper);font-family:'Manrope',sans-serif;
    display:block;padding:96px 0;
  }
  #ed-grid-{{ section.id }} *{box-sizing:border-box;}
  #ed-grid-{{ section.id }} .ed-wrap{max-width:var(--measure);margin:0 auto;padding:0 40px;}
  #ed-grid-{{ section.id }} .ed-label{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:11px;
    letter-spacing:.26em;text-transform:uppercase;color:var(--body);
  }
  /* section head */
  #ed-grid-{{ section.id }} .sec-head{
    display:flex;align-items:flex-start;gap:30px;margin-bottom:54px;
  }
  #ed-grid-{{ section.id }} .sec-head__marker{flex:none;}
  #ed-grid-{{ section.id }} .marker{
    font-family:'Newsreader',serif;font-weight:200;font-style:italic;
    font-size:clamp(2rem,4vw,3.1rem);color:var(--gold);line-height:1;display:inline-block;
  }
  #ed-grid-{{ section.id }} .sec-head__text{flex:1;}
  #ed-grid-{{ section.id }} .sec-head__label{margin-bottom:18px;display:block;}
  #ed-grid-{{ section.id }} .sec-head h2{
    font-family:'Newsreader',serif;font-weight:200;
    font-size:clamp(2.3rem,4.6vw,3.6rem);line-height:1.04;letter-spacing:-.012em;
    max-width:14ch;color:var(--ink);margin:0;
  }
  #ed-grid-{{ section.id }} .sec-head h2 em{font-style:italic;font-weight:300;color:var(--gold);}
  #ed-grid-{{ section.id }} .sec-head__aside{
    flex:none;width:280px;padding-top:8px;border-top:1px solid var(--hairline);
  }
  #ed-grid-{{ section.id }} .sec-head__aside p{
    font-size:14px;color:var(--body);line-height:1.7;padding-top:14px;
    font-weight:300;margin:0;
  }
  /* grid */
  #ed-grid-{{ section.id }} .grid{
    display:grid;grid-template-columns:repeat(4,1fr);gap:28px;
  }
  #ed-grid-{{ section.id }} .card{
    background:var(--paper);display:flex;flex-direction:column;position:relative;
  }
  #ed-grid-{{ section.id }} .card__media{
    position:relative;aspect-ratio:4/5;overflow:hidden;background:var(--warm);
  }
  #ed-grid-{{ section.id }} .card__media img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
    transition:transform .9s cubic-bezier(.16,.84,.44,1);
  }
  #ed-grid-{{ section.id }} .card:hover .card__media img{transform:scale(1.045);}
  #ed-grid-{{ section.id }} .card__cat{
    position:absolute;left:14px;top:14px;background:rgba(249,249,251,.92);
    -webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);
    font-family:'Manrope',sans-serif;font-weight:500;font-size:9.5px;
    letter-spacing:.15em;text-transform:uppercase;color:var(--ink);padding:6px 10px;
  }
  #ed-grid-{{ section.id }} .card__arrow{
    position:absolute;right:14px;bottom:14px;width:38px;height:38px;
    display:flex;align-items:center;justify-content:center;
    background:var(--ink);color:var(--paper);border-radius:50%;
    font-size:14px;line-height:1;opacity:0;transform:translateY(8px);
    transition:opacity .4s ease,transform .4s cubic-bezier(.16,.84,.44,1);
  }
  #ed-grid-{{ section.id }} .card:hover .card__arrow{opacity:1;transform:none;}
  #ed-grid-{{ section.id }} .card__body{
    padding:16px 2px 0;display:flex;flex-direction:column;gap:8px;
  }
  #ed-grid-{{ section.id }} .card h3{
    font-family:'Newsreader',serif;font-weight:300;font-size:25px;
    line-height:1.1;letter-spacing:.005em;color:var(--ink);margin:0;
  }
  #ed-grid-{{ section.id }} .card__price{
    font-family:'Newsreader',serif;font-weight:300;font-size:20px;color:var(--ink);
  }
  /* review badge widget styling — keep it compact inside the card */
  #ed-grid-{{ section.id }} .outlight-review-badge:empty{display:none;}
  #ed-grid-{{ section.id }} .outlight-review-badge{font-family:'Manrope',sans-serif;}
  /* footer */
  #ed-grid-{{ section.id }} .grid-foot{
    margin-top:48px;display:flex;justify-content:space-between;
    align-items:center;flex-wrap:wrap;gap:18px;
  }
  #ed-grid-{{ section.id }} .grid-foot p{
    font-size:13px;color:var(--body);max-width:42ch;font-weight:300;margin:0;
  }
  #ed-grid-{{ section.id }} .ed-btn{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:12px;
    letter-spacing:.18em;text-transform:uppercase;padding:18px 38px;
    background:var(--ink);color:var(--paper);border:1px solid var(--ink);
    transition:background .4s ease,color .4s ease;display:inline-block;text-align:center;
  }
  #ed-grid-{{ section.id }} .ed-btn:hover{background:transparent;color:var(--ink);}
  #ed-grid-{{ section.id }} .ed-empty{
    grid-column:1 / -1;padding:48px 0;text-align:center;
    font-size:14px;color:var(--body);font-weight:300;
  }
  @media (max-width:1100px){
    #ed-grid-{{ section.id }} .grid{grid-template-columns:repeat(2,1fr);gap:24px;}
  }
  @media (max-width:880px){
    #ed-grid-{{ section.id }} .ed-wrap{padding:0 22px;}
    #ed-grid-{{ section.id }}{padding:64px 0;}
    #ed-grid-{{ section.id }} .sec-head{flex-direction:column;gap:20px;margin-bottom:40px;}
    #ed-grid-{{ section.id }} .sec-head__aside{width:100%;}
  }
  @media (max-width:680px){
    #ed-grid-{{ section.id }} .ed-wrap{padding:0 20px;}
    #ed-grid-{{ section.id }} .grid{grid-template-columns:repeat(2,1fr);gap:16px 14px;}
    #ed-grid-{{ section.id }} .marker{font-size:1.9rem;}
    #ed-grid-{{ section.id }} .sec-head h2{max-width:none;}
    #ed-grid-{{ section.id }} .card__cat{left:9px;top:9px;font-size:8.5px;padding:5px 8px;}
    #ed-grid-{{ section.id }} .card__arrow{width:32px;height:32px;right:9px;bottom:9px;font-size:12px;}
    #ed-grid-{{ section.id }} .card__body{padding:12px 0 0;gap:6px;}
    #ed-grid-{{ section.id }} .card h3{font-size:19px;}
    #ed-grid-{{ section.id }} .card__price{font-size:17px;}
    #ed-grid-{{ section.id }} .grid-foot{margin-top:32px;flex-direction:column;align-items:flex-start;gap:16px;}
    #ed-grid-{{ section.id }} .grid-foot .ed-btn{width:100%;}
    #ed-grid-{{ section.id }} .grid-foot p{max-width:none;}
  }
  @media (max-width:380px){
    #ed-grid-{{ section.id }} .card h3{font-size:17px;}
  }
</style>
{% assign card_scope_id = 'ed-grid-' | append: section.id %}
{% render 'integrated-card-styles', scope_id: card_scope_id %}

<section id="ed-grid-{{ section.id }}">
  <div class="ed-wrap">

    <div class="sec-head">
      {%- if s.marker != blank -%}
        <div class="sec-head__marker"><span class="marker">{{ s.marker | escape }}</span></div>
      {%- endif -%}
      <div class="sec-head__text">
        {%- if s.label != blank -%}
          <span class="sec-head__label ed-label">{{ s.label | escape }}</span>
        {%- endif -%}
        <h2>{{ s.heading }}</h2>
      </div>
      {%- if s.aside_text != blank -%}
        <div class="sec-head__aside">
          <p>{{ s.aside_text | escape }}</p>
        </div>
      {%- endif -%}
    </div>

    <div class="grid ol-card-grid">
      {%- if grid_collection != blank and grid_collection.products.size > 0 -%}
        {%- for product in grid_collection.products limit: limit -%}
          <div class="card ol-integrated-card{% unless product.available %} ol-card-sold{% endunless %}" role="group"{% unless product.available %} aria-disabled="true"{% endunless %} aria-label="{{ product.title | escape }}">
            {% if product.available %}<a class="ol-card-media-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% endif %}
            <div class="card__media ol-card-media">
              {% if product.available %}<span class="ol-sale-badge">{{ 'clearance.discount_badge' | t: percent: clearance_percent }}</span>{% endif %}
              {% unless product.available %}{% render 'clearance-stock', product: product, placement: 'image' %}{% endunless %}
              {%- if product.featured_image -%}
                <img class="ol-product-image"
                  src="{{ product.featured_image | image_url: width: 700 }}"
                  srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 700 }} 700w"
                  sizes="(max-width:680px) 50vw, 320px"
                  alt="{{ product.featured_image.alt | escape | default: product.title }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              {%- endif -%}
              <span class="card__cat ol-card-category">{{ product.type | default: 'Lighting' | escape }}</span>
              <span class="card__arrow" aria-hidden="true">&rarr;</span>
            </div>
            {% if product.available %}</a>{% endif %}
            <div class="card__body ol-card-info">
              <h3 class="ol-card-name">{% if product.available %}<a href="{{ product.url }}">{% endif %}{{ product.title | split: ' ' | first }}{% if product.available %}</a>{% endif %}</h3>
              {% if product.available %}<div class="outlight-review-badge" data-product-handle="{{ product.handle }}"></div>{% endif %}
              {%- assign tile_variant = product.selected_or_first_available_variant -%}<span class="card__price ol-card-price"><span>{{ tile_variant.price | times: clearance_remaining | divided_by: 100.0 | round | money }}</span> <s style="font-size:.7em;opacity:.55;margin-left:6px">{{ tile_variant.price | money }}</s></span>{% render 'clearance-stock', product: product %}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <p class="ed-empty">No products to display. Choose a collection in the theme editor.</p>
      {%- endif -%}
    </div>

    {%- if s.foot_text != blank or s.foot_cta_text != blank -%}
      <div class="grid-foot">
        {%- if s.foot_text != blank -%}
          <p>{{ s.foot_text | escape }}</p>
        {%- endif -%}
        {%- if s.foot_cta_text != blank -%}
          <a href="{{ s.foot_cta_url | default: '/collections/best-sellers' }}" class="ed-btn">{{ s.foot_cta_text | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script src="{{ 'outlight-review-badge.js' | asset_url }}" data-backend-url="https://shopify-ai-chatbot-production-9ab4.up.railway.app" defer></script>

{% schema %}
{
  "name": "Best Sellers Grid",
  "tag": "section",
  "class": "ed-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "marker",
      "label": "Section number marker",
      "default": "01"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Best Sellers"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap a phrase in italics for the gold accent.",
      "default": "<p>The pieces rooms keep <em>asking for.</em></p>"
    },
    {
      "type": "textarea",
      "id": "aside_text",
      "label": "Aside text",
      "default": "The lamps our customers return to most. Every price as shown, every piece in stock."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "text",
      "id": "foot_text",
      "label": "Footer note",
      "default": "Prices shown include 60% off. Your Clearance Sale discount applies automatically at checkout."
    },
    {
      "type": "text",
      "id": "foot_cta_text",
      "label": "Footer CTA text",
      "default": "View all best sellers"
    },
    {
      "type": "url",
      "id": "foot_cta_url",
      "label": "Footer CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Grid",
      "settings": {
        "collection": "best-sellers"
      }
    }
  ]
}
{% endschema %}
