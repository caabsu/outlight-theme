<section class="pt-[72px] md:pt-[88px]">
  <div class="text-center pt-14 md:pt-20 pb-10 md:pb-14 px-5 md:px-12">
    <span class="font-label text-[0.55rem] md:text-[0.65rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-4 md:mb-5">{{ section.settings.label }}</span>
    <h1 class="heading-thin text-4xl md:text-6xl text-[#131314] tracking-tight leading-tight mb-3 md:mb-4">{{ section.settings.heading }}</h1>
    <p class="font-body text-[0.85rem] md:text-[1rem] font-light text-[#2d3338]/60 mb-6 md:mb-10">{{ section.settings.subheading }}</p>
  </div>

  <!-- Action cards -->
  <div class="grid grid-cols-2 gap-2 md:gap-4 px-5 md:px-12 pb-8 md:pb-14 max-w-xl mx-auto">
    <a href="{{ section.settings.return_url }}" class="border border-[#131314]/8 hover:border-[#C5A059]/40 transition-colors py-5 md:py-8 flex flex-col items-center gap-2 md:gap-3">
      <span class="material-symbols-outlined text-[#C5A059] text-xl md:text-3xl">undo</span>
      <span class="font-label text-[0.5rem] md:text-[0.65rem] uppercase tracking-[0.08em] text-[#131314]">Return</span>
    </a>
    <a href="{{ section.settings.contact_url }}" class="border border-[#131314]/8 hover:border-[#C5A059]/40 transition-colors py-5 md:py-8 flex flex-col items-center gap-2 md:gap-3">
      <span class="material-symbols-outlined text-[#C5A059] text-xl md:text-3xl">mail</span>
      <span class="font-label text-[0.5rem] md:text-[0.65rem] uppercase tracking-[0.08em] text-[#131314]">Contact</span>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Support Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Help Center"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find answers or reach our team."
    },
    {
      "type": "url",
      "id": "return_url",
      "label": "Returns URL"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact URL"
    }
  ],
  "presets": [
    {
      "name": "Support Hero"
    }
  ]
}
{% endschema %}
