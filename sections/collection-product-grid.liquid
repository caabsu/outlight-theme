{%- comment -%} Client-side filter JS — multi-select; filter state persists across sort reloads {%- endcomment -%}
<script>
(function(){
  var STORE_KEY = 'olFilters_' + {{ collection.handle | json }};
  var activeCols = [];
  var priceMin = 0, priceMax = Infinity;

  function applyFilters(){
    var cards = document.querySelectorAll('.product-card[data-collections]');
    var shown = 0;
    cards.forEach(function(card){
      var cols = (card.getAttribute('data-collections') || '').split(',');
      var price = parseFloat(card.getAttribute('data-price') || '0') * 100;
      var colMatch = activeCols.length === 0 || activeCols.some(function(h){ return cols.indexOf(h) !== -1; });
      var priceMatch = price >= priceMin && price <= priceMax;
      if(colMatch && priceMatch){ card.style.display = ''; shown++; }
      else { card.style.display = 'none'; }
    });
    document.querySelectorAll('[data-result-count]').forEach(function(el){ el.textContent = shown + ' Results'; });
  }

  function saveState(){
    try {
      sessionStorage.setItem(STORE_KEY, JSON.stringify({
        cols: activeCols,
        pMin: priceMin,
        pMax: priceMax === Infinity ? 'Inf' : priceMax
      }));
    } catch(e){}
  }

  function syncColButtons(){
    document.querySelectorAll('.ol-col-filter').forEach(function(b){
      var h = b.getAttribute('onclick').match(/'([^']+)'/);
      if(h && h[1] && activeCols.indexOf(h[1]) !== -1){ b.classList.add('active'); }
      else { b.classList.remove('active'); }
    });
  }

  function syncPriceButtons(){
    document.querySelectorAll('.ol-price-filter').forEach(function(b){
      b.classList.remove('active');
      var m = b.getAttribute('onclick').match(/olSetPrice\(this,\s*([^,]+),\s*([^\)]+)\)/);
      if(m){
        var bMin = m[1].trim() === 'Infinity' ? Infinity : parseFloat(m[1]);
        var bMax = m[2].trim() === 'Infinity' ? Infinity : parseFloat(m[2]);
        if(bMin === priceMin && bMax === priceMax){ b.classList.add('active'); }
      }
    });
  }

  window.olToggleCol = function(btn, handle){
    var idx = activeCols.indexOf(handle);
    if(idx === -1){ activeCols.push(handle); }
    else { activeCols.splice(idx, 1); }
    syncColButtons();
    applyFilters();
    saveState();
  };

  window.olClearCols = function(){
    activeCols = [];
    syncColButtons();
    applyFilters();
    saveState();
  };

  window.olSetPrice = function(btn, min, max){
    priceMin = min; priceMax = max;
    syncPriceButtons();
    applyFilters();
    saveState();
  };

  function restoreState(){
    var raw;
    try { raw = sessionStorage.getItem(STORE_KEY); } catch(e){ return; }
    if(!raw) return;
    var st;
    try { st = JSON.parse(raw); } catch(e){ return; }
    if(!st) return;
    activeCols = st.cols || [];
    priceMin = typeof st.pMin === 'number' ? st.pMin : 0;
    priceMax = st.pMax === 'Inf' ? Infinity : (typeof st.pMax === 'number' ? st.pMax : Infinity);
    syncColButtons();
    syncPriceButtons();
    applyFilters();
  }

  restoreState();
})();
</script>

