{%- if product.metafields.custom.intro_title.value != blank -%}
<!-- Product Intro Section — Variation A: Padded Gallery -->
<!-- Desktop -->
<div class="hidden md:block" style="background-color:#F9F9FB;">
    <div class="max-w-[1920px] mx-auto px-12 pt-24 pb-0">
        <div class="grid grid-cols-2" style="gap:4rem;">
            <div class="flex flex-col justify-center py-10">
                <span class="font-label text-[0.65rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-6">{{ product.metafields.custom.intro_title.value }}</span>
                <h2 class="heading-thin text-5xl text-[#131314] tracking-tight leading-[1.1] mb-6">{{ product.metafields.custom.intro_strap_text.value }}</h2>
                <p class="heading-thin text-lg text-[#2d3338]/65 leading-relaxed mb-8">"{{ product.metafields.custom.intro_subheading.value }}"</p>
                <div class="h-px bg-[#131314]/6 mb-8"></div>
                <p class="font-body text-[0.95rem] font-light text-[#2d3338]/65 leading-[1.9]">{{ product.metafields.custom.intro_image_text.value }}</p>
            </div>
            <div class="py-6">
                {%- if product.metafields.custom.intro_main_image.value -%}
                    <img
                        src="{{ product.metafields.custom.intro_main_image.value | image_url: width: 1400 }}"
                        alt="{{ product.metafields.custom.intro_title.value }}"
                        class="w-full object-cover"
                        style="aspect-ratio:4/5;"
                        loading="lazy"
                        width="1400"
                        height="1750"
                    >
                {%- endif -%}
            </div>
        </div>
    </div>
    <div class="max-w-[1920px] mx-auto px-12 pt-10 pb-24">
        <div class="h-px bg-[#131314]/6 mb-10"></div>
        <div class="grid grid-cols-2" style="gap:2rem;">
            <div>
                {%- if product.metafields.custom.intro_image1.value -%}
                    <img
                        src="{{ product.metafields.custom.intro_image1.value | image_url: width: 1400 }}"
                        alt="{{ product.title }} — detail 1"
                        class="w-full object-cover"
                        style="aspect-ratio:1/1;"
                        loading="lazy"
                        width="1400"
                        height="1400"
                    >
                {%- endif -%}
            </div>
            <div>
                {%- if product.metafields.custom.intro_image2.value -%}
                    <img
                        src="{{ product.metafields.custom.intro_image2.value | image_url: width: 1400 }}"
                        alt="{{ product.title }} — detail 2"
                        class="w-full object-cover"
                        style="aspect-ratio:1/1;"
                        loading="lazy"
                        width="1400"
                        height="1400"
                    >
                {%- endif -%}
            </div>
        </div>
    </div>
</div>

<!-- Mobile -->
<div class="md:hidden" style="background-color:#F9F9FB;">
    <div class="px-5 pt-14 pb-8">
        <span class="font-label text-[0.55rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-5">{{ product.metafields.custom.intro_title.value }}</span>
        <h2 class="heading-thin text-3xl text-[#131314] tracking-tight leading-[1.15] mb-5">{{ product.metafields.custom.intro_strap_text.value }}</h2>
        <p class="heading-thin text-base text-[#2d3338]/65 leading-relaxed">"{{ product.metafields.custom.intro_subheading.value }}"</p>
    </div>
    {%- if product.metafields.custom.intro_main_image.value -%}
        <img
            src="{{ product.metafields.custom.intro_main_image.value | image_url: width: 1200 }}"
            alt="{{ product.metafields.custom.intro_title.value }}"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
            width="1200"
            height="900"
        >
    {%- endif -%}
    <div class="px-5 py-10">
        <p class="font-body text-[0.9rem] font-light text-[#2d3338]/60 leading-[1.8]">{{ product.metafields.custom.intro_image_text.value }}</p>
    </div>
    <div class="grid grid-cols-2" style="gap:1px;">
        <div>
            {%- if product.metafields.custom.intro_image1.value -%}
                <img
                    src="{{ product.metafields.custom.intro_image1.value | image_url: width: 800 }}"
                    alt="{{ product.title }} — detail 1"
                    class="w-full aspect-square object-cover"
                    loading="lazy"
                    width="800"
                    height="800"
                >
            {%- endif -%}
        </div>
        <div>
            {%- if product.metafields.custom.intro_image2.value -%}
                <img
                    src="{{ product.metafields.custom.intro_image2.value | image_url: width: 800 }}"
                    alt="{{ product.title }} — detail 2"
                    class="w-full aspect-square object-cover"
                    loading="lazy"
                    width="800"
                    height="800"
                >
            {%- endif -%}
        </div>
    </div>
    <div class="h-10" style="background-color:#F9F9FB;"></div>
</div>
{%- endif -%}

{% schema %}
{
    "name": "Product Introduction",
    "tag": "section",
    "class": "product-intro-section",
    "presets": [
        {
            "name": "Product Introduction"
        }
    ]
}
{% endschema %}
