{%- comment -%}
  editorial-moment.liquid — Homepage room-finishing moment (catalog redesign round 2, variation 1)
  Split: image left, warm copy panel right. Stacks (image first) below 900px.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign moment_fallback = 'https://outlight.us/cdn/shop/files/custom_nano-banana-pro_1771203695405.png' -%}

<style>
  #ol-moment-{{ section.id }}{
    --ink:#131314;--paper:#F9F9FB;--gold:#C5A059;--warm:#f4f0eb;--body:#2d3338;
    --serif:'Newsreader',Georgia,serif;
    --sans:'Manrope',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    display:block;
    background:var(--paper);
    font-family:var(--sans);
    padding:80px 0;
  }
  #ol-moment-{{ section.id }} *{box-sizing:border-box;margin:0;padding:0;}
  #ol-moment-{{ section.id }} img{display:block;max-width:100%;}
  #ol-moment-{{ section.id }} a{color:inherit;text-decoration:none;}
  #ol-moment-{{ section.id }} .ol-container{
    width:100%;max-width:1360px;margin:0 auto;padding:0 32px;
    display:grid;grid-template-columns:1.35fr 1fr;gap:0;align-items:stretch;
  }
  #ol-moment-{{ section.id }} .moment-img{
    position:relative;overflow:hidden;min-height:420px;
  }
  #ol-moment-{{ section.id }} .moment-img img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  }
  #ol-moment-{{ section.id }} .moment-copy{
    background:var(--warm);display:flex;flex-direction:column;justify-content:center;
    padding:80px 64px;
  }
  #ol-moment-{{ section.id }} .eyebrow{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:.18em;text-transform:uppercase;color:var(--gold);
  }
  #ol-moment-{{ section.id }} .moment-copy h2{
    font-family:var(--serif);font-weight:200;
    font-size:clamp(26px,3vw,38px);line-height:1.12;letter-spacing:-0.01em;
    margin:24px 0 16px;color:var(--ink);
  }
  #ol-moment-{{ section.id }} .moment-copy h2 em{font-style:italic;color:var(--gold);}
  #ol-moment-{{ section.id }} .moment-copy p{
    font-size:14.5px;color:var(--body);max-width:38ch;margin-bottom:32px;line-height:1.55;
  }
  #ol-moment-{{ section.id }} .text-link{
    font-size:13px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;
    display:inline-flex;align-items:center;gap:8px;color:var(--ink);align-self:flex-start;
    padding-bottom:4px;border-bottom:1px solid var(--ink);
    transition:color .2s,border-color .2s,gap .2s;
  }
  #ol-moment-{{ section.id }} .text-link svg{width:14px;height:14px;}
  #ol-moment-{{ section.id }} .text-link:hover{color:var(--gold);border-color:var(--gold);gap:13px;}
  @media (max-width:900px){
    #ol-moment-{{ section.id }} .ol-container{
      grid-template-columns:1fr;padding:0 24px;
    }
    #ol-moment-{{ section.id }} .moment-img{
      aspect-ratio:16/10;min-height:0;order:1;
    }
    #ol-moment-{{ section.id }} .moment-copy{padding:64px 32px;order:2;}
  }
  @media (max-width:600px){
    #ol-moment-{{ section.id }} .ol-container{padding:0 20px;}
    #ol-moment-{{ section.id }} .moment-copy{padding:48px 24px;}
  }
</style>

<section id="ol-moment-{{ section.id }}">
  <div class="ol-container">
    <div class="moment-img">
      {%- if s.image != blank -%}
        <img
          src="{{ s.image | image_url: width: 1200 }}"
          srcset="{{ s.image | image_url: width: 700 }} 700w, {{ s.image | image_url: width: 1200 }} 1200w, {{ s.image | image_url: width: 1700 }} 1700w"
          sizes="(max-width:900px) 100vw, 57vw"
          width="1200"
          height="840"
          alt="{{ s.image.alt | default: 'A warmly lit interior room after dark with Outlight fixtures' | escape }}"
          loading="lazy">
      {%- else -%}
        <img src="{{ moment_fallback }}" width="1200" height="840" alt="A warmly lit interior room after dark with Outlight fixtures" loading="lazy">
      {%- endif -%}
    </div>
    <div class="moment-copy">
      {%- if s.eyebrow != blank -%}
        <span class="eyebrow">{{ s.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ s.heading }}</h2>
      {%- if s.body != blank -%}
        <p>{{ s.body | escape }}</p>
      {%- endif -%}
      {%- if s.link_text != blank -%}
        <a href="{{ s.link_url | default: '/pages/about-us' }}" class="text-link">{{ s.link_text | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Moment",
  "tag": "section",
  "class": "ol-moment-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Falls back to the approved mockup image when blank."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Outlight Idea"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading (italic = gold accent)",
      "default": "<p>The last thing a room <em>needs.</em></p>"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "A curated range of warm, sculptural lighting — chosen to give every room the glow that makes it feel complete."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Editorial Moment"
    }
  ]
}
{% endschema %}
