<footer class="bg-[#131314] text-[#F9F9FB] w-full">

  {%- comment -%} ── Newsletter Row ── {%- endcomment -%}
  <div class="border-b border-[#F9F9FB]/6">
    <div class="max-w-[1920px] mx-auto px-5 md:px-12 py-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">

        {%- comment -%} Left: label + heading {%- endcomment -%}
        <div class="md:col-span-5">
          <span class="font-label text-[0.6rem] uppercase tracking-[0.25em] text-[#C5A059] block mb-3">The Outlight Clearance Sale</span>
          <h3 class="heading-thin text-2xl text-[#F9F9FB] tracking-tight">{{ section.settings.newsletter_heading }}</h3>
        </div>

        {%- comment -%} Right: form {%- endcomment -%}
        <div class="md:col-span-7">
          <a href="/collections/best-sellers" class="inline-block px-6 py-4 font-label text-[#131314]" style="background:#C5A059;">Shop the Clearance Sale</a><p class="font-body text-[0.8rem] text-[#F9F9FB]/60 mt-3">{{ 'clearance.note' | t }}</p>
          
        </div>

      </div>
    </div>
  </div>

  {%- comment -%} ── 6-Column Link Grid ── {%- endcomment -%}
  <div class="max-w-[1920px] mx-auto px-5 md:px-12 py-14 md:py-20 grid grid-cols-2 md:grid-cols-6 gap-10 md:gap-8">

    {%- comment -%} Brand + socials — spans 2 cols on mobile, 1 on desktop {%- endcomment -%}
    <div class="col-span-2 md:col-span-1 space-y-5">
      <div class="font-headline text-[1.25rem] font-light text-[#F9F9FB]">
        <a href="{{ routes.root_url }}">
          {%- if settings.logo_image_light != blank -%}
            <img
              src="{{ settings.logo_image_light | image_url: width: 120 }}"
              alt="{{ shop.name }}"
              width="120" height="40"
              loading="lazy"
              class="block"
            >
          {%- elsif settings.logo_image != blank -%}
            <img
              src="{{ settings.logo_image | image_url: width: 120 }}"
              alt="{{ shop.name }}"
              width="120" height="40"
              loading="lazy"
              class="block brightness-0 invert"
            >
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </a>
      </div>
      <p class="font-body font-light text-[0.78rem] text-[#F9F9FB]/35 leading-relaxed">
        Architectural lighting for the minimalist conscious.
      </p>
      <div class="flex items-center gap-4 pt-1">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="text-[#F9F9FB]/30 hover:text-[#F9F9FB] transition-colors">
            <span class="material-symbols-outlined text-lg">photo_camera</span>
          </a>
        {%- endif -%}
        {%- if settings.social_facebook != blank -%}
          <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook" class="text-[#F9F9FB]/30 hover:text-[#F9F9FB] transition-colors">
            <span class="material-symbols-outlined text-lg">group</span>
          </a>
        {%- endif -%}
        {%- if settings.social_youtube != blank -%}
          <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube" class="text-[#F9F9FB]/30 hover:text-[#F9F9FB] transition-colors">
            <span class="material-symbols-outlined text-lg">play_arrow</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu_column' -%}
        {%- assign menu = linklists[block.settings.menu] -%}
        {%- if menu != blank and menu.links.size > 0 -%}
          <div class="space-y-4" {{ block.shopify_attributes }}>
            <span class="font-label text-[0.78rem] uppercase tracking-[0.1em] text-[#C5A059]/60 block">{{ menu.title }}</span>
            <ul class="space-y-3">
              {%- for link in menu.links -%}
                <li>
                  <a
                    class="font-body font-light text-[0.85rem] text-[#F9F9FB]/45 hover:text-[#F9F9FB] transition-colors"
                    href="{% if link.url contains '/new-arrivals' %}/collections/best-sellers{% else %}{{ link.url }}{% endif %}"
                  >
                    {% if link.url contains '/new-arrivals' %}Clearance Sale{% else %}{{ link.title }}{% endif %}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

  </div>

  {%- comment -%} ── Bottom Bar ── {%- endcomment -%}
  <div class="max-w-[1920px] mx-auto px-5 md:px-12 pb-8">
    <div class="pt-6 border-t border-[#F9F9FB]/6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <p class="font-label text-[0.55rem] uppercase tracking-[0.1em] text-[#F9F9FB]/25">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}
      </p>
      <div class="flex items-center gap-3">
        {%- for type in shop.enabled_payment_types -%}
          {% unless type == 'paypal' or type == 'venmo' %}{{ type | payment_type_svg_tag: class: 'w-10 h-6' }}{% endunless %}
        {%- endfor -%}
      </div>
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Clearance Sale: 60% off all lighting."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright suffix text",
      "default": "All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Create menus in Online Store › Navigation, then select here."
        }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}
