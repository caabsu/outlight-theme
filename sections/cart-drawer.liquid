{%- comment -%}
  Cart Drawer — Outlight Theme v2
  Slides in from the right on desktop (420px), full-width on mobile.
  Integrated with Shopify Cart API via Section Rendering API.
{%- endcomment -%}

{%- comment -%} Free shipping calculation {%- endcomment -%}
{%- assign free_shipping_cents = settings.free_shipping_threshold | times: 100 -%}
{%- assign remaining_cents = free_shipping_cents | minus: cart.total_price -%}
{%- if remaining_cents < 0 -%}{%- assign remaining_cents = 0 -%}{%- endif -%}
{%- assign progress_pct = cart.total_price | times: 100 | divided_by: free_shipping_cents -%}
{%- if progress_pct > 100 -%}{%- assign progress_pct = 100 -%}{%- endif -%}

{%- comment -%} Gift product check {%- endcomment -%}
{%- assign gift_product = settings.gift_product -%}
{%- assign gift_in_cart = false -%}
{%- if gift_product != blank -%}
  {%- for item in cart.items -%}
    {%- if item.product.id == gift_product.id -%}
      {%- assign gift_in_cart = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} Shipping protection check {%- endcomment -%}
{%- assign protection_product = settings.shipping_protection_product -%}
{%- assign protection_in_cart = false -%}
{%- if protection_product != blank -%}
  {%- for item in cart.items -%}
    {%- if item.product.id == protection_product.id -%}
      {%- assign protection_in_cart = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<!-- Backdrop -->
<div
  id="cart-backdrop"
  class="overlay-backdrop fixed inset-0 bg-[#131314]/40 z-[75]"
  data-cart-drawer-close
  aria-hidden="true"
></div>

<!-- Cart Drawer Panel -->
<div
  id="cart-drawer"
  class="cart-drawer fixed top-0 right-0 bottom-0 w-full md:w-[420px] bg-[#F9F9FB] z-[80] flex flex-col shadow-2xl"
  aria-label="Shopping cart"
  role="dialog"
  aria-modal="true"
  data-cart-drawer
>

  <!-- ── Header ── -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-[#131314]/5 shrink-0">
    <div class="flex items-center gap-3">
      <h2 class="heading-thin text-xl text-[#131314] tracking-tight">Your Cart</h2>
      {%- if cart.item_count > 0 -%}
        <span class="font-label text-[0.55rem] uppercase tracking-[0.1em] text-[#2d3338]/60 bg-[#131314]/5 px-2 py-0.5" data-cart-item-count>
          {{ cart.item_count }} {{ cart.item_count | pluralize: 'Item', 'Items' }}
        </span>
      {%- endif -%}
    </div>
    <button
      class="w-8 h-8 flex items-center justify-center text-[#2d3338]/55 hover:text-[#131314] transition-colors duration-200"
      data-cart-drawer-close
      aria-label="Close cart"
    >
      <span class="material-symbols-outlined text-lg">close</span>
    </button>
  </div>

  {%- if cart.item_count > 0 -%}

    <!-- ── Free Shipping ── -->
    {%- if settings.free_shipping_threshold > 0 -%}
      <div class="px-6 py-3 border-b border-[#131314]/5 shrink-0">
        <div class="flex items-center justify-between mb-2">
          {%- if remaining_cents <= 0 -%}
            <span class="font-body text-[0.8rem] font-light text-[#2d3338]/65">
              You've unlocked <span class="text-[#C5A059] font-[400]">free shipping</span>
            </span>
          {%- else -%}
            <span class="font-body text-[0.8rem] font-light text-[#2d3338]/65">
              You're <span class="text-[#C5A059] font-[400]">{{ remaining_cents | money }}</span> away from free shipping
            </span>
          {%- endif -%}
          <span class="material-symbols-outlined text-[#C5A059] text-sm">local_shipping</span>
        </div>
        <div class="w-full h-[2px] bg-[#131314]/6 relative overflow-hidden">
          <div
            class="absolute top-0 left-0 h-full bg-[#C5A059] transition-all duration-500"
            style="width: {{ progress_pct }}%;"
          ></div>
        </div>
      </div>
    {%- else -%}
      <div class="px-6 py-3 border-b border-[#131314]/5 shrink-0 flex items-center gap-2">
        <span class="material-symbols-outlined text-[#C5A059] text-sm">local_shipping</span>
        <span class="font-body text-[0.8rem] font-light text-[#2d3338]/65">
          <span class="text-[#C5A059] font-[400]">Free shipping</span> included on every order
        </span>
      </div>
    {%- endif -%}

    <!-- ── Cart Items ── -->
    <div class="flex-1 overflow-y-auto px-6 py-5 space-y-5" data-cart-items-container>
      {%- for item in cart.items -%}
        <div class="flex gap-4" data-cart-item data-line="{{ forloop.index }}">
          <!-- Product image -->
          <a href="{{ item.url }}" class="shrink-0 w-20 h-20 bg-[#EFEDE8] overflow-hidden block">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | escape }}" class="w-full h-full object-cover" loading="lazy" width="80" height="80">
            {%- else -%}
              <div class="w-full h-full flex items-center justify-center">
                <span class="material-symbols-outlined text-[#2d3338]/20 text-2xl">light</span>
              </div>
            {%- endif -%}
          </a>

          <!-- Item details -->
          <div class="flex-1 min-w-0">
            <div class="ol-cart-item-heading flex items-start justify-between gap-2 mb-1">
              <div class="min-w-0">
                <a
                  href="{{ item.url }}"
                  class="font-headline text-[0.95rem] font-[300] text-[#131314] block leading-snug hover:text-[#C5A059] transition-colors duration-200 truncate"
                >{{ item.product.title | split: ' ' | first }}</a>
                {%- unless item.variant.title == 'Default Title' -%}
                  <span class="font-label text-[0.55rem] uppercase tracking-[0.08em] text-[#2d3338]/65 mt-0.5 block">
                    {{ item.variant.title }}
                  </span>
                {%- endunless -%}
                {%- if item.selling_plan_allocation -%}
                  <span class="font-label text-[0.55rem] uppercase tracking-[0.08em] text-[#C5A059] mt-0.5 block">
                    {{ item.selling_plan_allocation.selling_plan.name }}
                  </span>
                {%- endif -%}
              </div>
              <!-- Price -->
              <div class="ol-cart-item-price text-right shrink-0">
                {% render 'cart-line-price', item: item %}
              </div>
            </div>

            <!-- Line item properties -->
            {%- if item.properties.size > 0 -%}
              {%- for property in item.properties -%}
                {%- unless property.last == blank or property.first contains '_' -%}
                  <span class="font-body text-[0.65rem] text-[#2d3338]/55 block">
                    {{ property.first }}: {{ property.last }}
                  </span>
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}

            <!-- Quantity + remove -->
            <div class="flex items-center justify-between mt-3">
              <div class="flex items-center border border-[#131314]/10">
                <button
                  class="qty-btn w-8 h-8 flex items-center justify-center font-body text-xs text-[#2d3338] hover:bg-[#131314]/5 transition-colors"
                  data-qty-minus
                  data-line="{{ forloop.index }}"
                  data-quantity="{{ item.quantity }}"
                  aria-label="Decrease quantity"
                >−</button>
                <span
                  class="w-8 h-8 flex items-center justify-center font-body text-[0.8rem] font-[400] text-[#131314] border-x border-[#131314]/6"
                  data-qty-display
                >{{ item.quantity }}</span>
                <button
                  class="qty-btn w-8 h-8 flex items-center justify-center font-body text-xs text-[#2d3338] hover:bg-[#131314]/5 transition-colors"
                  data-qty-plus
                  data-line="{{ forloop.index }}"
                  data-quantity="{{ item.quantity }}"
                  aria-label="Increase quantity"
                >+</button>
              </div>
              <button
                class="text-[#2d3338]/40 hover:text-[#131314] transition-colors duration-200 p-1"
                data-remove-item
                data-line="{{ forloop.index }}"
                aria-label="Remove {{ item.product.title | escape }} from cart"
              >
                <span class="material-symbols-outlined text-base">delete</span>
              </button>
            </div>
          </div>
        </div>

        {%- unless forloop.last -%}
          <div class="h-px bg-[#131314]/5"></div>
        {%- endunless -%}
      {%- endfor -%}
    </div>

    <!-- ── Footer ── -->
    <div class="border-t border-[#131314]/5 shrink-0">

      <!-- Spring Gift Banner -->
      {%- if gift_product != blank and gift_in_cart == false -%}
        <div class="bg-[#f4f0eb] px-6 py-3 flex items-center justify-between border-b border-[#131314]/5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 shrink-0 bg-[#e8e3dc] overflow-hidden">
              {%- if gift_product.featured_image -%}
                <img src="{{ gift_product.featured_image | image_url: width: 80 }}" alt="{{ gift_product.title | escape }}" class="w-full h-full object-cover" loading="lazy" width="40" height="40">
              {%- else -%}
                <div class="w-full h-full flex items-center justify-center">
                  <span class="material-symbols-outlined text-[#2d3338]/30 text-sm">redeem</span>
                </div>
              {%- endif -%}
            </div>
            <div>
              <span class="font-body text-[0.8rem] font-[400] text-[#131314] block">{{ gift_product.title | split: ' ' | first }}</span>
              <span class="font-body text-[0.68rem] font-light text-[#2d3338]/55">Free with order</span>
            </div>
          </div>
          <button
            class="font-label text-[0.6rem] uppercase tracking-[0.1em] text-[#131314] border border-[#131314]/15 px-4 py-1.5 hover:bg-[#131314] hover:text-[#F9F9FB] transition-all duration-200"
            data-add-gift
            data-variant-id="{{ gift_product.first_available_variant.id }}"
            aria-label="Add {{ gift_product.title | escape }} to cart"
          >Add</button>
        </div>
      {%- endif -%}

      <!-- Shipping Protection Toggle -->
      {%- if protection_product != blank -%}
        <div class="px-6 py-3 border-b border-[#131314]/5 flex items-center justify-between gap-4">
          <div>
            <span class="font-body text-[0.8rem] font-[400] text-[#131314] block">Shipping Protection</span>
            <span class="font-body text-[0.65rem] font-light text-[#2d3338]/55">Protect from damage, loss or theft</span>
          </div>
          <label class="relative cursor-pointer shrink-0" aria-label="Toggle shipping protection">
            <input
              type="checkbox"
              class="sr-only"
              data-protection-toggle
              data-variant-id="{{ protection_product.first_available_variant.id }}"
              {% if protection_in_cart %}checked{% endif %}
            >
            <div
              class="toggle-track w-10 h-[22px] rounded-full transition-colors duration-200 {% if protection_in_cart %}on{% endif %}"
              aria-hidden="true"
            >
              <div class="toggle-dot"></div>
            </div>
          </label>
        </div>
      {%- endif -%}

      <!-- Discount Code -->
      <div class="px-6 py-3 border-b border-[#131314]/5">
        <div class="flex gap-2" data-discount-wrapper>
          <input
            type="text"
            id="cart-discount-input"
            placeholder="Discount code"
            class="flex-1 border border-[#131314]/8 bg-transparent px-3 py-2 font-body text-[0.78rem] font-[300] text-[#131314] placeholder:text-[#131314]/20 focus:border-[#C5A059] focus:ring-0 outline-none transition-colors duration-200"
            data-discount-input
            autocomplete="off"
            autocapitalize="characters"
          >
          <button
            class="px-5 py-2 font-label text-[0.6rem] uppercase tracking-[0.1em] text-[#F9F9FB] bg-[#131314] hover:bg-[#C5A059] transition-colors duration-200"
            data-discount-apply
            aria-label="Apply discount code"
          >Apply</button>
        </div>
        {%- if cart.discount_applications.size > 0 -%}
          <div class="mt-2 flex flex-wrap gap-1.5">
            {%- for discount in cart.discount_applications -%}
              <div class="inline-flex items-center gap-1.5 bg-[#C5A059]/10 px-2.5 py-1 text-[#C5A059]">
                <span class="material-symbols-outlined text-xs" style="font-variation-settings:'FILL' 1;">sell</span>
                <span class="font-label text-[0.6rem] uppercase tracking-[0.05em] font-[600]">{{ discount.title }}</span>
                {%- if discount.total_allocated_amount > 0 -%}
                  <span class="font-body text-[0.6rem]">−{{ discount.total_allocated_amount | money }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <p class="font-body text-[0.62rem] font-light text-[#2d3338]/40 mt-1.5" data-discount-message></p>
      </div>

      <!-- Subtotal + Checkout -->
      <div class="px-6 py-5">
        <div class="flex items-baseline justify-between mb-1">
          <span class="font-body text-[0.9rem] font-[400] text-[#131314]">Subtotal</span>
          <div class="text-right">
            {%- if cart.total_discount > 0 -%}
              <span class="font-headline text-sm font-[300] text-[#2d3338]/45 line-through block">
                {{ cart.original_total_price | money }}
              </span>
            {%- endif -%}
            <span class="font-headline text-xl font-[300] text-[#131314]" data-cart-subtotal>
              {{ cart.total_price | money }}
            </span>
          </div>
        </div>
        {%- if cart.total_discount > 0 -%}
          <p class="font-body text-[0.65rem] font-light text-[#C5A059] mb-1">
            You save {{ cart.total_discount | money }}
          </p>
        {%- endif -%}
        <span class="font-body text-[0.65rem] font-light text-[#2d3338]/55 block mb-4">
          {{ 'cart.shipping_note' | t }}
        </span>
        <a
          href="{{ routes.cart_url }}/checkout"
          class="w-full py-4 font-label text-[0.72rem] uppercase tracking-[0.15em] text-[#F9F9FB] bg-[#131314] hover:bg-[#C5A059] transition-colors duration-300 flex items-center justify-center"
          data-checkout-btn
        >
          Checkout — {{ cart.total_price | money }}
        </a>
        <p class="font-body text-[0.6rem] font-light text-[#2d3338]/35 text-center mt-2.5">
          {{ 'cart.reassurance' | t }}
        </p>
      </div>

    </div><!-- /footer -->

  {%- else -%}

    <!-- ── Empty State ── -->
    <div class="flex-1 flex flex-col items-center justify-center px-6 text-center gap-5">
      <div class="w-16 h-16 border border-[#131314]/8 flex items-center justify-center">
        <span class="material-symbols-outlined text-[#2d3338]/25 text-3xl">shopping_bag</span>
      </div>
      <div>
        <p class="font-headline text-xl font-[300] text-[#131314] mb-1">Your cart is empty</p>
        <p class="font-body text-[0.8rem] font-light text-[#2d3338]/55">Discover our architectural lighting collections.</p>
      </div>
      <button
        class="font-label text-[0.7rem] uppercase tracking-[0.15em] text-[#F9F9FB] bg-[#131314] hover:bg-[#C5A059] transition-colors duration-200 px-10 py-4 mt-2"
        data-cart-drawer-close
      >Continue Shopping</button>
    </div>

  {%- endif -%}

</div><!-- /cart-drawer -->

<script>
(function () {
  'use strict';

  // ── DOM references ──────────────────────────────────────────────────────────
  const drawer   = document.getElementById('cart-drawer');
  const backdrop = document.getElementById('cart-backdrop');

  if (!drawer) return;

  // ── Open / Close ────────────────────────────────────────────────────────────
  function openCartDrawer() {
    drawer.classList.add('open');
    backdrop.classList.add('open');
    document.body.style.overflow = 'hidden';
    drawer.setAttribute('aria-hidden', 'false');
  }

  function closeCartDrawer() {
    drawer.classList.remove('open');
    backdrop.classList.remove('open');
    document.body.style.overflow = '';
    drawer.setAttribute('aria-hidden', 'true');
  }

  // ── Cart API helpers ────────────────────────────────────────────────────────

  /**
   * Add an item to the cart.
   * @param {number|string} variantId
   * @param {number} quantity
   * @param {object} [properties]
   */
  async function addToCart(variantId, quantity, properties) {
    const body = {
      items: [{ id: parseInt(variantId, 10), quantity: quantity || 1 }]
    };
    if (properties && Object.keys(properties).length) {
      body.items[0].properties = properties;
    }
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      credentials: 'same-origin',
      body: JSON.stringify(body)
    });
    if (!response.ok) {
      const err = await response.json().catch(() => ({}));
      throw new Error(err.description || 'Failed to add to cart');
    }
    return response.json();
  }

  /**
   * Change the quantity of a line item (1-based index).
   * @param {number} line   1-based line index
   * @param {number} quantity
   */
  async function updateCartItem(line, quantity) {
    const response = await fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      credentials: 'same-origin',
      body: JSON.stringify({ line: line, quantity: quantity })
    });
    if (!response.ok) throw new Error('Failed to update cart');
    return response.json();
  }

  /**
   * Remove a line item by 1-based index.
   * @param {number} line
   */
  async function removeCartItem(line) {
    return updateCartItem(line, 0);
  }

  /**
   * Sync the header cart-count badge with the live item count.
   * Creates the badge if missing, removes it when the cart is empty.
   * @param {number} count
   */
  function updateHeaderCount(count) {
    let badge = document.getElementById('cart-count-badge');
    if (count > 0) {
      if (badge) {
        badge.textContent = count;
        badge.style.display = '';
      } else {
        const bagBtn = document.querySelector('button[aria-label="Open cart"]');
        if (bagBtn) {
          badge = document.createElement('span');
          badge.id = 'cart-count-badge';
          badge.className = 'absolute -top-1 -right-1 w-4 h-4 flex items-center justify-center bg-[#C5A059] text-white font-label text-[0.45rem] leading-none';
          badge.textContent = count;
          bagBtn.style.position = 'relative';
          bagBtn.appendChild(badge);
        }
      }
    } else if (badge) {
      badge.remove();
    }
    // Legacy hook — any element opting in by class
    document.querySelectorAll('.cart-count').forEach(el => { el.textContent = count; });
  }

  /**
   * Re-render the cart drawer via the Section Rendering API.
   * Updates the drawer HTML and the header cart-count badge.
   */
  async function refreshCart() {
    const [sectionsRes, cartRes] = await Promise.all([
      fetch('/?sections=cart-drawer', { credentials: 'same-origin' }),
      fetch('/cart.js',               { credentials: 'same-origin' })
    ]);

    if (sectionsRes.ok) {
      const sections = await sectionsRes.json();
      const html = sections['cart-drawer'];
      if (html) {
        const temp = document.createElement('div');
        temp.innerHTML = html;
        const newDrawer = temp.querySelector('[data-cart-drawer]');
        if (newDrawer) {
          // Swap inner content, preserving the outer element so event listeners stay
          drawer.innerHTML = newDrawer.innerHTML;
        }
      }
    }

    if (cartRes.ok) {
      const data = await cartRes.json();
      updateHeaderCount(data.item_count);
    }
  }

  /**
   * Apply a discount code by redirecting through /discount/{code} then refreshing.
   * @param {string} code
   */
  async function applyDiscount(code) {
    if (!code || !code.trim()) return false;
    const trimmed = code.trim().toUpperCase();
    const before = await (await fetch('/cart.js', { credentials: 'same-origin' })).json();
    const beforeDiscount = before.total_discount || 0;
    // Hit the discount endpoint (sets the session discount; fetch follows the redirect)
    await fetch('/discount/' + encodeURIComponent(trimmed), {
      method: 'GET',
      credentials: 'same-origin'
    });
    const after = await (await fetch('/cart.js', { credentials: 'same-origin' })).json();
    await refreshCart();
    const titles = (after.cart_level_discount_applications || []).map(function (d) {
      return (d.title || '').toUpperCase();
    });
    return (after.total_discount || 0) > beforeDiscount || titles.indexOf(trimmed) !== -1;
  }

  // ── Event delegation on the drawer ─────────────────────────────────────────

  function setLoading(btn, loading) {
    btn.disabled = loading;
    if (loading) btn.setAttribute('data-loading', '');
    else btn.removeAttribute('data-loading');
  }

  drawer.addEventListener('click', async function (e) {

    // Close button / backdrop click
    if (e.target.closest('[data-cart-drawer-close]')) {
      closeCartDrawer();
      return;
    }

    // Quantity minus
    const minusBtn = e.target.closest('[data-qty-minus]');
    if (minusBtn) {
      e.preventDefault();
      const line = parseInt(minusBtn.dataset.line, 10);
      const item = minusBtn.closest('[data-cart-item]');
      const display = item ? item.querySelector('[data-qty-display]') : null;
      const currentQty = display ? parseInt(display.textContent, 10) : parseInt(minusBtn.dataset.quantity, 10);
      const newQty = Math.max(0, currentQty - 1);
      setLoading(minusBtn, true);
      try {
        await updateCartItem(line, newQty);
        await refreshCart();
      } catch (err) {
        console.error('[cart-drawer] updateCartItem failed:', err);
      }
      // Button may no longer exist after refreshCart re-renders — no need to re-enable
      return;
    }

    // Quantity plus
    const plusBtn = e.target.closest('[data-qty-plus]');
    if (plusBtn) {
      e.preventDefault();
      const line = parseInt(plusBtn.dataset.line, 10);
      const item = plusBtn.closest('[data-cart-item]');
      const display = item ? item.querySelector('[data-qty-display]') : null;
      const currentQty = display ? parseInt(display.textContent, 10) : parseInt(plusBtn.dataset.quantity, 10);
      setLoading(plusBtn, true);
      try {
        await updateCartItem(line, currentQty + 1);
        await refreshCart();
      } catch (err) {
        console.error('[cart-drawer] updateCartItem failed:', err);
      }
      return;
    }

    // Remove item
    const removeBtn = e.target.closest('[data-remove-item]');
    if (removeBtn) {
      e.preventDefault();
      const line = parseInt(removeBtn.dataset.line, 10);
      setLoading(removeBtn, true);
      try {
        await removeCartItem(line);
        await refreshCart();
      } catch (err) {
        console.error('[cart-drawer] removeCartItem failed:', err);
      }
      return;
    }

    // Add spring gift
    const giftBtn = e.target.closest('[data-add-gift]');
    if (giftBtn) {
      e.preventDefault();
      const variantId = giftBtn.dataset.variantId;
      const origText = giftBtn.textContent;
      setLoading(giftBtn, true);
      giftBtn.textContent = '...';
      try {
        await addToCart(variantId, 1, { _gift: 'true' });
        await refreshCart();
      } catch (err) {
        console.error('[cart-drawer] addToCart (gift) failed:', err);
        giftBtn.disabled = false;
        giftBtn.textContent = origText;
      }
      return;
    }

    // Apply discount button
    const discountApplyBtn = e.target.closest('[data-discount-apply]');
    if (discountApplyBtn) {
      e.preventDefault();
      const input = drawer.querySelector('[data-discount-input]');
      const msgEl = drawer.querySelector('[data-discount-message]');
      const code  = input ? input.value.trim() : '';
      if (!code) {
        if (msgEl) { msgEl.textContent = 'Please enter a discount code.'; }
        return;
      }
      setLoading(discountApplyBtn, true);
      discountApplyBtn.textContent = '...';
      let applied = false;
      try {
        applied = await applyDiscount(code);
      } catch (err) {
        console.error('[cart-drawer] applyDiscount failed:', err);
        const msgErr = drawer.querySelector('[data-discount-message]');
        if (msgErr) { msgErr.textContent = 'Could not apply code. Please try again.'; msgErr.style.color = '#b4232a'; }
        return;
      }
      // refreshCart re-rendered the drawer — re-query the (now fresh) message element
      const msgAfter = drawer.querySelector('[data-discount-message]');
      if (msgAfter) {
        if (applied) {
          msgAfter.textContent = 'Code applied — discount added below.';
          msgAfter.style.color = '#C5A059';
        } else {
          msgAfter.textContent = 'That code isn’t valid for the items in your cart.';
          msgAfter.style.color = '#b4232a';
        }
      }
      if (!applied) {
        const inputAfter = drawer.querySelector('[data-discount-input]');
        if (inputAfter) inputAfter.value = code;
      }
      return;
    }

  });

  // Backdrop close
  if (backdrop) {
    backdrop.addEventListener('click', closeCartDrawer);
  }

  // Shipping protection toggle (change event)
  drawer.addEventListener('change', async function (e) {
    const toggle = e.target.closest('[data-protection-toggle]');
    if (!toggle) return;

    const variantId = toggle.dataset.variantId;
    if (!variantId) return;

    toggle.disabled = true;
    try {
      if (toggle.checked) {
        await addToCart(variantId, 1, {});
      } else {
        // Find the item in the live cart by variant ID, then remove by key
        const cartRes = await fetch('/cart.js', { credentials: 'same-origin' });
        const cart = await cartRes.json();
        const found = cart.items.find(i => String(i.variant_id) === String(variantId));
        if (found) {
          await fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ id: found.key, quantity: 0 })
          });
        }
      }
      await refreshCart();
    } catch (err) {
      console.error('[cart-drawer] protection toggle failed:', err);
      // Revert the visual toggle state
      toggle.checked = !toggle.checked;
      toggle.disabled = false;
    }
  });

  // Discount input — apply on Enter key
  drawer.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      const input = e.target.closest('[data-discount-input]');
      if (input) {
        e.preventDefault();
        const applyBtn = drawer.querySelector('[data-discount-apply]');
        if (applyBtn) applyBtn.click();
      }
    }
  });

  // ── Cart trigger in header (data-cart-trigger) ───────────────────────────
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-cart-trigger]')) {
      e.preventDefault();
      openCartDrawer();
    }
  });

  // ── Custom event listener (dispatched by add-to-cart JS, etc.) ──────────
  document.addEventListener('cart:open', openCartDrawer);

  // ── Keyboard: Escape to close ────────────────────────────────────────────
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && drawer.classList.contains('open')) {
      closeCartDrawer();
    }
  });

  // ── Global API surface ───────────────────────────────────────────────────
  window.openCartDrawer  = openCartDrawer;
  window.closeCartDrawer = closeCartDrawer;
  window.addToCart       = addToCart;
  window.updateCartItem  = updateCartItem;
  window.removeCartItem  = removeCartItem;
  window.refreshCart     = refreshCart;
  window.applyDiscount   = applyDiscount;

})();
</script>

