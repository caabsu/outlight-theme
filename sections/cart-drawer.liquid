{%- assign free_shipping_cents = settings.free_shipping_threshold | times: 100 -%}
{%- assign remaining_cents = free_shipping_cents | minus: cart.total_price | at_least: 0 -%}
{%- assign gift_product = settings.gift_product -%}
{%- assign protection_product = settings.shipping_protection_product -%}
{%- assign gift_in_cart = false -%}
{%- assign protection_in_cart = false -%}
{%- for item in cart.items -%}
  {%- if item.product.id == gift_product.id -%}{%- assign gift_in_cart = true -%}{%- endif -%}
  {%- if item.product.id == protection_product.id -%}{%- assign protection_in_cart = true -%}{%- endif -%}
{%- endfor -%}
<div id="cart-backdrop" class="overlay-backdrop fixed inset-0 bg-[#131314]/40 z-[75]" data-cart-drawer-close aria-hidden="true"></div>
<div id="cart-drawer" class="cart-drawer ol-cart-panel fixed top-0 right-0 bottom-0 w-full md:w-[420px] z-[80]" aria-label="{{ 'cart.title' | t | escape }}" role="dialog" aria-modal="true" aria-hidden="true" inert data-cart-drawer>
  <div class="ol-drawer-header">
    <h2>{{ 'cart.title' | t }}{% if cart.item_count > 0 %}<span data-cart-item-count>{{ cart.item_count }}</span>{% endif %}</h2>
    <button type="button" class="ol-drawer-icon-button" data-cart-drawer-close aria-label="{{ 'cart.drawer.close' | t | escape }}"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
  </div>
  {%- if cart.item_count > 0 -%}
    <div class="ol-drawer-support">
      <span class="material-symbols-outlined" aria-hidden="true">verified</span>
      <div><p class="ol-drawer-support-title">{{ 'cart.drawer.support_title' | t }}</p><p class="ol-drawer-support-copy">{{ 'cart.drawer.support_copy' | t }}</p></div>
    </div>
    <div class="ol-drawer-items" data-cart-items-container>
      {%- for item in cart.items -%}
        <div class="ol-drawer-item" data-cart-item data-line="{{ forloop.index }}">
          <a href="{{ item.url }}" class="ol-drawer-photo">
            {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" loading="lazy" width="96" height="112">{%- endif -%}
          </a>
          <div class="ol-drawer-item-content">
            <div class="ol-drawer-item-top">
              <a href="{{ item.url }}" class="ol-drawer-product-name">{{ item.product.title | split: ' ' | first }}</a>
              <button type="button" class="ol-drawer-remove" data-remove-item data-line="{{ forloop.index }}" aria-label="{{ 'cart.drawer.remove' | t: product: item.product.title | escape }}"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
            </div>
            {%- unless item.variant.title == 'Default Title' -%}<p class="ol-drawer-variant">{{ item.variant.title }}</p>{%- endunless -%}
            {%- if item.selling_plan_allocation -%}<p class="ol-drawer-variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
            {%- for property in item.properties -%}{%- unless property.last == blank or property.first contains '_' -%}<p class="ol-drawer-variant">{{ property.first }}: {{ property.last }}</p>{%- endunless -%}{%- endfor -%}
            {%- assign delivery_days = item.product.metafields.custom.delivery_time.value | plus: 0 -%}
            {%- if delivery_days > 0 -%}<p class="ol-drawer-delivery">{{ 'cart.drawer.delivery_estimate' | t: days: delivery_days }}</p>{%- endif -%}
            <div class="ol-drawer-item-bottom">
              <div class="ol-drawer-quantity" role="group" aria-label="{{ 'cart.drawer.quantity' | t: product: item.product.title | escape }}">
                <button type="button" data-qty-minus data-line="{{ forloop.index }}" data-quantity="{{ item.quantity }}" aria-label="{{ 'cart.drawer.decrease' | t | escape }}">−</button>
                <span data-qty-display>{{ item.quantity }}</span>
                <button type="button" data-qty-plus data-line="{{ forloop.index }}" data-quantity="{{ item.quantity }}" aria-label="{{ 'cart.drawer.increase' | t | escape }}">+</button>
              </div>
              <div class="ol-drawer-price">{% render 'cart-line-price', item: item %}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
      <div class="ol-drawer-extras">      
      {%- if gift_product != blank and gift_in_cart == false -%}
        <div class="bg-[#f4f0eb] px-6 py-3 flex items-center justify-between border-b border-[#131314]/5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 shrink-0 bg-[#e8e3dc] overflow-hidden">
              {%- if gift_product.featured_image -%}
                <img src="{{ gift_product.featured_image | image_url: width: 80 }}" alt="{{ gift_product.title | escape }}" class="w-full h-full object-cover" loading="lazy" width="40" height="40">
              {%- else -%}
                <div class="w-full h-full flex items-center justify-center">
                  <span class="material-symbols-outlined text-[#2d3338]/30 text-sm">redeem</span>
                </div>
              {%- endif -%}
            </div>
            <div>
              <span class="font-body text-[0.8rem] font-[400] text-[#131314] block">{{ gift_product.title | split: ' ' | first }}</span>
              <span class="font-body text-[0.68rem] font-light text-[#2d3338]/55">Free with order</span>
            </div>
          </div>
          <button
            class="font-label text-[0.6rem] uppercase tracking-[0.1em] text-[#131314] border border-[#131314]/15 px-4 py-1.5 hover:bg-[#131314] hover:text-[#F9F9FB] transition-all duration-200"
            data-add-gift
            data-variant-id="{{ gift_product.first_available_variant.id }}"
            aria-label="Add {{ gift_product.title | escape }} to cart"
          >Add</button>
        </div>
      {%- endif -%}

      
      {%- if protection_product != blank -%}
        <div class="px-6 py-3 border-b border-[#131314]/5 flex items-center justify-between gap-4">
          <div>
            <span class="font-body text-[0.8rem] font-[400] text-[#131314] block">Shipping Protection</span>
            <span class="font-body text-[0.65rem] font-light text-[#2d3338]/55">Protect from damage, loss or theft</span>
          </div>
          <label class="relative cursor-pointer shrink-0" aria-label="Toggle shipping protection">
            <input
              type="checkbox"
              class="sr-only"
              data-protection-toggle
              data-variant-id="{{ protection_product.first_available_variant.id }}"
              {% if protection_in_cart %}checked{% endif %}
            >
            <div
              class="toggle-track w-10 h-[22px] rounded-full transition-colors duration-200 {% if protection_in_cart %}on{% endif %}"
              aria-hidden="true"
            >
              <div class="toggle-dot"></div>
            </div>
          </label>
        </div>
      {%- endif -%}

</div>
    </div>
    <div class="ol-drawer-footer">
      <div class="ol-drawer-discount">
        <div class="ol-drawer-discount-fields" data-discount-wrapper>
          <input type="text" id="cart-discount-input" placeholder="{{ 'cart.drawer.discount_placeholder' | t | escape }}" aria-label="{{ 'cart.drawer.discount_placeholder' | t | escape }}" data-discount-input autocomplete="off" autocapitalize="characters">
          <button type="button" data-discount-apply>{{ 'cart.drawer.apply' | t }}</button>
        </div>
        {%- if cart.discount_applications.size > 0 -%}
          <ul class="ol-drawer-applied-discounts" aria-label="{{ 'cart.drawer.applied_discounts' | t | escape }}">
            {%- for discount in cart.discount_applications -%}
              <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span><span>{{ discount.title }}</span><span class="ol-drawer-discount-status">{{ 'cart.drawer.applied' | t }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <p class="ol-drawer-discount-message" role="status" data-discount-message></p>
      </div>
      <div class="ol-drawer-breakdown">
        <div><span>{{ 'cart.drawer.original_total' | t }}</span><span data-cart-original-total>{{ cart.original_total_price | money }}</span></div>
        <div class="ol-drawer-discount-total"><span>{{ 'cart.drawer.total_discount' | t }}</span><span data-cart-total-discount>{% if cart.total_discount > 0 %}−{% endif %}{{ cart.total_discount | money }}</span></div>
      </div>
      <div class="ol-drawer-total"><span>{{ 'cart.subtotal' | t }}</span><strong data-cart-subtotal>{{ cart.total_price | money }}</strong></div>
      <p class="ol-drawer-shipping">
        {%- if remaining_cents <= 0 -%}{{ 'cart.drawer.shipping_tax' | t }}{%- else -%}{{ 'cart.drawer.calculated_shipping_tax' | t }}{%- endif -%}
      </p>
      {%- if remaining_cents > 0 -%}<p class="ol-drawer-shipping">{%- assign shipping_remaining = remaining_cents | money -%}{{ 'cart.drawer.shipping_threshold' | t: amount: shipping_remaining }}</p>{%- endif -%}
      <a href="{{ routes.cart_url }}?whop_checkout=1" class="ol-drawer-checkout" data-checkout-btn><span class="material-symbols-outlined" aria-hidden="true">lock</span>{{ 'cart.drawer.checkout' | t }}<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
      <a class="ol-drawer-policy" href="{{ shop.refund_policy.url }}">{{ 'cart.drawer.policy_link' | t }}</a>
    </div>
  {%- else -%}
    <div class="ol-drawer-empty"><span class="material-symbols-outlined" aria-hidden="true">shopping_bag</span><h3>{{ 'cart.empty' | t }}</h3><button type="button" data-cart-drawer-close>{{ 'cart.drawer.continue_shopping' | t }}</button></div>
  {%- endif -%}
</div>
<script>
(function () {
  'use strict';

  // ── DOM references ──────────────────────────────────────────────────────────
  const drawer   = document.getElementById('cart-drawer');
  const backdrop = document.getElementById('cart-backdrop');

  if (!drawer) return;

  let previousFocus = null;

  // ── Open / Close ────────────────────────────────────────────────────────────
  function openCartDrawer() {
    if (!drawer.classList.contains('open') || drawer.inert) previousFocus = document.activeElement;
    drawer.inert = false;
    drawer.classList.add('open');
    backdrop.classList.add('open');
    document.body.style.overflow = 'hidden';
    drawer.setAttribute('aria-hidden', 'false');
    drawer.querySelector('[data-cart-drawer-close]')?.focus({preventScroll:true});
  }

  function closeCartDrawer() {
    drawer.classList.remove('open');
    backdrop.classList.remove('open');
    document.body.style.overflow = '';
    drawer.setAttribute('aria-hidden', 'true');
    drawer.inert = true;
    if (previousFocus?.isConnected) previousFocus.focus({preventScroll:true});
  }

  new MutationObserver(() => {
    if (drawer.classList.contains('open') && drawer.inert) openCartDrawer();
    else if (!drawer.classList.contains('open') && !drawer.inert) closeCartDrawer();
    else if (drawer.classList.contains('open') && !drawer.contains(document.activeElement)) drawer.querySelector('[data-cart-drawer-close]')?.focus({preventScroll:true});
  }).observe(drawer, {attributes:true,attributeFilter:['class'],childList:true});

  // ── Cart API helpers ────────────────────────────────────────────────────────

  /**
   * Add an item to the cart.
   * @param {number|string} variantId
   * @param {number} quantity
   * @param {object} [properties]
   */
  async function addToCart(variantId, quantity, properties) {
    const body = {
      items: [{ id: parseInt(variantId, 10), quantity: quantity || 1 }]
    };
    if (properties && Object.keys(properties).length) {
      body.items[0].properties = properties;
    }
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      credentials: 'same-origin',
      body: JSON.stringify(body)
    });
    if (!response.ok) {
      const err = await response.json().catch(() => ({}));
      throw new Error(err.description || 'Failed to add to cart');
    }
    return response.json();
  }

  /**
   * Change the quantity of a line item (1-based index).
   * @param {number} line   1-based line index
   * @param {number} quantity
   */
  async function updateCartItem(line, quantity) {
    const response = await fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      credentials: 'same-origin',
      body: JSON.stringify({ line: line, quantity: quantity })
    });
    if (!response.ok) throw new Error('Failed to update cart');
    return response.json();
  }

  /**
   * Remove a line item by 1-based index.
   * @param {number} line
   */
  async function removeCartItem(line) {
    return updateCartItem(line, 0);
  }

  /**
   * Sync the header cart-count badge with the live item count.
   * Creates the badge if missing, removes it when the cart is empty.
   * @param {number} count
   */
  function updateHeaderCount(count) {
    let badge = document.getElementById('cart-count-badge');
    if (count > 0) {
      if (badge) {
        badge.textContent = count;
        badge.style.display = '';
      } else {
        const bagBtn = document.querySelector('button[aria-label="Open cart"]');
        if (bagBtn) {
          badge = document.createElement('span');
          badge.id = 'cart-count-badge';
          badge.className = 'absolute -top-1 -right-1 w-4 h-4 flex items-center justify-center bg-[#C5A059] text-white font-label text-[0.45rem] leading-none';
          badge.textContent = count;
          bagBtn.style.position = 'relative';
          bagBtn.appendChild(badge);
        }
      }
    } else if (badge) {
      badge.remove();
    }
    // Legacy hook — any element opting in by class
    document.querySelectorAll('.cart-count').forEach(el => { el.textContent = count; });
  }

  /**
   * Re-render the cart drawer via the Section Rendering API.
   * Updates the drawer HTML and the header cart-count badge.
   */
  async function refreshCart(focusTarget) {
    const focused = drawer.contains(document.activeElement) ? document.activeElement : null;
    const focusAttribute = focusTarget?.attribute || focused && ['data-qty-plus','data-qty-minus','data-remove-item'].find(name => focused.hasAttribute(name));
    const focusLine = focusTarget?.line || focused?.dataset.line;
    const [sectionsRes, cartRes] = await Promise.all([
      fetch('/?sections=cart-drawer', { credentials: 'same-origin' }),
      fetch('/cart.js',               { credentials: 'same-origin' })
    ]);

    if (sectionsRes.ok) {
      const sections = await sectionsRes.json();
      const html = sections['cart-drawer'];
      if (html) {
        const temp = document.createElement('div');
        temp.innerHTML = html;
        const newDrawer = temp.querySelector('[data-cart-drawer]');
        if (newDrawer) {
          // Swap inner content, preserving the outer element so event listeners stay
          drawer.innerHTML = newDrawer.innerHTML;
          if (focusAttribute && drawer.classList.contains('open')) {
            const control = drawer.querySelector('['+focusAttribute+'][data-line="'+focusLine+'"]') || drawer.querySelector('[data-cart-drawer-close]');
            control?.focus({preventScroll:true});
          }
        }
      }
    }

    if (cartRes.ok) {
      const data = await cartRes.json();
      updateHeaderCount(data.item_count);
    }
  }

  /**
   * Apply a discount code by redirecting through /discount/{code} then refreshing.
   * @param {string} code
   */
  async function applyDiscount(code) {
    if (!code || !code.trim()) return false;
    const trimmed = code.trim().toUpperCase();
    const before = await (await fetch('/cart.js', { credentials: 'same-origin' })).json();
    const beforeDiscount = before.total_discount || 0;
    // Hit the discount endpoint (sets the session discount; fetch follows the redirect)
    await fetch('/discount/' + encodeURIComponent(trimmed), {
      method: 'GET',
      credentials: 'same-origin'
    });
    const after = await (await fetch('/cart.js', { credentials: 'same-origin' })).json();
    await refreshCart();
    const titles = (after.cart_level_discount_applications || []).map(function (d) {
      return (d.title || '').toUpperCase();
    });
    return (after.total_discount || 0) > beforeDiscount || titles.indexOf(trimmed) !== -1;
  }

  // ── Event delegation on the drawer ─────────────────────────────────────────

  function setLoading(btn, loading) {
    btn.disabled = loading;
    if (loading) btn.setAttribute('data-loading', '');
    else btn.removeAttribute('data-loading');
  }

  drawer.addEventListener('click', async function (e) {

    // Close button / backdrop click
    if (e.target.closest('[data-cart-drawer-close]')) {
      closeCartDrawer();
      return;
    }

    // Quantity minus
    const minusBtn = e.target.closest('[data-qty-minus]');
    if (minusBtn) {
      e.preventDefault();
      const line = parseInt(minusBtn.dataset.line, 10);
      const item = minusBtn.closest('[data-cart-item]');
      const display = item ? item.querySelector('[data-qty-display]') : null;
      const currentQty = display ? parseInt(display.textContent, 10) : parseInt(minusBtn.dataset.quantity, 10);
      const newQty = Math.max(0, currentQty - 1);
      setLoading(minusBtn, true);
      try {
        await updateCartItem(line, newQty);
        await refreshCart({attribute:'data-qty-minus',line});
      } catch (err) {
        console.error('[cart-drawer] updateCartItem failed:', err);
      }
      // Button may no longer exist after refreshCart re-renders — no need to re-enable
      return;
    }

    // Quantity plus
    const plusBtn = e.target.closest('[data-qty-plus]');
    if (plusBtn) {
      e.preventDefault();
      const line = parseInt(plusBtn.dataset.line, 10);
      const item = plusBtn.closest('[data-cart-item]');
      const display = item ? item.querySelector('[data-qty-display]') : null;
      const currentQty = display ? parseInt(display.textContent, 10) : parseInt(plusBtn.dataset.quantity, 10);
      setLoading(plusBtn, true);
      try {
        await updateCartItem(line, currentQty + 1);
        await refreshCart({attribute:'data-qty-plus',line});
      } catch (err) {
        console.error('[cart-drawer] updateCartItem failed:', err);
      }
      return;
    }

    // Remove item
    const removeBtn = e.target.closest('[data-remove-item]');
    if (removeBtn) {
      e.preventDefault();
      const line = parseInt(removeBtn.dataset.line, 10);
      setLoading(removeBtn, true);
      try {
        await removeCartItem(line);
        await refreshCart({attribute:'data-remove-item',line});
      } catch (err) {
        console.error('[cart-drawer] removeCartItem failed:', err);
      }
      return;
    }

    // Add spring gift
    const giftBtn = e.target.closest('[data-add-gift]');
    if (giftBtn) {
      e.preventDefault();
      const variantId = giftBtn.dataset.variantId;
      const origText = giftBtn.textContent;
      setLoading(giftBtn, true);
      giftBtn.textContent = '...';
      try {
        await addToCart(variantId, 1, { _gift: 'true' });
        await refreshCart();
      } catch (err) {
        console.error('[cart-drawer] addToCart (gift) failed:', err);
        giftBtn.disabled = false;
        giftBtn.textContent = origText;
      }
      return;
    }

    // Apply discount button
    const discountApplyBtn = e.target.closest('[data-discount-apply]');
    if (discountApplyBtn) {
      e.preventDefault();
      const input = drawer.querySelector('[data-discount-input]');
      const msgEl = drawer.querySelector('[data-discount-message]');
      const code  = input ? input.value.trim() : '';
      if (!code) {
        if (msgEl) { msgEl.textContent = 'Please enter a discount code.'; }
        return;
      }
      setLoading(discountApplyBtn, true);
      discountApplyBtn.textContent = '...';
      let applied = false;
      try {
        applied = await applyDiscount(code);
      } catch (err) {
        console.error('[cart-drawer] applyDiscount failed:', err);
        const msgErr = drawer.querySelector('[data-discount-message]');
        if (msgErr) { msgErr.textContent = 'Could not apply code. Please try again.'; msgErr.style.color = '#b4232a'; }
        return;
      }
      // refreshCart re-rendered the drawer — re-query the (now fresh) message element
      const msgAfter = drawer.querySelector('[data-discount-message]');
      if (msgAfter) {
        if (applied) {
          msgAfter.textContent = 'Code applied — discount added below.';
          msgAfter.style.color = '#C5A059';
        } else {
          msgAfter.textContent = 'That code isn’t valid for the items in your cart.';
          msgAfter.style.color = '#b4232a';
        }
      }
      if (!applied) {
        const inputAfter = drawer.querySelector('[data-discount-input]');
        if (inputAfter) inputAfter.value = code;
      }
      return;
    }

  });

  // Backdrop close
  if (backdrop) {
    backdrop.addEventListener('click', closeCartDrawer);
  }

  // Shipping protection toggle (change event)
  drawer.addEventListener('change', async function (e) {
    const toggle = e.target.closest('[data-protection-toggle]');
    if (!toggle) return;

    const variantId = toggle.dataset.variantId;
    if (!variantId) return;

    toggle.disabled = true;
    try {
      if (toggle.checked) {
        await addToCart(variantId, 1, {});
      } else {
        // Find the item in the live cart by variant ID, then remove by key
        const cartRes = await fetch('/cart.js', { credentials: 'same-origin' });
        const cart = await cartRes.json();
        const found = cart.items.find(i => String(i.variant_id) === String(variantId));
        if (found) {
          await fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ id: found.key, quantity: 0 })
          });
        }
      }
      await refreshCart();
    } catch (err) {
      console.error('[cart-drawer] protection toggle failed:', err);
      // Revert the visual toggle state
      toggle.checked = !toggle.checked;
      toggle.disabled = false;
    }
  });

  // Discount input — apply on Enter key
  drawer.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      const input = e.target.closest('[data-discount-input]');
      if (input) {
        e.preventDefault();
        const applyBtn = drawer.querySelector('[data-discount-apply]');
        if (applyBtn) applyBtn.click();
      }
    }
  });

  // ── Cart trigger in header (data-cart-trigger) ───────────────────────────
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-cart-trigger]')) {
      e.preventDefault();
      openCartDrawer();
    }
  });

  // ── Custom event listener (dispatched by add-to-cart JS, etc.) ──────────
  document.addEventListener('cart:open', openCartDrawer);

  // ── Keyboard: Escape to close ────────────────────────────────────────────
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Tab' && drawer.classList.contains('open')) {
      const controls = [...drawer.querySelectorAll('a[href],button:not(:disabled),input:not(:disabled),summary')].filter(el => el.getClientRects().length);
      const first=controls[0],last=controls[controls.length-1];
      if (e.shiftKey && (document.activeElement===first || !drawer.contains(document.activeElement))) {e.preventDefault();last?.focus();}
      else if (!e.shiftKey && (document.activeElement===last || !drawer.contains(document.activeElement))) {e.preventDefault();first?.focus();}
    }
    if (e.key === 'Escape' && drawer.classList.contains('open')) {
      closeCartDrawer();
    }
  });

  // ── Global API surface ───────────────────────────────────────────────────
  window.openCartDrawer  = openCartDrawer;
  window.closeCartDrawer = closeCartDrawer;
  window.addToCart       = addToCart;
  window.updateCartItem  = updateCartItem;
  window.removeCartItem  = removeCartItem;
  window.refreshCart     = refreshCart;
  window.applyDiscount   = applyDiscount;

})();
</script>

{% schema %}
{
  "name": "Cart Drawer",
  "class": "cart-drawer-section",
  "settings": []
}
{% endschema %}
