{%- comment -%}
  Kit Configurator — Bedroom Kit
  Ported from website/pages/kit-configurator.html. Markup, CSS, and JS are
  preserved as-is. Shopify wiring replaces hardcoded product data with data
  pulled from a collection (section.settings.kit_collection) and replaces
  the starter-kit tier list with section.blocks of type "starter_product".

  The placeholder <nav class="nav"> from the mock is intentionally omitted —
  the theme provides its own header that wraps page templates.
{%- endcomment -%}

{%- liquid
  # section.settings.kit_collection is a Collection drop (type: collection), not a handle string.
  # Assign it directly — don't double-index through `collections[]`.
  assign kit_collection = section.settings.kit_collection
  assign use_default_pair = false
  if kit_collection == blank or kit_collection.products.size == 0
    assign use_default_pair = true
  endif
  assign floor_collection = collections['floor-lamps']
  assign table_collection = collections['table-lamps']

  assign starter_blocks = section.blocks | where: 'type', 'starter_product'

  assign hero_warm_url = ''
  if section.settings.compare_hero_warm_image != blank
    assign hero_warm_url = section.settings.compare_hero_warm_image | image_url: width: 2000
  else
    assign hero_warm_url = 'hero-evening-bedroom.jpeg' | asset_url
  endif

  assign hero_cold_url = ''
  if section.settings.compare_hero_image != blank
    assign hero_cold_url = section.settings.compare_hero_image | image_url: width: 2000
  else
    assign hero_cold_url = 'hero-cold-bedroom.jpeg' | asset_url
  endif

  # Hero background image is independent of the Kelvin-slider images.
  # Falls back to the warm slider image, then to the legacy asset.
  assign hero_image_url = ''
  if section.settings.hero_image != blank
    assign hero_image_url = section.settings.hero_image | image_url: width: 2400
  else
    assign hero_image_url = hero_warm_url
  endif

  # Optional bridge hero image — falls back to the hero image.
  assign bridge_image_url = ''
  if section.settings.bridge_image != blank
    assign bridge_image_url = section.settings.bridge_image | image_url: width: 1800
  else
    assign bridge_image_url = hero_image_url
  endif

  # ----------------------------------------------------------------
  # WARM WALLET — read active credit from customer metafield
  # ----------------------------------------------------------------
  # Metafield shape (namespace: custom, key: warm_wallet, type: json):
  #   { "code": "WARM150-C123-AB7F", "balance": 150, "expires_at": "2026-07-22", "issued_at": "2026-04-22" }
  # The backend app's orders/create webhook writes this when a tier-2 kit is purchased.
  # Theme only reads it — no mutation, no API call.
  assign wallet_code = ''
  assign wallet_balance = 0
  assign wallet_expires = ''
  assign wallet_active = false
  if customer and customer.metafields.custom.warm_wallet
    assign wallet_code = customer.metafields.custom.warm_wallet.value.code | default: ''
    assign wallet_balance = customer.metafields.custom.warm_wallet.value.balance | default: 0 | plus: 0
    assign wallet_expires = customer.metafields.custom.warm_wallet.value.expires_at | default: ''
    if wallet_code != '' and wallet_balance > 0
      assign wallet_active = true
    endif
  endif

  # ----------------------------------------------------------------
  # FIRST-PURCHASE WELCOME — 10% off for new customers
  # ----------------------------------------------------------------
  # Shopify discount code (FIRSTROOM10) is scoped admin-side to the "first-time
  # customers" segment (number_of_orders = 0). We only append the code to the
  # checkout URL when the logged-in user is eligible (0 orders) OR they're
  # anonymous (likely first-time). If they're not eligible, Shopify will just
  # reject the code at checkout — but we avoid that awkward state by omitting
  # the code for customers who've already bought.
  assign first_purchase_eligible = false
  if customer == blank
    assign first_purchase_eligible = true
  elsif customer.orders_count == 0
    assign first_purchase_eligible = true
  endif
  # When the Warm Wallet is active, it takes priority — wallet and first-purchase
  # are mutually exclusive by design (wallet only exists AFTER your first order).
  if wallet_active
    assign first_purchase_eligible = false
  endif
-%}

