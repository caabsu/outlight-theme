  const modalVariantsBox = document.getElementById('modal-variants');
  const modalVariantRail = document.getElementById('modal-variant-rail');
  const modalVariantName = document.getElementById('modal-variant-name');

  /* Highlights icon map — mirrors product-main.liquid line 340+ icon mapping.
     Label contains any of the keywords → emit that Material Symbol. */
  const HL_ICONS = [
    [['2700k','kelvin'], 'wb_twilight'],
    [['walnut','wood','bamboo','oak','ash','maple'], 'nature'],
    [['glass','opal','crystal'], 'blur_on'],
    [['marble','stone','travertine','alabaster'], 'diamond'],
    [['linen','fabric','shade','cotton'], 'texture'],
    [['dimm'], 'light_mode'],
    [['touch'], 'touch_app'],
    [['cordless','rechargeable','portable','battery'], 'battery_charging_full'],
    [['brass','gold','chrome','gunmetal','iron','metal'], 'hexagon'],
    [['e26','e27','g9','bulb','led'], 'lightbulb'],
    [['plug','cord'], 'power']
  ];
  function iconFor(label){
    const l = (label || '').toLowerCase();
    for (const [keys, icon] of HL_ICONS){ if (keys.some(k => l.includes(k))) return icon; }
    return 'category';
  }

  /* Specs grouping mirrors product page: Dimensions / Materials / Construction.
     Keys in product JSON use friendly names; map them back to groups here. */
  const SPEC_GROUPS = [
    { label: 'Dimensions', keys: ['Height','Width','Shade','Weight'] },
    { label: 'Materials',  keys: ['Body','Shade material','Construction'] },
    { label: 'Light',      keys: ['Color temp','CRI','Bulb','Voltage','Certifications'] }
  ];

  /* Day/night pair detection — mirrors product-main.liquid alt conventions:
       "on-off-day-{color}" + "on-off-night-{color}"  (variant-scoped pair)
       "on-off-day"         + "on-off-night"          (single-SKU pair)
       "on-off-off"         + "on-off-on"             (legacy single-SKU pair)
     Finds ALL pairs — a product can have multiple (one per variant color).
     Returns [{ dayIdx, nightIdx }, ...] in Shopify image order of the day. */
  function detectOnOffPairs(p){
    const alts = (p.imageAlts || []).map(a => (a || '').toLowerCase());
    const pairs = [];
    const consumed = new Set();
    alts.forEach((a, i) => {
      if (consumed.has(i)) return;
      let color = null;
      if (a.startsWith('on-off-day-')) color = a.slice(11);
      else if (a === 'on-off-day' || a === 'on-off-off') color = '';
      else return;
      const nightAlts = color === ''
        ? ['on-off-night', 'on-off-on']
        : ['on-off-night-' + color];
      for (let j = 0; j < alts.length; j++){
        if (j === i || consumed.has(j)) continue;
        if (nightAlts.indexOf(alts[j]) === -1) continue;
        pairs.push({ dayIdx: i, nightIdx: j });
        consumed.add(i); consumed.add(j);
        break;
      }
    });
    return pairs;
  }

  /* ===== Modal gallery — ported wholesale from the product page pattern =====
     Each slot is a 100%-wide flex child of #modal-track; show(i) sets
     translateX(-i * 100%). Day/night pair = one "scene" slot containing
     layered <img> tags + an inline <input type="range"> slider. All other
     images are single-image slots. Slot 0 is always the hero (featured_image
     leads the images[] array from kit-product-json.liquid). */

  /* Find the day/night pair (if any) that belongs to a specific variant — the
     pair's day-image alt is "on-off-day-{color}" and option1 (lowercased) is
     the color key. For non-variant products with a bare "on-off-day"/"on-off-
     night" pair, that pair has no color suffix; match it via empty colorKey. */
  function pairForVariant(p, vid){
    const v = variantOf(p, vid);
    if (!v) return null;
    const colorKey = (v.colorKey || v.option1 || '').toLowerCase().trim();
    const alts = (p.imageAlts || []).map(a => (a || '').toLowerCase());
    const pairs = detectOnOffPairs(p);
    if (!pairs.length) return null;
    /* Find the pair where the day alt's color suffix matches this variant. */
    for (const pr of pairs){
      const dayAlt = alts[pr.dayIdx] || '';
      let suffix = '';
      if (dayAlt.startsWith('on-off-day-')) suffix = dayAlt.slice(11);
      else if (dayAlt === 'on-off-day' || dayAlt === 'on-off-off') suffix = '';
      if (suffix === colorKey) return pr;
    }
    /* If colorKey didn't match any suffix, fall back to first pair (single-SKU
       day/night without color suffix). */
    if (!colorKey && pairs[0]) return pairs[0];
    return null;
  }

  function renderModalGallery(p){
    const rawImgs = (p.images && p.images.length ? p.images : [p.img]);
    const rawThumbs = (p.thumbs && p.thumbs.length ? p.thumbs : rawImgs);
    const rawAlts = (p.imageAlts || []).map(a => (a || '').toLowerCase());
    const isVariantProduct = !!(p.variants && p.variants.length > 1);

    /* Detect day/night pairs (multi-pair safe — works for variant products). */
    const pairs = detectOnOffPairs(p);
    const dayToPair = new Map();   /* dayIdx → pair */
    const nightSet = new Set();    /* nightIdx — skipped */
    pairs.forEach(pr => {
      if (rawImgs[pr.dayIdx] && rawImgs[pr.nightIdx]){
        dayToPair.set(pr.dayIdx, pr);
        nightSet.add(pr.nightIdx);
      }
    });

    /* Mirrors product-main.liquid slot layout:
         Slot 0  — HERO (active variant's image for variant products, swaps on
                   swatch click). For non-variant products, the first non-pair
                   image OR the first detected pair becomes slot 0 naturally.
         Slot 1+ — SCENE slots for each detected day/night pair.
         Slot N+ — SHARED images (not the hero, not part of any pair, not
                   alt-tagged "hero-*").
       Thumbnails enable PDP-style navigation. */
    const slots = [];
    let heroIdx = -1; /* index into rawImgs that the hero pulls from (skipped from shared) */

    if (isVariantProduct){
      const v = variantOf(p, modalVariantId) || defaultVariantOf(p);
      const heroSrc = (v && v.img) || p.img || rawImgs[0] || '';
      const heroThumb = (v && v.thumb) || rawThumbs[0] || heroSrc;
      slots.push({ type: 'hero', src: heroSrc, thumb: heroThumb });
      /* If the active variant's hero matches one of the rawImgs, mark its index
         to skip from shared so we don't render the same image twice. */
      heroIdx = rawImgs.findIndex(u => u === heroSrc);
    } else {
      /* Non-variant: lead with the FIRST non-pair, non-night image as the hero. */
      for (let i = 0; i < rawImgs.length; i++){
        if (nightSet.has(i)) continue;
        if (dayToPair.has(i)) continue; /* pairs become scenes */
        if (rawImgs[i]){
          slots.push({ type: 'hero', src: rawImgs[i], thumb: rawThumbs[i] || rawImgs[i] });
          heroIdx = i;
          break;
        }
      }
      /* If no non-pair image exists (e.g. product is JUST a day/night pair),
         leave hero off — the scene below covers it. */
    }

    /* SCENE slots — one per pair, in image order. */
    pairs.forEach(pr => {
      if (rawImgs[pr.dayIdx] && rawImgs[pr.nightIdx]){
        slots.push({
          type: 'scene',
          day: rawImgs[pr.dayIdx],
          night: rawImgs[pr.nightIdx],
          thumb: rawThumbs[pr.dayIdx] || rawImgs[pr.dayIdx]
        });
      }
    });

    /* SHARED slots — anything left over (not hero, not in a pair, not "hero-*"). */
    rawImgs.forEach((src, i) => {
      if (!src) return;
      if (i === heroIdx) return;
      if (nightSet.has(i)) return;
      if (dayToPair.has(i)) return;
      const alt = rawAlts[i] || '';
      if (alt.indexOf('hero-') === 0) return; /* skip hero-* alts (PDP convention) */
      slots.push({ type: 'single', src, thumb: rawThumbs[i] || src });
    });

    modalSlot_i = 0;
    modalSlotMax = slots.length;
    const esc = (p.name || '').replace(/"/g,'&quot;');

    /* Loading priority — only the hero (slot 0) loads eagerly with high
       fetchpriority so it paints fast. The next slot (slot 1) lazy-loads with
       a hint that it's coming up. The rest defer until the user navigates. */
    const slideAttrs = (i) => {
      if (i === 0) return ' loading="eager" decoding="async" fetchpriority="high"';
      if (i === 1) return ' loading="lazy" decoding="async" fetchpriority="low"';
      return ' loading="lazy" decoding="async"';
    };

    /* Render slides. Scene slots have the day/night pair + inline slider
       baked in — no absolute overlay. The 'hero' slot type uses a special
       data-modal-hero-img attribute so swatch-chip clicks can find and swap
       just that image without re-rendering the entire gallery. */
    modalTrack.innerHTML = slots.map((s, i) => {
      const attrs = slideAttrs(i);
      if (s.type === 'scene'){
        return (
          `<div class="modal-slide modal-slide-scene" data-slot="${i}">`+
            `<img class="scene-night" src="${s.night}" alt="${esc} night"${attrs} onerror="this.style.display='none'">`+
            `<img class="scene-day" src="${s.day}" alt="${esc} day"${attrs} onerror="this.style.display='none'" style="opacity:0.5">`+
            `<div class="scene-slider-wrap" data-scene-wrap="${i}">`+
              `<button type="button" class="scene-ss-snap scene-ss-snap-day" data-scene-snap="0" aria-label="Day"><span class="material-symbols-outlined">light_mode</span></button>`+
              `<div class="scene-slider-track"><input type="range" min="0" max="100" value="50" step="0.1" class="scene-slider" data-scene-slider="${i}" aria-label="Day to Night"></div>`+
              `<button type="button" class="scene-ss-snap scene-ss-snap-night" data-scene-snap="100" aria-label="Night"><span class="material-symbols-outlined">bedtime</span></button>`+
            `</div>`+
          `</div>`
        );
      }
      const heroAttr = s.type === 'hero' ? ' data-modal-hero-img' : '';
      return `<div class="modal-slide" data-slot="${i}"><img${heroAttr} src="${s.src}" alt="${esc}"${attrs} onerror="this.style.display='none'"></div>`;
    }).join('');

    /* Thumbs always lazy + small (280px URLs). One thumb per slot — scene pair
       renders as a single thumb (the day image). */
    modalThumbs.innerHTML = slots.map((s, i) =>
      `<button type="button" class="thumb${i===0?' on':''}" data-thumb-index="${i}" aria-label="Image ${i+1}"><img src="${s.thumb}" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'"></button>`
    ).join('');

    modalThumbs.hidden = slots.length <= 1;
    modalPrev.hidden = slots.length <= 1;
    modalNext.hidden = slots.length <= 1;

    /* Snap track back to slot 0 without animating the fresh markup into view. */
    modalTrack.style.transition = 'none';
    modalTrack.style.transform = 'translateX(0%)';
    void modalTrack.offsetWidth; /* reflow */
    modalTrack.style.transition = '';
    /* Slot 0 is active on open → show the hero swatch overlay. */
    modalMainWrap.classList.add('is-hero-active');

    bindSceneSliders();
    slots.forEach((s, i) => { if (s.type === 'scene') setSceneSlider(i, 50); });
    scrollActiveThumbIntoView();
    /* Preload slot 1 so the first swipe right is instant. */
    if (modalSlotMax > 1) preloadSlot(1);
  }

  /* Set the day-layer opacity for a scene slot. 0 = full Day, 100 = full Night.
     Night layer is always opacity 1 under the day layer, so nothing flickers
     through during the crossfade. Matches product page setSceneSlider exactly. */
  function setSceneSlider(slotIdx, value){
    const v = Math.max(0, Math.min(100, parseFloat(value) || 0));
    const slide = modalTrack.querySelector(`.modal-slide-scene[data-slot="${slotIdx}"]`);
    if (!slide) return;
    const dayImg = slide.querySelector('.scene-day');
    if (dayImg) dayImg.style.opacity = ((100 - v) / 100).toFixed(3);
    const slider = slide.querySelector('.scene-slider');
    if (slider){
      if (parseFloat(slider.value) !== v) slider.value = v;
      slider.setAttribute('aria-valuenow', String(Math.round(v)));
      slider.style.setProperty('--scene-fill', v.toFixed(2) + '%');
    }
    const wrap = slide.querySelector('.scene-slider-wrap');
    if (wrap){
      wrap.classList.toggle('is-day', v < 40);
      wrap.classList.toggle('is-night', v > 60);
    }
  }

  /* Snap-button animation (sun → 0, moon → 100). Ease-out-quart, 420ms. */
  function animateSceneSlider(slotIdx, targetV, duration){
    const slider = modalTrack.querySelector(`[data-scene-slider="${slotIdx}"]`);
    if (!slider) return;
    const startV = parseFloat(slider.value) || 0;
    const target = Math.max(0, Math.min(100, targetV));
    if (startV === target){ setSceneSlider(slotIdx, target); return; }
    const t0 = performance.now();
    (function frame(now){
      const p = Math.min(1, (now - t0) / duration);
      const eased = 1 - Math.pow(1 - p, 4);
      setSceneSlider(slotIdx, startV + (target - startV) * eased);
      if (p < 1) requestAnimationFrame(frame);
    })(performance.now());
  }

  /* Bind pointer/input/snap handlers to the freshly-rendered slider DOM.
     Custom pointerdown handler claims the gesture anywhere on the slider
     (not just the 3px thumb) — fixes iOS Safari "tap didn't grab" behavior.
     stopPropagation keeps slider drags from triggering the outer gallery
     swipe handler. */
  function bindSceneSliders(){
    modalTrack.querySelectorAll('.scene-slider').forEach(slider => {
      const idx = parseInt(slider.dataset.sceneSlider, 10);
      setSceneSlider(idx, slider.value);
      slider.addEventListener('input', () => setSceneSlider(idx, slider.value));

      let dragging = false;
      function valueFromClientX(clientX){
        const rect = slider.getBoundingClientRect();
        if (rect.width <= 0) return parseFloat(slider.value) || 0;
        let pct = (clientX - rect.left) / rect.width;
        pct = Math.max(0, Math.min(1, pct));
        return pct * 100;
      }
      slider.addEventListener('pointerdown', e => {
        dragging = true;
        try { slider.setPointerCapture(e.pointerId); } catch(_){}
        const v = valueFromClientX(e.clientX);
        slider.value = v;
        setSceneSlider(idx, v);
        e.stopPropagation();
        e.preventDefault();
      });
      slider.addEventListener('pointermove', e => {
        if (!dragging) return;
        const v = valueFromClientX(e.clientX);
        slider.value = v;
        setSceneSlider(idx, v);
      });
      function release(e){
        if (!dragging) return;
        dragging = false;
        try { slider.releasePointerCapture(e.pointerId); } catch(_){}
      }
      slider.addEventListener('pointerup', release);
      slider.addEventListener('pointercancel', release);
      slider.addEventListener('lostpointercapture', release);

      ['touchstart','touchmove','touchend','mousedown'].forEach(evt => {
        slider.addEventListener(evt, e => e.stopPropagation(), { passive: true });
      });
    });

    modalTrack.querySelectorAll('.scene-ss-snap').forEach(btn => {
      const wrap = btn.closest('.scene-slider-wrap');
      if (!wrap) return;
      const idx = parseInt(wrap.dataset.sceneWrap, 10);
      const target = parseInt(btn.dataset.sceneSnap, 10) || 0;
      btn.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); animateSceneSlider(idx, target, 420); });
      ['touchstart','pointerdown','mousedown'].forEach(evt => {
        btn.addEventListener(evt, e => e.stopPropagation(), { passive: true });
      });
    });
  }

  /* Keep the active thumb centered in the strip — matches product page's
     scrollActiveThumbIntoView. */
  function scrollActiveThumbIntoView(){
    if (!modalThumbs) return;
    const active = modalThumbs.querySelector('.thumb.on');
    if (!active) return;
    const stripRect = modalThumbs.getBoundingClientRect();
    const itemRect = active.getBoundingClientRect();
    const delta = (itemRect.left - stripRect.left) - (stripRect.width / 2) + (itemRect.width / 2);
    const target = Math.max(0, Math.min(modalThumbs.scrollLeft + delta, modalThumbs.scrollWidth - modalThumbs.clientWidth));
    if (Math.abs(target - modalThumbs.scrollLeft) < 2) return;
    try { modalThumbs.scrollTo({ left: target, behavior: 'smooth' }); }
    catch(_) { modalThumbs.scrollLeft = target; }
  }

  function showModalSlide(i){
    if (modalSlotMax <= 1) return;
    modalSlot_i = ((i % modalSlotMax) + modalSlotMax) % modalSlotMax;
    modalTrack.style.transform = `translateX(-${modalSlot_i * 100}%)`;
    modalThumbs.querySelectorAll('.thumb').forEach((el, idx) => el.classList.toggle('on', idx === modalSlot_i));
    /* Toggle .is-hero-active so the .modal-hsw overlay only paints over slot 0. */
    modalMainWrap.classList.toggle('is-hero-active', modalSlot_i === 0);
    scrollActiveThumbIntoView();
    /* Anticipate the next swipe — kick off fetch for ±1 neighbors so they're
       cached by the time the user navigates. Browser dedupes by URL. */
    preloadSlot(modalSlot_i + 1);
    preloadSlot(modalSlot_i - 1);
  }

  function preloadSlot(idx){
    if (idx < 0 || idx >= modalSlotMax) return;
    const slide = modalTrack.querySelector(`[data-slot="${idx}"]`);
    if (!slide) return;
    slide.querySelectorAll('img').forEach(img => {
      if (!img.src || img.complete) return;
      const pre = new Image();
      pre.src = img.src;
    });
  }

  function renderModalHighlights(p){
    const hl = p.highlights || [];
    if (!hl.length){ modalHighlights.innerHTML = ''; return; }
    modalHighlights.innerHTML = hl.slice(0,4).map(item =>
      `<div class="hl"><span class="material-symbols-outlined ic">${iconFor(item)}</span><span class="lb">${item}</span></div>`
    ).join('');
  }

  function renderModalSpecs(p){
    const specs = p.specs || {};
    const html = SPEC_GROUPS.map(group => {
      const rows = group.keys.filter(k => specs[k] != null && specs[k] !== '');
      if (!rows.length) return '';
      return `<div class="spec-group"><span class="spec-group-label">${group.label}</span>` +
        rows.map(k => `<div class="spec-row"><span class="l">${k}</span><span class="v">${specs[k]}</span></div>`).join('') +
      `</div>`;
    }).join('');
    modalSpecs.innerHTML = html;
  }

  /* ===== QUICK VARIANT PICKER =====================================
     Type-only mini card opened from the browse grid when a variant
     product is clicked. Name + type · price + 2-col grid of swatch
     pills + "View details" escape hatch. No image. */
  const qp = document.getElementById('kit-qp');
  const qpTitle = document.getElementById('kit-qp-title');
  const qpRail = document.getElementById('kit-qp-rail');
  const qpType = document.getElementById('kit-qp-type');
  const qpPrice = document.getElementById('kit-qp-price');
  const qpDetailsBtn = document.getElementById('kit-qp-details');
  let qpProductId = null;

  /* Map slot ('floor' | 'table') → human-readable type label. */
  const QP_TYPE_LABELS = { floor: 'Floor Lamp', table: 'Table Lamp' };

  function escHtml(s){
    return String(s == null ? '' : s).replace(/[<>&"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function openQuickPicker(id){
    const p = get(id); if (!p || !p.variants || p.variants.length <= 1) return;
    qpProductId = id;
    if (qpTitle) qpTitle.textContent = p.name || 'Product';
    if (qpType)  qpType.textContent  = QP_TYPE_LABELS[p.slot] || (p.slot || 'Lamp');
    if (qpPrice) qpPrice.textContent = p.priceMoney || ('$' + (p.price || 0));
    if (qpRail){
      qpRail.innerHTML = p.variants.map(v => {
        const hex = hexFor(v.colorKey || v.option1);
        const disabled = v.available === false ? 'disabled aria-disabled="true"' : '';
        return `<button type="button" class="kit-qp__chip" role="radio"
                  data-variant-id="${v.id}"
                  aria-label="${escHtml(v.title)}" title="${escHtml(v.title)}"
                  ${disabled}>
                  <span class="kit-qp__chip-disc" style="background:${hex}"></span>
                  <span class="kit-qp__chip-name">${escHtml(v.title)}</span>
                </button>`;
      }).join('');
    }
    qp.hidden = false;
    requestAnimationFrame(() => qp.classList.add('open'));
    document.body.style.overflow = 'hidden';
  }
  function closeQuickPicker(){
    qp.classList.remove('open');
    document.body.style.overflow = '';
    setTimeout(() => { qp.hidden = true; qpProductId = null; }, 200);
  }
  /* Backdrop / × button close */
  if (qp){
    qp.querySelectorAll('[data-qp-close]').forEach(el => el.addEventListener('click', closeQuickPicker));
  }
  /* Chip click → add that variant to the kit and close. If at MAX_LAMPS, the
     toggleProductInKit call no-ops (existing guard) and we just close. */
  if (qpRail){
    qpRail.addEventListener('click', e => {
      const chip = e.target.closest('.kit-qp__chip');
      if (!chip || chip.disabled || !qpProductId) return;
      const vid = chip.dataset.variantId;
      const slot = makeSlot(qpProductId, vid);
      if (!slot) { closeQuickPicker(); return; }
      if (state.selected.length >= MAX_LAMPS) { closeQuickPicker(); return; }
      state.selected.push(slot);
      renderAll();
      closeQuickPicker();
    });
  }
  /* "Or, open details" → swap to the full modal for the same product. */
  if (qpDetailsBtn){
    qpDetailsBtn.addEventListener('click', () => {
      const id = qpProductId;
      closeQuickPicker();
      if (id) openDetails(id);
    });
  }
  /* Esc closes */
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && qp && !qp.hidden) closeQuickPicker();
  });

  /* Open the modal for a product. Optional opts:
       editSlotIndex — bind the modal to an existing kit slot so changing the
                       variant edits that slot in place (instead of toggling). */
  function openDetails(id, opts){
    const p = get(id); if(!p) return;
    modalProductId = id;
    modalEditSlotIndex = (opts && Number.isInteger(opts.editSlotIndex)) ? opts.editSlotIndex : -1;
    /* Pre-select variant: edit-slot mode → use slot's variant. New-add mode →
       check if any kit slot already has this product (use its variant) else
       fall back to product default. */
    let preselectVid = null;
    if (modalEditSlotIndex >= 0){
      const slot = state.selected[modalEditSlotIndex];
      if (slot) preselectVid = slot.variantId;
    } else {
      const existing = state.selected.find(s => s.id === id);
      if (existing) preselectVid = existing.variantId;
    }
    if (!preselectVid){
      const def = defaultVariantOf(p);
      preselectVid = def ? def.id : (p.variantId || null);
    }
    modalVariantId = preselectVid;
    modalKicker.textContent = `Warm Lamp · ${SLOT_LABELS[p.slot] || p.slot}`;
    modalName.textContent = p.name;
    renderModalHsw(p);
    renderModalPrice(p);
    modalDesc.textContent = p.shortDescription || p.desc || '';
    renderModalGallery(p);
    renderModalHighlights(p);
    renderModalSpecs(p);
    updateModalAddButton();
    modal.classList.add('open');
    modal.setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
  }
  function closeDetails(){
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden','true');
    document.body.style.overflow = '';
    modalProductId = null;
    modalEditSlotIndex = -1;
    modalVariantId = null;
  }

  /* Render BOTH variant pickers (hero overlay + right-column picker). Both
     use the same data-variant-id contract, so the delegated click handler
     applies to either. */
  function renderModalHsw(p){
    const isVariant = !!(p.variants && p.variants.length > 1);
    /* Hide both pickers for non-variant products. */
    if (!isVariant){
      if (modalHswBox) { modalHswBox.hidden = true; if (modalHswRail) modalHswRail.innerHTML = ''; if (modalHswName) modalHswName.textContent = ''; }
      if (modalVariantsBox) { modalVariantsBox.hidden = true; if (modalVariantRail) modalVariantRail.innerHTML = ''; if (modalVariantName) modalVariantName.textContent = ''; }
      return;
    }
    /* Build the chip rail HTML once — same markup string can be reused in both
       containers because the click handler is delegated by data-variant-id. */
    const heroChips = p.variants.map(v => {
      const hex = hexFor(v.colorKey || v.option1);
      const active = String(v.id) === String(modalVariantId);
      const disabled = v.available === false ? 'disabled aria-disabled="true"' : '';
      return `<button type="button" class="modal-hsw__chip${active?' is-on':''}"
                data-variant-id="${v.id}"
                aria-label="${(v.title||'').replace(/"/g,'&quot;')}" title="${(v.title||'').replace(/"/g,'&quot;')}"
                style="background:${hex}" ${disabled}></button>`;
    }).join('');
    const bodyChips = p.variants.map(v => {
      const hex = hexFor(v.colorKey || v.option1);
      const active = String(v.id) === String(modalVariantId);
      const disabled = v.available === false ? 'disabled aria-disabled="true"' : '';
      return `<button type="button" class="modal-variants__chip${active?' is-on':''}"
                data-variant-id="${v.id}"
                aria-label="${(v.title||'').replace(/"/g,'&quot;')}" title="${(v.title||'').replace(/"/g,'&quot;')}"
                style="background:${hex}" ${disabled}></button>`;
    }).join('');
    const activeV = variantOf(p, modalVariantId) || defaultVariantOf(p);
    const activeTitle = activeV ? activeV.title : '';
    if (modalHswBox) modalHswBox.hidden = false;
    if (modalHswRail) modalHswRail.innerHTML = heroChips;
    if (modalHswName) modalHswName.textContent = activeTitle;
    if (modalVariantsBox) modalVariantsBox.hidden = false;
    if (modalVariantRail) modalVariantRail.innerHTML = bodyChips;
    if (modalVariantName) modalVariantName.textContent = activeTitle;
  }

  /* Render the price — uses variant price if available. */
  function renderModalPrice(p){
    const v = variantOf(p, modalVariantId);
    const txt = (v && v.priceMoney) ? v.priceMoney : (p.priceMoney || `$${p.price}`);
    modalPrice.textContent = txt;
  }

  /* Click a variant chip (in either picker) → switch active variant. Swaps
     ONLY the hero slot's image + thumb (matches PDP behavior — scene/shared
     slots stay put). Updates both pickers' active chip + label, price, and
     the Add-to-Kit CTA text. */
  function setActiveModalVariant(vid){
    const p = get(modalProductId); if (!p) return;
    const v = variantOf(p, vid); if (!v) return;
    modalVariantId = vid;
    /* Highlight active chip + label in BOTH pickers. */
    [modalHswRail, modalVariantRail].forEach(rail => {
      if (!rail) return;
      rail.querySelectorAll('[data-variant-id]').forEach(c => {
        c.classList.toggle('is-on', String(c.dataset.variantId) === String(vid));
      });
    });
    if (modalHswName) modalHswName.textContent = v.title;
    if (modalVariantName) modalVariantName.textContent = v.title;
    if (modalPrice) modalPrice.textContent = v.priceMoney || `$${v.price}`;
    /* Swap just the hero slot's image (data-modal-hero-img) + the first thumb. */
    const heroImg = modalTrack.querySelector('img[data-modal-hero-img]');
    if (heroImg && v.img) heroImg.src = v.img;
    const firstThumbImg = modalThumbs.querySelector('.thumb[data-thumb-index="0"] img');
    if (firstThumbImg && (v.thumb || v.img)) firstThumbImg.src = v.thumb || v.img;
    /* In edit mode, immediately apply to the slot so the kit reflects choice. */
    if (modalEditSlotIndex >= 0){
      setSlotVariant(modalEditSlotIndex, vid);
    }
    updateModalAddButton();
  }

  /* Delegated chip click handlers — fire on either picker. */
  function bindVariantClicks(rail){
    if (!rail) return;
    rail.addEventListener('click', e => {
      const chip = e.target.closest('[data-variant-id]');
      if (!chip || chip.disabled) return;
      setActiveModalVariant(chip.dataset.variantId);
    });
  }
  bindVariantClicks(modalHswRail);
  bindVariantClicks(modalVariantRail);

  function updateModalAddButton(){
    if(!modalProductId) return;
    const p = get(modalProductId);
    if (modalEditSlotIndex >= 0){
      /* Edit mode: button always reads "Done" — variant changes apply live. */
      modalAdd.classList.remove('in-kit');
      modalAdd.textContent = 'Done';
      return;
    }
    /* Add mode: check if THIS exact (productId, variantId) is already in kit. */
    const matchIdx = state.selected.findIndex(s =>
      s.id === modalProductId &&
      String(s.variantId) === String(modalVariantId)
    );
    const inKit = matchIdx >= 0;
    /* For variant products, append the active variant title so the user can
       see exactly what's about to be added before clicking. */
    const v = variantOf(p, modalVariantId);
    const suffix = (p && p.variants && p.variants.length > 1 && v && v.title)
      ? ` · ${v.title}`
      : '';
    modalAdd.classList.toggle('in-kit', inKit);
    modalAdd.textContent = (inKit ? 'Remove from kit' : 'Add to kit') + suffix;
  }

  modal.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', closeDetails));
  document.addEventListener('keydown', e => {
    if (!modal.classList.contains('open')) return;
    if (e.key === 'Escape') closeDetails();
    else if (e.key === 'ArrowLeft') showModalSlide(modalSlot_i - 1);
    else if (e.key === 'ArrowRight') showModalSlide(modalSlot_i + 1);
  });
  modalAdd.addEventListener('click', () => {
    if(!modalProductId) return;
    if (modalEditSlotIndex >= 0){
      /* Edit mode: variant already applied via setSlotVariant; just close. */
      closeDetails();
      return;
    }
    /* Add mode: toggle this exact (product, variant) combination. Modal closes
       after the action so the user lands back in the picker, not stuck on the
       same screen they just acted on. */
    const matchIdx = state.selected.findIndex(s =>
      s.id === modalProductId &&
      String(s.variantId) === String(modalVariantId)
    );
    if (matchIdx >= 0){
      state.selected.splice(matchIdx, 1);
      renderAll();
      closeDetails();
    } else {
      if (state.selected.length >= MAX_LAMPS) return;
      const slot = makeSlot(modalProductId, modalVariantId);
      if (slot){
        state.selected.push(slot);
        renderAll();
        closeDetails();
      }
    }
  });

  /* Gallery navigation — prev/next buttons + thumbnail clicks + touch swipe.
     Swipe threshold 60px + axis lock matches product page's attachSwipe(). */
  modalPrev.addEventListener('click', () => showModalSlide(modalSlot_i - 1));
  modalNext.addEventListener('click', () => showModalSlide(modalSlot_i + 1));
  modalThumbs.addEventListener('click', e => {
    const btn = e.target.closest('[data-thumb-index]');
    if (btn) showModalSlide(parseInt(btn.dataset.thumbIndex, 10));
  });

  (function attachModalSwipe(){
    let startX = 0, startY = 0, dx = 0, dragging = false, axis = null;
    modalMainWrap.addEventListener('touchstart', e => {
      if (modalSlotMax <= 1) return;
      /* Don't hijack touches that start inside the day/night slider or on the
         nav buttons — the slider's own pointer handlers take those gestures. */
      if (e.target.closest('.scene-slider-wrap, .modal-nav')) return;
      startX = e.touches[0].clientX; startY = e.touches[0].clientY;
      dragging = true; dx = 0; axis = null;
      modalTrack.style.transition = 'none';
    }, { passive: true });
    modalMainWrap.addEventListener('touchmove', e => {
      if (!dragging) return;
      const ddx = e.touches[0].clientX - startX;
      const ddy = e.touches[0].clientY - startY;
      if (axis === null && (Math.abs(ddx) > 8 || Math.abs(ddy) > 8)){
        axis = Math.abs(ddx) > Math.abs(ddy) ? 'x' : 'y';
      }
      if (axis === 'x'){
        dx = ddx;
        const basePct = -(modalSlot_i * 100);
        const dragPct = (ddx / modalMainWrap.offsetWidth) * 100;
        modalTrack.style.transform = `translateX(${basePct + dragPct}%)`;
      }
    }, { passive: true });
    modalMainWrap.addEventListener('touchend', () => {
      if (!dragging) return;
      dragging = false;
      modalTrack.style.transition = 'transform 420ms cubic-bezier(0.22,0.61,0.36,1)';
      if (axis === 'x' && Math.abs(dx) > 60){
        showModalSlide(modalSlot_i + (dx < 0 ? 1 : -1));
      } else {
        showModalSlide(modalSlot_i);
      }
      dx = 0; axis = null;
    }, { passive: true });
  })();

  /* ============ Hero lighting crossfade — opacity blend via slider ============ */
  (function setupCompare(){
    const warm = document.getElementById('compare-warm');
    const track = document.getElementById('compare-track');
    const knob = document.getElementById('compare-knob');
    if(!warm || !track || !knob) return;

    let dragging = false;
    let currentPct = 100;
    function clamp(v){ return Math.max(0, Math.min(100, v)); }
    function setPos(pct, fromInit){
      const p = clamp(pct);
      currentPct = p;
      warm.style.opacity = (p / 100).toString();
      knob.style.left = p + '%';
      knob.setAttribute('aria-valuenow', Math.round(p).toString());
    }
    function pctFromClientX(clientX){
      const r = track.getBoundingClientRect();
      return ((clientX - r.left) / r.width) * 100;
    }
    function onDown(e){
      dragging = true;
      knob.classList.add('dragging');
      try { track.setPointerCapture(e.pointerId); } catch(_) {}
      setPos(pctFromClientX(e.clientX));
      e.preventDefault();
    }
    function onMove(e){
      if(!dragging) return;
      setPos(pctFromClientX(e.clientX));
    }
    function onUp(e){
      dragging = false;
      knob.classList.remove('dragging');
      try { track.releasePointerCapture(e.pointerId); } catch(_) {}
    }
    track.addEventListener('pointerdown', onDown);
    track.addEventListener('pointermove', onMove);
    track.addEventListener('pointerup', onUp);
    track.addEventListener('pointercancel', onUp);

    // Keyboard support on the knob for accessibility
    knob.addEventListener('keydown', e => {
      const step = e.shiftKey ? 10 : 5;
      if(e.key === 'ArrowLeft' || e.key === 'ArrowDown'){ setPos(currentPct - step); e.preventDefault(); }
      else if(e.key === 'ArrowRight' || e.key === 'ArrowUp'){ setPos(currentPct + step); e.preventDefault(); }
      else if(e.key === 'Home'){ setPos(0); e.preventDefault(); }
      else if(e.key === 'End'){ setPos(100); e.preventDefault(); }
    });

    // Init at 100% (fully warm by default)
    setPos(100, true);

    // Brief auto-demo: sweep cold → warm once on load so users understand the control
    setTimeout(() => {
      if(dragging) return;
      const start = performance.now();
      const duration = 1400;
      function step(now){
        const t = Math.min(1, (now - start) / duration);
        // ease: cold for 0.2s, transition to warm
        const eased = t < 0.15 ? 0 : (t - 0.15) / 0.85;
        const smooth = eased < 0.5 ? 2*eased*eased : 1 - Math.pow(-2*eased+2, 2)/2;
        setPos(smooth * 100);
        if(t < 1 && !dragging) requestAnimationFrame(step);
      }
      setPos(0);
      requestAnimationFrame(step);
    }, 900);
  })();

  /* Trust strip — duplicate items once for seamless marquee loop on mobile.
     Cloned items are tagged so desktop CSS can hide them. */
  (function cloneTrust(){
    const ul = document.querySelector('.kit-configurator .trust ul');
    if(!ul) return;
    const items = [...ul.children];
    items.forEach(item => {
      const clone = item.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      clone.classList.add('trust-clone');
      ul.appendChild(clone);
    });
  })();

  /* Deep-link from the home-page lamp grid (sections/catalog-rail.liquid).
     Cards there link to /pages/kit?lamp=<handle>; here we resolve that handle
     to a product, jump the catalog grid to the right pagination page, scroll
     the card into view, and call openDetails() — same path as clicking VIEW
     DETAILS. Prior to this, the param was ignored and users just landed on
     the kit page with no auto-open. */
  (function openFromLampParam(){
    let params;
    try { params = new URLSearchParams(window.location.search); } catch (e) { return; }
    const lampParam = params.get('lamp');
    if (!lampParam) return;
    const target = products.find(p => p.id === lampParam);
    if (!target) return;
    /* Reset filter + search so the target is reachable in the grid. */
    state.filter = 'all';
    state.query = '';
    const ordered = mixedAll();
    let idx = ordered.findIndex(p => p.id === target.id);
    if (idx < 0) idx = 0;
    state.page = Math.floor(idx / currentPageSize());
    renderGrid();
    /* Sync the visible filter chip state to match. */
    document.querySelectorAll('.browse .chip[data-filter]').forEach(c => {
      const isActive = c.dataset.filter === 'all';
      c.classList.toggle('active', isActive);
      if (c.hasAttribute('aria-pressed')) c.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
    /* Strip ?lamp from the URL so the deep-link doesn't re-fire on reload
       or back-nav (replaceState — no extra history entry). */
    if (window.history && window.history.replaceState) {
      const url = new URL(window.location.href);
      url.searchParams.delete('lamp');
      window.history.replaceState({}, '', url.pathname + (url.search || '') + url.hash);
    }
    /* Wait one frame for renderGrid() to paint, then scroll + open. */
    requestAnimationFrame(() => {
      const idAttr = (window.CSS && CSS.escape) ? CSS.escape(target.id) : target.id;
      const card = document.querySelector('.browse .card[data-id="' + idAttr + '"]');
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        /* Small delay so the user sees the scroll land before the modal opens. */
        setTimeout(() => openDetails(target.id), 650);
      } else {
        openDetails(target.id);
      }
    });
  })();
})();
</script>

