  }

  /* Unlocked summary — headline + progress bar + tier card statuses.
     Called from renderAll(); mirrors tier logic but in a prominent recap
     section above the second CTA. */
  const US_TIER1_VALUE = 38;
  const US_TIER2_VALUE = 211;
  const US_MAX_VALUE = US_TIER1_VALUE + US_TIER2_VALUE;
  function renderUnlockedSummary(){
    const headline = document.getElementById('us-headline');
    const valEl = document.getElementById('us-value');
    const barFill = document.getElementById('us-bar-fill');
