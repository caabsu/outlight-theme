    const t2 = document.getElementById('us-t2');
    if (!headline || !valEl || !barFill || !t1 || !t2) return;
    const t = tier();
    let earned = 0;
    if (t >= 1) earned += US_TIER1_VALUE;
    if (t >= 2) earned += US_TIER2_VALUE;
    valEl.textContent = `$${earned}`;
    barFill.style.width = `${Math.round((earned / US_MAX_VALUE) * 100)}%`;
    t1.classList.toggle('on', t >= 1);
    t2.classList.toggle('on', t >= 2);
    if (t === 0){
      headline.innerHTML = `Pick 2 lamps to start earning <em>free extras</em>`;
    } else if (t === 1){
      headline.innerHTML = `Tier 01 unlocked — <em>add a floor lamp</em> to earn the full $259`;
    } else {
      headline.innerHTML = `All tiers unlocked — <em>$259 in free extras earned</em>`;
    }
  }

  /* Silent re-render: preserve scrollY so tier unlock / lamp add / dock toggle never
     yanks the viewport. Applied across the full render batch because multiple
     layouts can change (announce slide-down, unlocked-summary height, dock toggle). */
  function renderAll(){
    const sy = window.scrollY;
    renderSlots();
    renderIncluded();
    renderUnlockedSummary();
    renderDock();
    renderGrid();
    updateDock();
    document.querySelectorAll('.browse .chip[data-filter]').forEach(c => {
      if(c.dataset.filter === state.filter) c.classList.add('on'); else c.classList.remove('on');
    });
    /* Sync to localStorage so the global persistent kit-dock snippet (loaded in
       layout/theme.liquid on every page) can render the same kit anywhere. */
    syncKitToStorage();
    /* Double rAF so we catch the layout AFTER both sync + async (CSS transition)
       mutations settle. Users perceive this as the page staying anchored. */
    requestAnimationFrame(() => {
      if (Math.abs(window.scrollY - sy) > 1) window.scrollTo(0, sy);
      requestAnimationFrame(() => {
        if (Math.abs(window.scrollY - sy) > 1) window.scrollTo(0, sy);
      });
    });
  }

  /* Persist current kit state to localStorage. Read by snippets/kit-dock.liquid
     to render the dock + popover on every page across the site. Also dispatched
     as 'wbd:kit-updated' so the dock re-renders without polling. */
  function syncKitToStorage(){
    try {
      var payload = {
        selected: state.selected.map(function(s){
          var p = get(s.id) || {};
          var variant = (p.variants || []).find(function(v){ return v.id == s.variantId; });
          var price = variant ? (variant.price || p.price) : p.price;
          var img = (typeof slotImage === 'function') ? slotImage(s) : (p.img || '');
          return {
            id: s.id,
            variantId: s.variantId,
            productId: p.productId || null,
            name: p.name || '',
            price: price || 0,
            img: img,
            slot: p.slot || null,
            vt: variant ? (variant.title || '') : ''
          };
        }),
        updatedAt: Date.now(),
        pageContext: {
          walletActive: !!WARM_WALLET_ACTIVE,
          walletCode: WARM_WALLET_CODE,
          firstPurchaseEligible: !!FIRST_PURCHASE_ELIGIBLE,
          firstPurchaseCode: FIRST_PURCHASE_CODE
        }
      };
      localStorage.setItem('wbd_kit_state', JSON.stringify(payload));
      document.dispatchEvent(new CustomEvent('wbd:kit-updated'));
      if (window.__WBD_KIT_DEBUG) console.log('[wbd-kit] syncKitToStorage wrote', payload.selected.length, 'lamps');
    } catch(e){
      console.error('[wbd-kit] syncKitToStorage FAILED:', e);
    }
  }
  /* Debug exposures — see kit-configurator-v2 for usage notes. Also lets the
     global kit-dock snippet read in-memory state as a fallback if localStorage
     isn't being written for any reason. */
  window.__kitState = function(){ return state.selected.slice(); };
  window.__kitProducts = products;
  window.__kitForceSync = function(){ syncKitToStorage(); return localStorage.getItem('wbd_kit_state'); };

  /* Expose a remove hook so the global kit-dock popover X buttons can mutate
     the section's real state instead of just editing localStorage (keeps the
     in-page UI in lockstep). */
  window.__kitRemove = function(id){
    var idx = state.selected.findIndex(function(s){ return s.id === id; });
    if (idx < 0) return false;
    state.selected.splice(idx, 1);
    state.lastTier = null;
    renderAll();
    return true;
  };

  /* Restore kit state from localStorage BEFORE first renderAll, otherwise the
     initial empty state.selected = [] would overwrite a kit the user built on
     a previous visit (renderAll → syncKitToStorage writes the empty state). */
  (function restoreKitFromStorage(){
    try {
      var raw = localStorage.getItem('wbd_kit_state');
      if (!raw) return;
      var s = JSON.parse(raw);
      if (!s || !Array.isArray(s.selected) || s.selected.length === 0) return;
      var restored = [];
      s.selected.forEach(function(item){
        if (!item || !item.id) return;
        var slot = makeSlot(item.id, item.variantId);
        if (slot) restored.push(slot);
      });
      if (restored.length > 0) state.selected = restored;
    } catch(e){}
  })();

  renderAll();

  /* If user lands on /pages/kit?action=complete (e.g. clicked "Complete kit"
     from the persistent dock on a non-kit page), auto-trigger submitKit so they
