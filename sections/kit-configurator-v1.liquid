  /* ============================================================
     CHECKOUT — AJAX cart submission + direct-to-checkout redirect
     ============================================================

     Flow:
       1. Build items array: all selected lamp variants + all unlocked
          tier-freebie variants (lookup via [data-starter-id]).
          Freebies are posted at their REAL price — the kit-gift Shopify
          Function applies a 100%-off product discount server-side when
          qualifying lamps are present. This is the fraud-resistant path:
          if someone manipulates the DOM to send freebies without lamps,
          the Function (and the Cart Validation Function) blocks them.
       2. POST /cart/add.js (AJAX) — Shopify adds everything to the cart.
       3. Build checkout URL. If customer has an active Warm Wallet code
          (from customer.metafields.custom.warm_wallet), append it as
          ?discount= so Shopify auto-applies it on checkout load.
       4. window.location.href → /checkout. Cart page is bypassed entirely.
     ============================================================ */
  const kitForm = document.getElementById('kit-cart-form');
  const WARM_WALLET_CODE = {{ wallet_code | json }};
  const WARM_WALLET_ACTIVE = {{ wallet_active | json }};
  const FIRST_PURCHASE_CODE = {{ section.settings.first_purchase_code | default: 'FIRSTROOM10' | json }};
  const FIRST_PURCHASE_ELIGIBLE = {{ first_purchase_eligible | json }};
  let isSubmitting = false;

  function buildItemsPayload(){
    const items = [];
    /* Lamp variants — use the per-slot variantId chosen by the user (defaults to
       the product's first available variant if user never opened the picker). */
    state.selected.forEach(slot => {
      const p = get(slot.id); if (!p) return;
      const vid = slot.variantId || p.variantId;
      if (!vid) return;
      items.push({
        id: vid,
        quantity: 1,
        properties: { _kit: 'lamp' }
      });
    });
    // Tier-unlocked freebie variants — include ONLY at the correct tier.
    // The Shopify Function on the server side will zero out the price.
    const t = tier();
    document.querySelectorAll('.tier-group.unlocked [data-starter-id]').forEach(el => {
      const vid = el.getAttribute('data-starter-id');
      if (!vid) return;
      const isTier2 = !!el.closest('#tier2-group');
      const isTier1 = !!el.closest('#tier1-group');
      if ((isTier2 && t >= 2) || (isTier1 && t >= 1)) {
        items.push({
          id: vid,
          quantity: 1,
          properties: { _kit: isTier2 ? 'gift-tier-2' : 'gift-tier-1' }
        });
      }
    });
    return items;
  }

  function buildCheckoutUrl(){
    // Pick one discount code — Shopify's /checkout?discount= only honors one.
    // Wallet wins over first-purchase; the two are mutually exclusive by design
    // (wallet only exists after the first order).
    let code = null;
    if (WARM_WALLET_ACTIVE && WARM_WALLET_CODE) {
      code = WARM_WALLET_CODE;
    } else if (FIRST_PURCHASE_ELIGIBLE && FIRST_PURCHASE_CODE) {
      code = FIRST_PURCHASE_CODE;
    }
    return code ? `/checkout?discount=${encodeURIComponent(code)}` : '/checkout';
  }

  function setSubmitting(flag){
    isSubmitting = flag;
    [
      document.getElementById('kit-add-btn'),
      document.getElementById('dock-cta'),
      document.getElementById('second-cta-btn')
    ].forEach(btn => {
      if (!btn) return;
      btn.disabled = flag || btn.classList.contains('disabled');
      if (flag) btn.dataset._label = btn.textContent;
      btn.textContent = flag ? 'Processing…' : (btn.dataset._label || btn.textContent);
    });
  }

  async function submitKit(){
    if (isSubmitting) return;
    if (pieces() === 0) return;
    const hasVariants = products.some(p => p.variantId);
    if (!hasVariants) {
      console.warn('Kit Configurator: demo mode — connect Kit Collection in section settings to enable cart.');
      return;
    }
    const items = buildItemsPayload();
    if (items.length === 0) return;
    setSubmitting(true);
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items })
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        console.error('Kit Configurator: cart/add failed', res.status, err);
        throw new Error(err.description || err.message || 'Unable to add items to cart');
      }
      // Success — go directly to checkout, bypassing the cart page entirely.
      window.location.href = buildCheckoutUrl();
    } catch (err) {
      console.error(err);
      setSubmitting(false);
      alert('Sorry — we couldn’t start checkout. Please try again in a moment.');
    }
  }

