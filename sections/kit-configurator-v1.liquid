<script>
(function(){
  /* Scroll-direction aware nav hide — kit page only. */
  const siteNav = document.getElementById('mainNav');
  if (siteNav) {
    let lastY = window.scrollY;
    let ticking = false;
    const HIDE_THRESHOLD = 120;   // px scrolled before we start hiding
    const UP_DEADZONE = 4;        // px of upward jitter ignored
    const setHidden = (hidden) => {
      siteNav.classList.toggle('wd-nav--hidden', hidden);
      document.body.classList.toggle('site-nav-hidden', hidden);
    };
    const onScroll = () => {
      const y = window.scrollY;
      if (y < HIDE_THRESHOLD) {
        setHidden(false);
      } else if (y > lastY + 2) {
        // scrolling down
        setHidden(true);
      } else if (y < lastY - UP_DEADZONE) {
        // scrolling up
        setHidden(false);
      }
      lastY = y;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(onScroll); ticking = true; }
    }, { passive: true });
  }

  /* Sticky dock fit: write live --kit-nav-h (so the dock sits flush under the
     nav with no visible gap, regardless of breakpoint or font-loading reflow)
     and --kit-dock-h (so the mobile body reservation matches the dock's actual
     height including safe-area, never clipping page content). */
  const dockEl = document.getElementById('dock');
  const root = document.documentElement;
  const measure = () => {
    if (siteNav) {
      const h = Math.round(siteNav.getBoundingClientRect().height);
      if (h > 0) root.style.setProperty('--kit-nav-h', h + 'px');
    }
    if (dockEl) {
      const h = Math.round(dockEl.getBoundingClientRect().height);
      if (h > 0) root.style.setProperty('--kit-dock-h', h + 'px');
    }
  };
  measure();
  window.addEventListener('resize', measure, { passive: true });
  window.addEventListener('load', measure, { once: true });
  if ('ResizeObserver' in window) {
    const ro = new ResizeObserver(measure);
    if (siteNav) ro.observe(siteNav);
    if (dockEl) ro.observe(dockEl);
  }
})();

(function(){
