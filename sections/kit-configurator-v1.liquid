  let modalVariantId = null;
  let modalEditSlotIndex = -1;
  /* Two synced variant pickers:
       modal-hsw  — glass pill overlay on the modal hero (shown only when
                    slot 0 is active, hidden when gallery is on a scene/shared).
       modal-variants — right-column picker in modal-body, always visible.
