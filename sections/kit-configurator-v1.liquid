<!-- CONFIGURATOR — Section 05 · Build your kit (V1 ledger · 2026-04-25T01:05:00Z) -->
<!-- WBD_CACHE_TEST_MARKER_2026_04_25_REBUILD_V3 -->
<section class="configurator" data-build="wbd-2026-04-25-v3">
  <div class="wrap">
    {%- if wallet_active -%}
      <!-- Warm Wallet banner — visible only to logged-in customers with an active credit.
           Auto-applies at checkout via ?discount= URL param (see submitKit() in JS). -->
      <div class="warm-wallet-banner" role="status">
        <div class="ww-icon"><span class="material-symbols-outlined">account_balance_wallet</span></div>
        <div class="ww-body">
          <span class="ww-kicker">{{ section.settings.wallet_kicker | default: 'Warm Wallet' }}</span>
          <span class="ww-msg">
            <b>${{ wallet_balance }}</b> credit ready —
            {%- if wallet_expires != '' -%}
              auto-applies at checkout{%- comment -%} (expires {{ wallet_expires }}) {%- endcomment -%}
              <span class="ww-expires"> · expires {{ wallet_expires }}</span>
            {%- else -%}
              auto-applies at checkout
            {%- endif -%}
          </span>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}
      Pre-compute per-tier free-value totals from configured blocks.
      MUST run BEFORE the cfg-head badge + col-left Total line that
      consume `extras_total`. Liquid evaluates top-to-bottom; if this
      runs after the consumers, both render `$0` (FIX 2026-04-25).
    {%- endcomment -%}
    {%- assign t1_total = 0 -%}
    {%- assign t2_total = 0 -%}
    {%- for block in starter_blocks -%}
      {%- assign pr_str = block.settings.was_price | default: '$0' | remove: '$' | remove: ',' -%}
      {%- assign pr_num = pr_str | plus: 0 -%}
      {%- if block.settings.tier == '1' -%}{%- assign t1_total = t1_total | plus: pr_num -%}{%- endif -%}
      {%- if block.settings.tier == '2' -%}{%- assign t2_total = t2_total | plus: pr_num -%}{%- endif -%}
    {%- endfor -%}
    {%- if t1_total == 0 -%}{%- assign t1_total = 79 -%}{%- endif -%}
    {%- if t2_total == 0 -%}{%- assign t2_total = 180 -%}{%- endif -%}
    {%- assign extras_total = t1_total | plus: t2_total -%}

    <div class="cfg-head">
      <div class="cfg-head-text">
        <h2>{{ section.settings.cfg_heading | default: 'Build your kit' }}</h2>
      </div>
    </div>

<div class="main-split" id="main-split">
  <!-- LEFT: 01 What's included — explicit tier groups -->
  <div class="col col-left">
    <div class="col-head">
      <div class="ph"><span class="num">{{ section.settings.cfg_left_number | default: '01' }}</span><span class="t">{{ section.settings.cfg_left_title | default: "What's included" }}</span></div>
      <span class="meta meta-free"><span class="was">${{ extras_total }}</span><span class="now">Free</span></span>
      {%- comment -%} Hidden status targets — JS writes to these; tier-value + CTA sub render the visible state. {%- endcomment -%}
      <span class="sr-only" aria-hidden="true" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)"><span id="pc-num">0</span> · <span id="tier-label">No tier yet</span></span>
    </div>

    {%- comment -%}
      Starter kit tier items — wired to section.blocks (type: starter_product).
      Tier totals (t1_total, t2_total) were already computed at the top of
      the section above the cfg-head badge. Reused here for the tier-value
      headers (the "$79 Free" / "$180 Free" amber pills).
    {%- endcomment -%}

    {%- if starter_blocks.size > 0 -%}
      {%- comment -%}
        Note: we avoid `| where: 'settings.tier', '1'` — that filter doesn't reliably
        match nested block settings in Shopify Liquid. Instead, iterate and check
        `block.settings.tier` inline. Tier values are string '1' / '2' per the schema.
      {%- endcomment -%}

      <!-- Tier 1 group -->
      <div class="tier-group unlocked" id="tier1-group">
        <div class="tier-header">
          <div class="tier-label"><span class="k">Tier 1</span><span class="t">At 2+ lamps</span></div>
          <span class="tier-status" id="tier1-status">Unlocked</span>
          <div class="tier-value"><span class="was">${{ t1_total }}</span><span class="now">Free</span></div>
        </div>
        <div class="announce" role="status" aria-live="polite"><span class="ic">✓</span><div class="body"><span class="ti">Tier 01 unlocked</span><span class="su"><b>${{ t1_total }}</b> in free extras added to your kit</span></div><button class="x" type="button" aria-label="Dismiss" onclick="this.closest('.announce').classList.add('dismissed')">×</button></div>
        <div class="tier-items">
          {%- for block in starter_blocks -%}
            {%- if block.settings.tier != '1' -%}{%- continue -%}{%- endif -%}
            {%- comment -%}
              Shopify's `type: "product"` setting can return either a Product drop
              directly OR a handle string depending on theme/admin config. Handle
              both: if it's already a Product (has a .title), use it; otherwise
              look up via all_products[handle]. UNLISTED products may not resolve
              via all_products — variant_gid_override + product_url_override let us
              hardcode the variant + url for those.
            {%- endcomment -%}
            {%- assign raw_product = block.settings.product -%}
