     Hardcoded as an object literal (no Liquid render dependency) so a snippet
     issue can't silently break the kit configurator. */
  const SWATCH_HEX = {
    white: '#F0EDE8', black: '#1A1A1A', coffee: '#5A2E2E', brown: '#9A5F3F',
    blue: '#3A5C7C', orange: '#C1633A', cream: '#E8DFD0', walnut: '#6B4423',
    brass: '#A67C3A', rosso: '#5A2E2E', yellow: '#D9A824', red: '#8C2E2E',
    green: '#415A3E', gray: '#7A7A7A', grey: '#7A7A7A', silver: '#C0C0C0',
    gold: '#C9A85F'
  };
  function hexFor(colorKey){
    return SWATCH_HEX[(colorKey || '').toLowerCase().trim()] || '#F0EDE8';
  }

  /* ============================================================
     PRODUCTS — sourced from Shopify collections.
     Priority:
       1. section.settings.kit_collection (merchant-curated)
       2. collections['floor-lamps'] + collections['table-lamps'] combined
       3. Hardcoded mock data (demo mode — cart disabled)
     Each product exposes: id, variantId, slot, name, price (cents→dollar int),
