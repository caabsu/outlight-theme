<!-- TEST_MARKER_QWERTY_42 --><div class="kit-configurator{% if section.settings.mode == 'configurator-only' %} is-config-only{% endif %}">
<script>(function(){
  /* Set CSS custom properties on .kit-configurator wrapper from Liquid section
     settings. Inline <style> blocks and inline style="" attrs both got silently
     stripped by Shopify's section render — JS-set styles aren't sanitized so this
     is the reliable path. The asset CSS uses var(--name) refs that resolve once
     these are set. */
  var el = document.currentScript && document.currentScript.previousElementSibling;
  if (!el || !el.classList || !el.classList.contains('kit-configurator')) {
    el = document.querySelector('.kit-configurator');
  }
  if (!el) return;
  el.style.setProperty('--hero_height_vh', '{{ section.settings.hero_height_vh | default: 64 }}vh');
  el.style.setProperty('--hero_height_min', '{{ section.settings.hero_height_min | default: 560 }}px');
  el.style.setProperty('--hero_focus_desktop', '{{ section.settings.hero_focus_desktop | default: "center center" }}');
  el.style.setProperty('--hero_heading_size', '{{ section.settings.hero_heading_size | default: 80 }}px');
  el.style.setProperty('--hero_sub_size', '{{ section.settings.hero_sub_size | default: 16 }}px');
  el.style.setProperty('--bridge_heading_size', '{{ section.settings.bridge_heading_size | default: 44 }}px');
  el.style.setProperty('--bridge_sub_size', '{{ section.settings.bridge_sub_size | default: 15 }}px');
  el.style.setProperty('--bridge_image_aspect', '{{ section.settings.bridge_image_aspect | default: "16 / 9" }}');
  el.style.setProperty('--bridge_image_max_height', '{{ section.settings.bridge_image_max_height | default: 560 }}px');
  el.style.setProperty('--kelvin_heading_size', '{{ section.settings.kelvin_heading_size | default: 40 }}px');
  el.style.setProperty('--kelvin_sub_size', '{{ section.settings.kelvin_sub_size | default: 15 }}px');
  el.style.setProperty('--kelvin_image_aspect', '{{ section.settings.kelvin_image_aspect | default: "16 / 9" }}');
  el.style.setProperty('--kelvin_image_max_height', '{{ section.settings.kelvin_image_max_height | default: 620 }}px');
  el.style.setProperty('--cfg_heading_size', '{{ section.settings.cfg_heading_size | default: 44 }}px');
  el.style.setProperty('--why_heading_size', '{{ section.settings.why_heading_size | default: 38 }}px');
  el.style.setProperty('--why_panel_heading_size', '{{ section.settings.why_panel_heading_size | default: 28 }}px');
  el.style.setProperty('--reviews_heading_size', '{{ section.settings.reviews_heading_size | default: 34 }}px');
  el.style.setProperty('--faq_heading_size', '{{ section.settings.faq_heading_size | default: 32 }}px');
  el.style.setProperty('--cta_heading_size', '{{ section.settings.cta_heading_size | default: 44 }}px');
  el.style.setProperty('--hero_aspect_mobile', '{{ section.settings.hero_aspect_mobile | default: "4 / 3" }}');
  el.style.setProperty('--hero_mobile_min_height', '{{ section.settings.hero_mobile_min_height | default: 260 }}px');
  el.style.setProperty('--hero_mobile_max_vh', '{{ section.settings.hero_mobile_max_vh | default: 46 }}vh');
  el.style.setProperty('--hero_focus_mobile', '{{ section.settings.hero_focus_mobile | default: "center 45%" }}');
  el.style.setProperty('--hero_heading_size_mobile', '{{ section.settings.hero_heading_size_mobile | default: 42 }}px');
  el.style.setProperty('--hero_sub_size_mobile', '{{ section.settings.hero_sub_size_mobile | default: 14 }}px');
  el.style.setProperty('--why_panel_heading_size_minus_4', '{{ section.settings.why_panel_heading_size | default: 28 | minus: 4 }}px');
})();</script>


