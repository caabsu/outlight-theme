      desc:'A small warm orb that goes anywhere — dresser, shelf, windowsill. Magnetic USB-C base for quick placement. Reads with a single hour of charge.',
      specs:{Height:'6 in',Base:'3.5 in dia',Runtime:'8 hrs',Charging:'USB-C magnetic'}},
    {id:'loop',    productId:null, variantId:null, slot:'table',  name:'Loop',    price:169, priceMoney:'$169', code:'AC-02', img:'{{ "kit-loop.jpeg" | asset_url }}',
      desc:'Sculptural curved-tube accent in matte bronze. Throws a narrow warm wash upward. Doubles as quiet architectural presence even off.',
      specs:{Height:'10 in',Base:'4 in dia',Wattage:'4W · 2700K',Finish:'Matte bronze'}},
    {id:'eclipse', productId:null, variantId:null, slot:'table',  name:'Eclipse', price:159, priceMoney:'$159', code:'AC-04', img:'{{ "kit-eclipse.jpeg" | asset_url }}',
      desc:'Half-moon shade on a travertine puck. Washes the wall behind with a soft hotel-style gradient. Surprisingly quiet in a room full of angles.',
      specs:{Height:'8 in',Base:'5 in dia',Wattage:'4W · 2700K',Finish:'Travertine + brass'}},
  ];
  {%- endif -%}

  /* Kit is a flat list of selected lamp ids. Order is selection order.
     Tier 1 = 2+ lamps. Tier 2 = 3+ lamps AND one of them is a floor lamp (the "anchor"). */
  const MAX_LAMPS = 4;
  // Slot-position unlock hints (merchant-editable via section settings).
  const UNLOCK_T1_HINT = {{ section.settings.unlock_t1_hint | default: 'Unlocks Tier 1' | json }};
  const UNLOCK_T2_HINT = {{ section.settings.unlock_t2_hint | default: 'Unlocks Tier 2' | json }};
  const firstOfSlot = (slot) => { const p = products.find(x => x.slot === slot); return p ? p.id : null; };
  const floorId = firstOfSlot('floor');
  const tableId = firstOfSlot('table');
  /* Recommended seeds — each entry is {id, variantId}. variantId is auto-resolved
     via defaultVariantOf() when the kit is reset to "Use our picks". */
  const RECOMMENDED = [floorId, tableId, tableId].filter(Boolean).map(id => ({ id, variantId: null }));
  let state = { selected: [], filter:'all', query: '', sort:'default', lastTier: null, page: 0 };

  const get = id => products.find(p=>p.id===id);
  /* Find a specific variant inside a product (or null if not a variant product). */
  const variantOf = (p, vid) => {
    if (!p || !p.variants || !p.variants.length) return null;
    const found = p.variants.find(v => String(v.id) === String(vid));
    return found || null;
  };
  /* Default variant for a product — first available, falls back to first listed. */
  const defaultVariantOf = (p) => {
    if (!p) return null;
    if (p.variants && p.variants.length){
      return p.variants.find(v => v.available) || p.variants[0];
    }
    return null;
  };
  /* Effective image/price for a slot — variant's image+price overrides product's. */
  const slotImage = (s) => {
    const p = get(s.id); if (!p) return '';
    const v = variantOf(p, s.variantId);
    return (v && v.img) || p.img;
  };
  const slotPrice = (s) => {
    const p = get(s.id); if (!p) return 0;
    const v = variantOf(p, s.variantId);
    return (v && typeof v.price === 'number') ? v.price : (p.price || 0);
  };
  const slotVariantTitle = (s) => {
    const p = get(s.id); if (!p) return '';
    const v = variantOf(p, s.variantId);
    return v ? v.title : '';
  };
  const pieces = () => state.selected.length;
  const hasAnchor = () => state.selected.some(s => (get(s.id) || {}).slot === 'floor');
  const total = () => state.selected.reduce((sum,s)=>sum+slotPrice(s),0);
  const tier = () => {
    const n = pieces();
    if(n >= 3 && hasAnchor()) return 2;
    if(n >= 2) return 1;
    return 0;
  };
  // Anchor index within the selected array (first floor lamp found, or -1)
  const anchorIndex = () => state.selected.findIndex(s => (get(s.id) || {}).slot === 'floor');

  /* ---- Slots — dynamic cards based on selection order ---- */
  function renderSlots(){
    const wrap = document.getElementById('slots');
    const anchorIdx = anchorIndex();
    const n = state.selected.length;
    /* Always render exactly MAX_LAMPS (=4) slot cells so the 2×2 grid never shifts. */
    const visibleCount = MAX_LAMPS;

    const cards = [];
    for(let i = 0; i < visibleCount; i++){
      const slot = state.selected[i];
      const p = slot ? get(slot.id) : null;
      const v = slot && p ? variantOf(p, slot.variantId) : null;
      const isAnchor = p && p.slot === 'floor' && i === anchorIdx;
      const labelTop = `Lamp ${String(i+1).padStart(2,'0')}`;
      const labelRight = (p && isAnchor) ? 'Anchor' : '';

      let emptyHint = '';
      if (i === 1) emptyHint = `<span class="hint">${UNLOCK_T1_HINT}</span>`;
      else if (i === 2) emptyHint = `<span class="hint is-anchor">${UNLOCK_T2_HINT}</span>`;

      let filledHTML = '';
      if (p){
        const img = slotImage(slot);
        const price = slotPrice(slot);
        const variantTitle = v ? v.title : '';
        const colorCount = (p.variants && p.variants.length) ? p.variants.length : 0;
        /* Variant chip on slot card — shows the active variant's color + a "+N" pill
           when the product has 2+ variants. Click opens the modal so the user can
           swap variants without removing the slot. */
        const variantChip = (v && colorCount > 1) ? `
          <span class="slot-variant" data-slot-index="${i}" title="${variantTitle.replace(/"/g,'&quot;')}">
            <span class="slot-variant__chip" style="background:${hexFor(v.colorKey || v.option1)}"></span>
            <span class="slot-variant__count">+${colorCount}</span>
          </span>` : '';
        filledHTML = `
        <div class="slot-card${isAnchor?' is-anchor':''}" data-slot-index="${i}">
          <img src="${img}" alt="${p.name}">
          ${isAnchor ? '<span class="anchor-tag">Anchor</span>' : ''}
          ${variantChip}
          <span class="rm" data-remove-index="${i}">×</span>
          <div class="info">
            <h4>${p.name}${variantTitle ? ` <span class="info-variant">· ${variantTitle}</span>` : ''}</h4>
            <span class="pr">$${price}</span>
          </div>
        </div>`;
      }
      const cardHTML = p ? filledHTML : `
        <div class="slot-empty" data-slot-empty="${i}">
          <span class="plus">+</span>
          <span class="label">Add lamp</span>
          ${emptyHint}
        </div>`;

      cards.push(`<div class="slot">
        <div class="slot-label"><span class="nm">${labelTop}</span><span class="req${labelRight==='Anchor'?' anchor':''}">${labelRight}</span></div>
        ${cardHTML}
      </div>`);
    }
    wrap.innerHTML = cards.join('');
    // Swap to horizontal carousel when we're rendering more cards than the grid holds.
    wrap.classList.toggle('overflow', visibleCount > 4);

    wrap.querySelectorAll('[data-remove-index]').forEach(b => b.addEventListener('click', e => {
      e.stopPropagation();
      const idx = parseInt(b.dataset.removeIndex, 10);
      state.selected.splice(idx, 1);
      renderAll();
    }));
    /* Click a filled slot card → open modal in "edit slot" mode so the user can
       swap variants. The variant chip on the card has its own handler that does
       the same thing (delegated below). */
    wrap.querySelectorAll('.slot-card').forEach(card => card.addEventListener('click', e => {
      if (e.target.closest('[data-remove-index]')) return;
      const idx = parseInt(card.dataset.slotIndex, 10);
      const slot = state.selected[idx];
      if (!slot) return;
      openDetails(slot.id, { editSlotIndex: idx });
    }));
    wrap.querySelectorAll('.slot-empty').forEach(el => el.addEventListener('click', () => {
      document.querySelector('.browse').scrollIntoView({behavior:'smooth', block:'start'});
    }));
  }

  /* ---- Included list ---- */
  function renderIncluded(){
    const t = tier();
    const n = pieces();
    document.getElementById('pc-num').textContent = n;
    document.getElementById('tier-label').textContent = t===0 ? 'No tier yet' : `Tier ${t}`;

    // Tier 1 group
    const t1g = document.getElementById('tier1-group');
    t1g.classList.toggle('unlocked', t >= 1);
    t1g.classList.toggle('locked', t < 1);
    document.getElementById('tier1-status').textContent = t >= 1 ? 'Unlocked' : 'Locked';

    // Tier 2 group
    const t2g = document.getElementById('tier2-group');
    t2g.classList.toggle('unlocked', t >= 2);
    t2g.classList.toggle('locked', t < 2);
    document.getElementById('tier2-status').textContent = t >= 2 ? 'Unlocked' : 'Locked';

    // Label is always "Free" — skip credit pills so the $ amount stays intact.
    t1g.querySelectorAll('.tg-item .free:not(.free--credit)').forEach(el => el.textContent = 'Free');
    t2g.querySelectorAll('.tg-item .free:not(.free--credit)').forEach(el => el.textContent = 'Free');

    // The old #incl-total element was replaced by the Always-Included benefits list.
    // Guard the assignment so the JS doesn't throw when the element is absent.
    const inclTotalEl = document.getElementById('incl-total');
    if (inclTotalEl) {
      let v = 0;
      if(t >= 1) v += 79;
      if(t >= 2) v += 30 + 150;
      inclTotalEl.textContent = v === 0 ? '—' : `$${v}`;
    }

    // Celebrate threshold crossing — visual pulse only, no toast popup
    if(state.lastTier !== null && t > state.lastTier && t >= 1){
      const el = t === 2 ? document.getElementById('tier2-group') : document.getElementById('tier1-group');
      if(el){
        el.classList.add('just-unlocked');
        setTimeout(()=>el.classList.remove('just-unlocked'), 900);
      }
    }
    state.lastTier = t;
  }

  /* ---- Dock + hero ---- */
  function renderDock(){
    const t = tier();
    const n = pieces();
    const lampTotal = total();

    const wrap = document.getElementById('dock-slots');
    // Show up to 3 dock slot previews — selected lamps first, then placeholders
    const DOCK_VISIBLE = 3;
    const anchorIdx = anchorIndex();
    const slotHTML = [];
    for(let i = 0; i < DOCK_VISIBLE; i++){
      const slot = state.selected[i];
      const p = slot ? get(slot.id) : null;
      if(p){
        const isAnchor = p.slot === 'floor' && i === anchorIdx;
        const short = isAnchor ? 'Anchor' : (p.slot === 'floor' ? 'Floor' : 'Table');
        const img = slotImage(slot);
        slotHTML.push(`<div class="dock-slot filled${isAnchor?' is-anchor':''}"><img src="${img}" alt="${p.name}"><span class="st">${short}</span></div>`);
      } else {
        const short = i === 0 ? 'Pick 1' : (i === 1 ? 'Pick 2' : 'Anchor');
        slotHTML.push(`<div class="dock-slot"><span class="lm">+</span><span class="st">${short}</span></div>`);
      }
    }
    // If user has more than DOCK_VISIBLE, show a +N chip on the last slot
    if(state.selected.length > DOCK_VISIBLE){
      const extra = state.selected.length - DOCK_VISIBLE;
      slotHTML.push(`<div class="dock-slot dock-slot-more"><span class="lm">+${extra}</span><span class="st">more</span></div>`);
    }
    wrap.innerHTML = slotHTML.join('');

    const badge = document.getElementById('dock-badge');
    badge.className = 'badge ' + (t===2?'':(t===1?'t1':'t0'));
    const floor = hasAnchor();
    if(t===2)      badge.textContent = 'All extras unlocked';
    else if(t===1) badge.textContent = 'Tier 01 unlocked';
    else           badge.textContent = 'Pick 2 lamps to start';

    /* Dock subline — straightforward copy, no "yours" phrasing. */
    const subline = document.getElementById('dock-subline');
    if(subline){
      if(t===2){
        subline.innerHTML = `$259 in free extras + <b>$150 credit</b>`;
      } else if(t===1){
        if(!floor) subline.innerHTML = `Add a <b>floor lamp</b> to unlock Tier 02`;
        else       subline.innerHTML = `1 more lamp unlocks <b>$259 in extras + $150 credit</b>`;
      } else {
        subline.innerHTML = `Up to <b>$338</b> in free extras`;
      }
    }

    document.getElementById('dock-pieces').innerHTML = `<b>${n}</b> ${n===1?'lamp':'lamps'}`;

    // Free extras visual row
    const DOCK_EXTRAS = [
      {img:'{% if all_products["pocket"].featured_image %}{{ all_products["pocket"].featured_image | image_url: width: 96 }}{% else %}{{ "kit-acc-pocket.jpeg" | asset_url }}{% endif %}',   name:'Rechargeable Mini Lamp', tier:2},
      {img:'{{ "kit-acc-diffuser.jpeg" | asset_url }}', name:'Warm Tapers',     tier:2},
      {img:'{{ "kit-acc-care.jpeg" | asset_url }}',     name:'Care Cloth',      tier:1},
      {img:'{{ "kit-acc-atlas.jpeg" | asset_url }}',    name:'Layering Guide',  tier:1},
      {img:'{{ "kit-acc-bulbs.jpeg" | asset_url }}',    name:'Bulb Refill',     tier:1},
      {credit:true,                 name:'$150 Credit',     tier:2}
    ];
    const extras = document.getElementById('dock-extras');
    const extrasHTML = DOCK_EXTRAS.map(e => {
      if(e.credit) return `<div class="mini th-credit" title="$150 Warm Credit toward your next room">$</div>`;
      return `<div class="mini" title="${e.name}${t>=e.tier?' · Free':''}"><img src="${e.img}" alt=""></div>`;
    }).join('');
    let hintText;
    if(t===0) hintText = `<b>Rechargeable lamp · Tapers · Care · Bulb · Guide</b> unlock at 2 lamps`;
    else if(t===1){
      if(!hasAnchor()) hintText = `Add a <b>floor lamp</b> + 1 more for the rechargeable lamp, Tapers & $150 credit`;
      else hintText = `Add <b>1 more lamp</b> for the rechargeable lamp, Tapers + $150 credit`;
    }
    else hintText = `<b>Rechargeable lamp · Tapers · Care · Bulb · Guide</b> + <b>$150 credit</b> — all yours`;
    extras.className = 'dock-extras' + (t>=2?' unlocked':'');
    extras.innerHTML = extrasHTML + `<span class="hint">${hintText}</span>`;

    document.getElementById('dock-total').textContent = n===0 ? '—' : `$${lampTotal}`;
    const totSub = document.getElementById('dock-total-sub');
    if(t >= 2){ totSub.textContent = '+ $259 in free extras'; totSub.style.display='block'; }
    else if(t === 1){ totSub.textContent = '+ $79 in free extras'; totSub.style.display='block'; }
    else { totSub.style.display='none'; }

    const cta = document.getElementById('dock-cta');
    if(n === 0){
      cta.classList.add('disabled'); cta.disabled = true;
      cta.textContent = 'Pick a lamp';
    } else {
      cta.classList.remove('disabled'); cta.disabled = false;
      cta.textContent = 'Complete your order';
    }

    // Hero tier/price removed — price + tier live in Section 02 now
    // (null-guarded in case legacy elements exist)
    const hp = document.getElementById('hero-price');
    if(hp) hp.textContent = n===0 ? '—' : `$${lampTotal}`;
    const ht = document.getElementById('hero-tier');
    if(ht){ ht.textContent = badge.textContent; ht.className = 'tier-top ' + (t===2?'':(t===1?'t1':'t0'))}

    // Update visible "0 / 4 selected" count in col-head
    const metaPc = document.getElementById('meta-pc-num');
    if (metaPc) metaPc.textContent = n;

    // Kit CTA row sync (inside Section 02) — price on top line (.v), hint below (.sub).
    const kitV = document.getElementById('kit-total-v');
    const kitSubLine = document.getElementById('kit-total-sub');
    if (n === 0){
      kitV.innerHTML = 'Up to <b>$338</b> in free extras';
      kitV.classList.add('is-empty');
      kitSubLine.innerHTML = '';
      kitSubLine.hidden = true;
    } else {
      kitV.innerHTML = `$${lampTotal}`;
      kitV.classList.remove('is-empty');
      let subText = '';
      if (t >= 2) subText = '<b>$259</b> free + $150 credit included';
      else if (t === 1) subText = floor ? '1 more lamp unlocks <b>Tier 02</b>' : 'Add a <b>floor lamp</b> for Tier 02';
      else subText = 'Add 1 more lamp for <b>Tier 01</b>';
      kitSubLine.innerHTML = subText;
      kitSubLine.hidden = false;
    }
    const kitBtn = document.getElementById('kit-add-btn');
    const kitBtnLbl = kitBtn.querySelector('.add-btn__lbl');
    if(n === 0){
      kitBtn.classList.add('disabled'); kitBtn.disabled = true;
      if (kitBtnLbl) kitBtnLbl.textContent = 'Pick a Lamp'; else kitBtn.textContent = 'Pick a Lamp';
    } else {
      kitBtn.classList.remove('disabled'); kitBtn.disabled = false;
      if (kitBtnLbl) kitBtnLbl.textContent = 'Complete your order'; else kitBtn.textContent = 'Complete your order';
    }

    // Kit status — lamp count line + progress dashes (4 segments, light up per lamp)
    const statusText = document.getElementById('kit-status-text');
    if (statusText) {
      if (n === 0)      statusText.textContent = 'No lamps added';
      else if (n === 1) statusText.textContent = '1 lamp added';
      else              statusText.textContent = `${n} lamps added`;
    }
    const progress = document.getElementById('kit-progress');
    if (progress) {
      const segs = progress.querySelectorAll('.seg');
      const litCount = Math.min(n, segs.length);
      segs.forEach((seg, i) => seg.classList.toggle('on', i < litCount));
    }

    // Hide the anchor reminder once the user has an anchor (floor lamp) in the kit.
    const anchorReminder = document.querySelector('.col-right .anchor-reminder');
    if (anchorReminder) anchorReminder.classList.toggle('anchor-met', floor);

    // Second CTA sync — just toggle disabled state; the label is set in markup
    document.getElementById('second-cta-btn').disabled = n === 0;

    /* Browse-bottom Complete Kit CTA — visible at 2+ lamps, with a tier-aware
       coaching subline that nudges the user toward the next unlock. */
    var bc = document.getElementById('browse-complete');
    if (bc){
      bc.classList.toggle('is-visible', n >= 2);
      var bcCount = document.getElementById('browse-complete-count');
      var bcSub   = document.getElementById('browse-complete-sub');
      if (bcCount) bcCount.innerHTML = '<b>' + n + '</b> ' + (n === 1 ? 'lamp' : 'lamps') + ' in your kit';
      if (bcSub){
        if (t === 0)        bcSub.innerHTML = 'Add 1 more lamp to unlock <b>$79</b> in free gifts';
        else if (t === 1 && !floor) bcSub.innerHTML = 'Add a <b>floor lamp</b> to unlock <b>$259</b> more in extras';
        else if (t === 1)   bcSub.innerHTML = 'Add 1 more lamp to unlock <b>$259</b> more in extras + <b>$150</b> credit';
        else                bcSub.innerHTML = 'All <b>$338</b> in free gifts unlocked · ready to ship';
      }
    }
  }

  /* ---- Grid + Pagination ----
     Fixed 4-col desktop / 2-col mobile. If filtered products exceed a page,
     show prev/next + dots. Page size adapts to viewport. */
  const PAGE_SIZE_DESKTOP = 8;
  const PAGE_SIZE_MOBILE = 6;
  function currentPageSize(){
    return window.matchMedia('(max-width: 900px)').matches ? PAGE_SIZE_MOBILE : PAGE_SIZE_DESKTOP;
  }

  /* Intelligent mix for the "All" filter:
     - Lead with a floor-lamp anchor so users immediately see the piece that
       makes a kit complete.
     - Interleave floors and tables proportionally so every page shows a
       real mix (no 3 pages of floors followed by 3 pages of tables).
     - When filtered to a single slot, preserve the collection's native order. */
  function mixedAll(){
    const floors = products.filter(p => p.slot === 'floor');
    const tables = products.filter(p => p.slot === 'table');
    if (floors.length === 0) return tables.slice();
    if (tables.length === 0) return floors.slice();
    const result = [floors[0]]; // anchor first
    let fi = 1, ti = 0;
    while (fi < floors.length || ti < tables.length) {
      const fp = floors.length ? fi / floors.length : 1;
      const tp = tables.length ? ti / tables.length : 1;
      if (ti < tables.length && (fi >= floors.length || tp <= fp)) {
        result.push(tables[ti++]);
      } else {
        result.push(floors[fi++]);
      }
    }
    return result;
  }

  function renderGrid(){
    const grid = document.getElementById('grid');
    let filtered = state.filter === 'all'
      ? mixedAll()
      : products.filter(p => p.slot === state.filter);
    /* Apply search query — case-insensitive substring match against product
       name (and code, when present). Skip when query is empty. */
    const q = (state.query || '').trim().toLowerCase();
    if (q){
      filtered = filtered.filter(p => {
        const name = (p.name || '').toLowerCase();
        const code = (p.code || '').toLowerCase();
        return name.includes(q) || code.includes(q);
      });
    }
    /* Apply sort — non-destructive copy so the canonical `products` order isn't
       mutated. Numeric fallback to 0 keeps NaN out of comparators. */
    if (state.sort === 'price-asc'){
      filtered = filtered.slice().sort((a,b) => (a.price || 0) - (b.price || 0));
    } else if (state.sort === 'price-desc'){
      filtered = filtered.slice().sort((a,b) => (b.price || 0) - (a.price || 0));
    } else if (state.sort === 'name'){
      filtered = filtered.slice().sort((a,b) => (a.name || '').localeCompare(b.name || ''));
    }
    /* Empty state — render a single full-width message instead of cards. */
    if (filtered.length === 0){
      grid.classList.add('p-grid--empty');
      grid.innerHTML = q
        ? `No lamps match <em>"${q.replace(/[<>&"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;'}[c]))}"</em>. Try a different name.`
        : `No lamps in this filter.`;
      const pager = document.getElementById('grid-pager');
      if (pager) pager.classList.add('hidden');
      return;
    }
    grid.classList.remove('p-grid--empty');
    const pageSize = currentPageSize();
    const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
    if (state.page == null || state.page >= totalPages) state.page = 0;
    const pageStart = state.page * pageSize;
    const pageEnd = pageStart + pageSize;
    const slice = filtered.slice(pageStart, pageEnd);
    const cards = slice.map(p => {
      const count = state.selected.filter(s => s.id === p.id).length;
      const canAddMore = state.selected.length < MAX_LAMPS;
      const inKit = count > 0;
      const productAttr = p.productId ? `data-product-id="${p.productId}"` : '';
      const variantAttr = p.variantId ? `data-variant-id="${p.variantId}"` : '';
      const priceAttr = p.priceNoCurrency ? `data-price="${p.priceNoCurrency}"` : `data-price="${p.price}"`;
      /* Variant count badge (mirrors product-card.liquid) — top-right of image */
      const variantCount = (p.variants && p.variants.length > 1) ? p.variants.length : 0;
      const variantBadge = variantCount > 0
        ? `<span class="card-colors"><em>${variantCount}</em>colors</span>`
        : '';
      return `
      <div class="card${inKit?' in-config':''}" data-id="${p.id}" ${productAttr} ${variantAttr} ${priceAttr}>
        <div class="ph" data-details>
          <img src="${p.img}" alt="${p.name}">
          ${variantBadge}
          ${inKit ? `
            <span class="added-badge" aria-label="In your kit">✓</span>
            <div class="qty">
              <button type="button" data-qty-minus aria-label="Remove one">−</button>
              <span class="count">${count}</span>
              <button type="button" data-qty-plus aria-label="Add one" ${canAddMore?'':'disabled'}>+</button>
            </div>
          ` : ''}
        </div>
        <div class="nm">
          <div class="nm-text">
            <h3>${p.name}</h3>
            <span class="slot-tag">${p.slot} lamp</span>
            <span class="pr">${p.priceMoney || '$'+p.price}</span>
          </div>
          <button type="button" class="add-btn" data-add aria-label="${inKit?'Remove from kit':'Add to kit'}">${inKit ? 'Added' : '+ Add'}</button>
        </div>
      </div>`;
    });

    // Pad the last page with invisible placeholder cards so the grid height stays
    // consistent across pages — prevents the pager (and everything below) from
    // shifting up when the last page has fewer products than PAGE_SIZE.
    const placeholderCount = Math.max(0, pageSize - slice.length);
    for (let i = 0; i < placeholderCount; i++) {
      cards.push(`
      <div class="card card--placeholder" aria-hidden="true">
        <div class="ph"></div>
        <div class="nm">
          <div class="nm-text"><h3>&nbsp;</h3><span class="pr">&nbsp;</span></div>
          <button type="button" class="add-btn" tabindex="-1">&nbsp;</button>
        </div>
      </div>`);
    }
    grid.innerHTML = cards.join('');

    grid.querySelectorAll('.card').forEach(c => {
      const cardP = get(c.dataset.id);
      const cardHasVariants = !!(cardP && cardP.variants && cardP.variants.length > 1);
      c.querySelectorAll('[data-qty-plus]').forEach(b => b.addEventListener('click', e => {
        e.stopPropagation();
        if (cardHasVariants) { openQuickPicker(c.dataset.id); return; }
        adjustQuantity(c.dataset.id, +1);
      }));
      c.querySelectorAll('[data-qty-minus]').forEach(b => b.addEventListener('click', e => {
        e.stopPropagation();
        adjustQuantity(c.dataset.id, -1);
      }));
      // Image click opens the details modal.
      c.querySelectorAll('[data-details]').forEach(b => b.addEventListener('click', e => {
        if (e.target.closest('[data-qty-plus],[data-qty-minus]')) return;
        e.stopPropagation();
        openDetails(c.dataset.id);
      }));
      // "+ Add" button toggles the product into the kit. For variants, opens the
      // quick picker so the user chooses a color before adding.
      c.querySelectorAll('[data-add]').forEach(b => b.addEventListener('click', e => {
        e.stopPropagation();
        if (cardHasVariants) { openQuickPicker(c.dataset.id); return; }
        toggleProductInKit(c.dataset.id);
      }));
    });

    // --- Pagination UI ---
    const pager = document.getElementById('grid-pager');
    const dotsEl = document.getElementById('grid-dots');
    const infoEl = document.getElementById('grid-page-info');
    const prevBtn = document.getElementById('grid-prev');
    const nextBtn = document.getElementById('grid-next');
    if (totalPages <= 1) {
      pager.classList.add('hidden');
    } else {
      pager.classList.remove('hidden');
      infoEl.textContent = `Page ${state.page + 1} of ${totalPages}`;
      dotsEl.innerHTML = Array.from({length: totalPages}, (_, i) =>
        `<button type="button" class="p-dot${i === state.page ? ' on' : ''}" data-page="${i}" aria-label="Go to page ${i + 1}"${i === state.page ? ' aria-current="true"' : ''}></button>`
      ).join('');
      dotsEl.querySelectorAll('.p-dot').forEach(d => d.addEventListener('click', () => {
        state.page = parseInt(d.dataset.page, 10);
        renderGrid();
      }));
      prevBtn.disabled = state.page === 0;
      nextBtn.disabled = state.page >= totalPages - 1;
    }
  }

  function productCount(id){
    return state.selected.filter(s => s.id === id).length;
  }

  /* Build a slot object for a product, defaulting variantId to the product's
     first available variant when one isn't passed in. */
  function makeSlot(id, variantId){
    const p = get(id); if (!p) return null;
    let vid = variantId;
    if (!vid){
      const def = defaultVariantOf(p);
      vid = def ? def.id : (p.variantId || null);
    }
    return { id, variantId: vid };
  }

  function adjustQuantity(id, delta, variantId){
    if(delta > 0){
      if(state.selected.length >= MAX_LAMPS) return;
      const slot = makeSlot(id, variantId);
      if (slot) state.selected.push(slot);
    } else {
      /* Remove the LAST occurrence of this product (any variant). */
      let idx = -1;
      for (let i = state.selected.length - 1; i >= 0; i--){
        if (state.selected[i].id === id){ idx = i; break; }
      }
      if(idx >= 0) state.selected.splice(idx, 1);
    }
    renderAll();
  }

  /* Toggle product in/out of kit. For variant products, optional variantId
     specifies which variant to add (defaults to first available). */
  function toggleProductInKit(id, variantId){
    const idx = state.selected.findIndex(s => s.id === id);
    if(idx >= 0){
      state.selected.splice(idx, 1);
    } else {
      if(state.selected.length >= MAX_LAMPS) return;
      const slot = makeSlot(id, variantId);
      if (slot) state.selected.push(slot);
    }
    renderAll();
  }

  /* Update the variant of a specific slot (in-place edit from the modal). */
  function setSlotVariant(slotIndex, variantId){
    const slot = state.selected[slotIndex];
    if (!slot) return;
    slot.variantId = variantId;
    renderAll();
  }

  document.querySelectorAll('.browse .chip[data-filter]').forEach(c => c.addEventListener('click', () => {
    state.filter = c.dataset.filter;
    state.page = 0;
    renderAll();
  }));

  /* Sort dropdown — re-renders grid in place (resets to page 0). */
  const sortEl = document.getElementById('kit-sort');
  if (sortEl) sortEl.addEventListener('change', () => {
    state.sort = sortEl.value;
    state.page = 0;
    renderGrid();
  });

  /* ---- Search: toggle, live input, clear ----
     Toggle button expands the inline search bar below the filter chip row.
     Typing in the input updates state.query and re-renders the grid live —
     no debounce needed since products are already in JS memory. */
  (function setupKitSearch(){
    const toggleBtn = document.getElementById('kit-search-btn');
    const bar = document.getElementById('kit-search-bar');
    const input = document.getElementById('kit-search-input');
    const clearBtn = document.getElementById('kit-search-clear');
    if (!toggleBtn || !bar || !input || !clearBtn) return;

    function openBar(){
      bar.hidden = false;
      toggleBtn.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => input.focus());
    }
    function closeBar(){
      bar.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
      if (state.query){
        state.query = '';
        input.value = '';
        clearBtn.hidden = true;
        state.page = 0;
        renderGrid();
      }
    }
    toggleBtn.addEventListener('click', () => {
      if (toggleBtn.getAttribute('aria-expanded') === 'true') closeBar();
      else openBar();
    });
    input.addEventListener('input', () => {
      const v = input.value;
      state.query = v;
      clearBtn.hidden = v.length === 0;
