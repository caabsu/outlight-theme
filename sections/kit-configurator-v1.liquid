     ============================================================ */
  {%- if use_default_pair == false and kit_collection and kit_collection.products.size > 0 -%}
  const products = [
    {%- for product in kit_collection.products limit: 12 -%}
      {% render 'kit-product-json', product: product %}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
  {%- elsif floor_collection.products.size > 0 or table_collection.products.size > 0 -%}
  {%- comment -%}
    Include ALL floor + table products; pagination (8/page desktop, 6/page
    mobile) handles display. Merchant can customize by picking a single
    kit_collection, which then replaces this pair.
  {%- endcomment -%}
  {%- assign any_emitted = 0 -%}
  const products = [
    {%- for product in floor_collection.products -%}
      {% if any_emitted > 0 %},{% endif %}{% render 'kit-product-json', product: product %}
      {%- assign any_emitted = any_emitted | plus: 1 -%}
    {%- endfor -%}
    {%- for product in table_collection.products -%}
      {% if any_emitted > 0 %},{% endif %}{% render 'kit-product-json', product: product %}
      {%- assign any_emitted = any_emitted | plus: 1 -%}
    {%- endfor -%}
  ];
  {%- else -%}
  /* Fallback: no collection configured — uses mock data with local asset URLs. */
  const products = [
    {id:'cedar',   productId:null, variantId:null, slot:'floor',   name:'Cedar',   price:459, priceMoney:'$459', code:'FL-07', img:'{{ "kit-cedar.jpeg" | asset_url }}',
      desc:'A minimal brass floor lamp. Hand-finished walnut spine, linen-wrapped shade, plug-in base. Puts out a soft reading-level pool right where the chair or headboard needs it.',
      specs:{Height:'60 in',Base:'10 in dia',Wattage:'9W · 2700K',Finish:'Brushed brass'}},
    {id:'wren',    productId:null, variantId:null, slot:'table', name:'Wren',    price:179, priceMoney:'$179', code:'BD-11', img:'{{ "kit-wren.jpeg" | asset_url }}',
      desc:'The thinnest lamp we make. Inline switch, matte walnut body, linen drum shade. Designed to vanish into the nightstand until you turn it on.',
      specs:{Height:'16 in',Base:'6 in dia',Wattage:'6W · 2700K',Finish:'Matte walnut'}},
    {id:'moor',    productId:null, variantId:null, slot:'table', name:'Moor',    price:219, priceMoney:'$219', code:'BD-09', img:'{{ "kit-moor.jpeg" | asset_url }}',
      desc:'Stacked turned-wood base with a weighted feel. Warm linen shade casts a generous glow on the pillow. The kit default for a reason.',
      specs:{Height:'18 in',Base:'7 in dia',Wattage:'6W · 2700K',Finish:'Oiled ash'}},
    {id:'onyx',    productId:null, variantId:null, slot:'table', name:'Onyx',    price:199, priceMoney:'$199', code:'BD-12', img:'{{ "kit-onyx.jpeg" | asset_url }}',
      desc:'Blackened brass bedside with a low-profile drum. Slightly cooler silhouette than Moor, same warm light. For rooms that lean modern.',
      specs:{Height:'17 in',Base:'6.5 in dia',Wattage:'6W · 2700K',Finish:'Blackened brass'}},
    {id:'cairn',   productId:null, variantId:null, slot:'table', name:'Cairn',   price:189, priceMoney:'$189', code:'BD-13', img:'{{ "kit-cairn.jpeg" | asset_url }}',
