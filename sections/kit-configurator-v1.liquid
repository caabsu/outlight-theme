  /* showToast removed — no more popup notifications */

  /* Dock visibility — IntersectionObserver on a sentinel at the bottom of main-split.
     When the sentinel exits the top of the viewport, dock slides down from above. */
  const dock = document.getElementById('dock');
  const mainSplit = document.querySelector('.main-split');

  // Insert sentinel just after main-split
  const sentinel = document.createElement('div');
  sentinel.id = 'dock-sentinel';
  sentinel.style.cssText = 'width:1px;height:1px;pointer-events:none;opacity:0';
  mainSplit.parentNode.insertBefore(sentinel, mainSplit.nextSibling);

  function showDock(show){
    const isMobile = window.matchMedia('(max-width:900px)').matches;
    let target;
    if(isMobile){
      // Mobile: bottom-anchored, slide up from below viewport
      target = show ? 'translate3d(0, 0, 0)' : 'translate3d(0, 120%, 0)';
    } else {
      // Desktop: top-anchored, replaces nav
      target = show ? 'translate3d(0, 0, 0)' : 'translate3d(0, -160px, 0)';
    }
    dock.classList.add('animating');
    dock.style.setProperty('transform', target, 'important');
    dock.classList.toggle('visible', show);
    /* Preserve scroll position — adding kit-dock-open class changes body padding,
       which otherwise shifts the viewport up when the dock appears while the user
       is interacting with the kit picker below. */
    const hadClass = document.body.classList.contains('kit-dock-open');
    if (hadClass !== show){
      const sy = window.scrollY;
      document.body.classList.toggle('kit-dock-open', show);
      /* Only compensate when shifting padding: adding dock-open adds padding-bottom
         on mobile, which pushes following content up visually. Re-scroll to keep the
         user's anchor steady. */
      requestAnimationFrame(() => { if (Math.abs(window.scrollY - sy) > 2) window.scrollTo(0, sy); });
    }
  }

  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      // Sentinel is above the viewport when boundingClientRect.top < 0
      const scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      showDock(scrolledPast);
    });
  }, { threshold: 0, rootMargin: '0px 0px 0px 0px' });
  io.observe(sentinel);

  // Also respond to resize in case viewport changes
  window.addEventListener('resize', () => {
    const r = sentinel.getBoundingClientRect();
    showDock(r.top < 0);
  }, { passive: true });

  // Initialize
  showDock(false);
  function updateDock(){
    const r = sentinel.getBoundingClientRect();
