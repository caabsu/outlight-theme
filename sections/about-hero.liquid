{%- comment -%}
  about-hero.liquid — Editorial About hero
  Typographic statement hero on paper, with a framed image + caption.
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #ed-abouthero-{{ section.id }}{
    --ink:#131314;--paper:#F9F9FB;--gold:#C5A059;--warm:#f4f0eb;
    --body:#2d3338;--hairline:rgba(19,19,20,.14);--measure:1320px;
  }
  #ed-abouthero-{{ section.id }} *{box-sizing:border-box;}
  #ed-abouthero-{{ section.id }}{
    background:var(--paper);font-family:'Manrope',sans-serif;padding:78px 0 0;
  }
  #ed-abouthero-{{ section.id }} .ed-wrap{
    max-width:var(--measure);margin:0 auto;padding:0 40px;
  }
  #ed-abouthero-{{ section.id }} .ed-label{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:11px;
    letter-spacing:.26em;text-transform:uppercase;color:var(--body);
  }
  #ed-abouthero-{{ section.id }} .ed-label--gold{color:var(--gold);}
  #ed-abouthero-{{ section.id }} .abouthero__eyebrow{
    display:flex;align-items:center;gap:14px;margin-bottom:34px;
  }
  #ed-abouthero-{{ section.id }} .abouthero__eyebrow .rule{
    height:1px;width:48px;background:var(--gold);
  }
  #ed-abouthero-{{ section.id }} h1{
    font-family:'Newsreader',serif;font-weight:200;
    font-size:clamp(3rem,6.8vw,6.4rem);line-height:1.01;letter-spacing:-.018em;
    color:var(--ink);margin:0;max-width:16ch;
  }
  #ed-abouthero-{{ section.id }} h1 em{font-style:italic;font-weight:300;color:var(--gold);}
  #ed-abouthero-{{ section.id }} .abouthero__lede{
    margin:34px 0 0;max-width:520px;font-size:16px;line-height:1.72;
    color:var(--body);font-weight:300;
  }
  #ed-abouthero-{{ section.id }} .abouthero__frame{position:relative;margin:58px 0 0;}
  #ed-abouthero-{{ section.id }} .abouthero__frame img{
    width:100%;height:480px;object-fit:cover;filter:saturate(.96);display:block;
  }
  #ed-abouthero-{{ section.id }} .abouthero__ph{
    width:100%;height:480px;
    background:linear-gradient(155deg,#d4c4a8 0%,#b8a07a 40%,#a08960 100%);
  }
  #ed-abouthero-{{ section.id }} .abouthero__caption{
    margin-top:18px;display:flex;justify-content:space-between;align-items:baseline;
    border-top:1px solid var(--hairline);padding-top:14px;
  }
  #ed-abouthero-{{ section.id }} .abouthero__caption .serif-q{
    font-family:'Newsreader',serif;font-style:italic;font-weight:300;
    font-size:18px;color:var(--ink);
  }
  @media (max-width:880px){
    #ed-abouthero-{{ section.id }} .ed-wrap{padding:0 22px;}
  }
  @media (max-width:680px){
    #ed-abouthero-{{ section.id }} .ed-wrap{padding:0 20px;}
    #ed-abouthero-{{ section.id }}{padding:40px 0 0;}
    #ed-abouthero-{{ section.id }} .abouthero__eyebrow{margin-bottom:20px;gap:11px;}
    #ed-abouthero-{{ section.id }} .abouthero__eyebrow .rule{width:32px;}
    #ed-abouthero-{{ section.id }} .abouthero__eyebrow .ed-label{font-size:9.5px;letter-spacing:.18em;}
    #ed-abouthero-{{ section.id }} h1{
      font-size:clamp(2.4rem,11vw,3.4rem);line-height:1.04;max-width:none;
    }
    #ed-abouthero-{{ section.id }} .abouthero__lede{
      margin-top:22px;font-size:15px;line-height:1.66;max-width:none;
    }
    #ed-abouthero-{{ section.id }} .abouthero__frame{margin-top:38px;}
    #ed-abouthero-{{ section.id }} .abouthero__frame img,
    #ed-abouthero-{{ section.id }} .abouthero__ph{height:300px;}
    #ed-abouthero-{{ section.id }} .abouthero__caption{margin-top:12px;padding-top:11px;}
    #ed-abouthero-{{ section.id }} .abouthero__caption .serif-q{font-size:14.5px;}
    #ed-abouthero-{{ section.id }} .abouthero__caption .ed-label{font-size:9.5px;letter-spacing:.18em;}
  }
</style>

<section id="ed-abouthero-{{ section.id }}">
  <div class="ed-wrap">
    {%- if s.eyebrow != blank -%}
      <div class="abouthero__eyebrow">
        <span class="rule"></span>
        <span class="ed-label">{{ s.eyebrow | escape }}</span>
      </div>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h1>{{ s.heading }}</h1>
    {%- endif -%}

    {%- if s.subheading != blank -%}
      <p class="abouthero__lede">{{ s.subheading | escape }}</p>
    {%- endif -%}

    <figure class="abouthero__frame">
      {%- if s.image != blank -%}
        <img
          src="{{ s.image | image_url: width: 1600 }}"
          srcset="{{ s.image | image_url: width: 800 }} 800w, {{ s.image | image_url: width: 1600 }} 1600w"
          sizes="(max-width:680px) 100vw, 90vw"
          alt="{{ s.image.alt | escape | default: 'An Outlight-lit room at dusk' }}"
          width="{{ s.image.width }}"
          height="{{ s.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <div class="abouthero__ph"></div>
      {%- endif -%}
      {%- if s.caption_quote != blank or s.caption_fig != blank -%}
        <figcaption class="abouthero__caption">
          <span class="serif-q">{{ s.caption_quote | escape }}</span>
          <span class="ed-label ed-label--gold">{{ s.caption_fig | escape }}</span>
        </figcaption>
      {%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "About Hero",
  "tag": "section",
  "class": "ed-abouthero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About Outlight — Est. Los Angeles, 2024"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>A room isn't finished <em>until the light is.</em></p>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Outlight is a Los Angeles lighting brand with one point of view: most homes look decorated by daylight, then go flat after dark. We curate the warm, sculptural lighting that finishes the room."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Image caption"
    },
    {
      "type": "text",
      "id": "caption_quote",
      "label": "Caption quote",
      "default": "The hour the lights take over."
    },
    {
      "type": "text",
      "id": "caption_fig",
      "label": "Caption figure label",
      "default": "Fig. 01"
    }
  ],
  "presets": [
    {
      "name": "About Hero"
    }
  ]
}
{% endschema %}
