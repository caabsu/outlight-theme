<style>
  .ol-trade-faq-content { max-height: 0; overflow: hidden; transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
  .ol-trade-faq-content.open { max-height: 500px; }
  .ol-trade-faq-icon { transition: transform 0.3s ease; }
  .ol-trade-faq-trigger.open .ol-trade-faq-icon { transform: rotate(45deg); }
</style>

<section class="py-20 md:py-28 px-5 md:px-12" style="background-color:#F9F9FB;">
  <div class="max-w-[1920px] mx-auto">

    <div class="text-center mb-12 md:mb-16">
      <span class="font-label text-[0.65rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-5">{{ section.settings.label }}</span>
      <h2 class="heading-thin text-4xl md:text-5xl text-[#131314] tracking-tight">{{ section.settings.heading }}</h2>
    </div>

    <div class="max-w-3xl mx-auto">
      {% for block in section.blocks %}
        <button class="ol-trade-faq-trigger w-full flex items-start justify-between py-5 md:py-6 border-b border-[#131314]/6" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open');" {{ block.shopify_attributes }}>
          <div class="flex items-start gap-4 md:gap-6">
            <span class="font-label text-[0.55rem] md:text-[0.6rem] uppercase text-[#C5A059]/50 pt-1">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="heading-thin text-base md:text-xl text-[#131314] text-left">{{ block.settings.question }}</span>
          </div>
          <span class="material-symbols-outlined ol-trade-faq-icon text-[#2d3338]/60 text-base md:text-lg shrink-0 mt-0.5">add</span>
        </button>
        <div class="ol-trade-faq-content {% unless forloop.last %}border-b border-[#131314]/6{% endunless %}">
          <p class="py-4 md:py-5 pl-8 md:pl-12 font-body text-[0.85rem] md:text-[0.95rem] font-light text-[#2d3338]/65 leading-relaxed">{{ block.settings.answer }}</p>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Trade FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Who is eligible to join the Trade Program?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "The program is open to interior designers, licensed architects, lighting consultants, general contractors, property developers, hospitality groups, and real estate staging professionals."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trade FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Who is eligible to join the Trade Program?",
            "answer": "The program is open to interior designers, licensed architects, lighting consultants, general contractors, property developers, hospitality groups, and real estate staging professionals. You'll need to provide a valid business registration, professional license, or a portfolio of completed projects during signup."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does approval take?",
            "answer": "Most applications are reviewed and approved within a few hours of submission. You'll receive a confirmation email with your trade account credentials as soon as your credentials are verified. In rare cases requiring documentation review, this may extend to one business day."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is there a minimum order to access trade pricing?",
            "answer": "No minimum order is required. Your 30% trade discount applies to every order regardless of size — from a single pendant to a full multi-site installation. For orders exceeding $10,000, additional project-specific pricing may be available through your account manager."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I request samples before placing a large order?",
            "answer": "Yes. Trade members receive complimentary finish and material samples for any fixture in the catalog. For full product review prior to a large project specification, loan units can be arranged for up to 30 days — contact your account manager to coordinate."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How do I access IES files and technical specifications?",
            "answer": "Once your trade account is active, you'll have access to a dedicated Technical Resources portal containing IES files, photometric data sheets, CAD drawings, and BIM objects for every product. Files are updated whenever a product is revised and are available to download immediately."
          }
        }
      ]
    }
  ]
}
{% endschema %}
