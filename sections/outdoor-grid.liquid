{%- comment -%}
  Outdoor Lighting Grid — exact layout from mock:
  Desktop: col-span-7 + col-span-5, single row, 480px height
  Mobile: 2-col grid
{%- endcomment -%}

<section class="bg-[#F9F9FB] px-5 md:px-12 pt-8 md:pt-12 pb-16 md:pb-24">
<div class="max-w-[1920px] mx-auto">
  <div class="flex items-baseline justify-between mb-10 md:mb-16">
    <h2 class="font-headline text-3xl md:text-5xl font-[200] text-[#131314] tracking-tight">{{ section.settings.heading }}</h2>
    <a href="{{ section.settings.view_all_url | default: '/collections' }}" class="font-label text-[0.6rem] md:text-[0.78rem] uppercase tracking-[0.15em] text-[#2d3338]/55 hover:text-[#131314] transition-colors duration-300">View All →</a>
  </div>

  {%- comment -%} Desktop {%- endcomment -%}
  <div class="hidden md:grid grid-cols-12 gap-[1px] bg-[#131314]/8">
    <a href="{{ section.settings.col1_collection.url | default: '#' }}" class="collection-card col-span-7 group block relative bg-[#F9F9FB]">
      <div class="relative overflow-hidden h-[480px]">
        {%- if section.settings.col1_image_desktop != blank -%}
          <img src="{{ section.settings.col1_image_desktop | image_url: width: 1200 }}" alt="{{ section.settings.col1_collection.title | escape }}" class="img-placeholder absolute inset-0 w-full h-full object-cover">
        {%- elsif section.settings.col1_collection.featured_image -%}
          <img src="{{ section.settings.col1_collection.featured_image | image_url: width: 1200 }}" alt="{{ section.settings.col1_collection.title | escape }}" class="img-placeholder absolute inset-0 w-full h-full object-cover">
        {%- else -%}
          <div class="img-placeholder w-full h-full" style="background:linear-gradient(160deg, #c2976a 0%, #6b4f2d 100%);"></div>
        {%- endif -%}
        <div class="absolute inset-0 bg-gradient-to-t from-[#131314]/50 via-transparent to-transparent"></div>
        <div class="absolute inset-4 border border-white/15 pointer-events-none"></div>
        <div class="border-draw absolute inset-4 pointer-events-none"></div>
        <div class="absolute top-8 left-8"><span class="font-label text-[0.55rem] uppercase tracking-[0.2em] text-white/30">06</span></div>
        <div class="absolute bottom-8 left-8 right-8 flex items-end justify-between">
          <span class="font-headline text-2xl md:text-3xl font-[200] text-white block">{{ section.settings.col1_name | default: section.settings.col1_collection.title | default: 'Wall Lights' }}</span>
          <div class="w-8 h-8 border border-white/10 flex items-center justify-center group-hover:border-[#C5A059]/40 transition-colors"><span class="material-symbols-outlined text-white/25 group-hover:text-[#C5A059] text-base transition-colors">arrow_forward</span></div>
        </div>
      </div>
    </a>
    <a href="{{ section.settings.col2_collection.url | default: '#' }}" class="collection-card col-span-5 group block relative bg-[#F9F9FB]">
      <div class="relative overflow-hidden h-[480px]">
        {%- if section.settings.col2_image_desktop != blank -%}
          <img src="{{ section.settings.col2_image_desktop | image_url: width: 800 }}" alt="{{ section.settings.col2_collection.title | escape }}" class="img-placeholder absolute inset-0 w-full h-full object-cover">
        {%- elsif section.settings.col2_collection.featured_image -%}
          <img src="{{ section.settings.col2_collection.featured_image | image_url: width: 800 }}" alt="{{ section.settings.col2_collection.title | escape }}" class="img-placeholder absolute inset-0 w-full h-full object-cover">
        {%- else -%}
          <div class="img-placeholder w-full h-full" style="background:linear-gradient(160deg, #cfb48e 0%, #7d6038 100%);"></div>
        {%- endif -%}
        <div class="absolute inset-0 bg-gradient-to-t from-[#131314]/50 via-transparent to-transparent"></div>
        <div class="absolute inset-4 border border-white/15 pointer-events-none"></div>
        <div class="border-draw absolute inset-4 pointer-events-none"></div>
        <div class="absolute top-8 left-8"><span class="font-label text-[0.55rem] uppercase tracking-[0.2em] text-white/30">07</span></div>
        <div class="absolute bottom-8 left-8 right-8 flex items-end justify-between">
          <span class="font-headline text-2xl md:text-3xl font-[200] text-white block">{{ section.settings.col2_name | default: section.settings.col2_collection.title | default: 'Landscape Lights' }}</span>
          <div class="w-8 h-8 border border-white/10 flex items-center justify-center group-hover:border-[#C5A059]/40 transition-colors"><span class="material-symbols-outlined text-white/25 group-hover:text-[#C5A059] text-base transition-colors">arrow_forward</span></div>
        </div>
      </div>
    </a>
  </div>

  {%- comment -%} Mobile {%- endcomment -%}
  <div class="grid md:hidden grid-cols-2 gap-x-3 gap-y-[1px]">
    <a href="{{ section.settings.col1_collection.url | default: '#' }}" class="collection-card group block bg-[#F9F9FB]">
      <div class="relative overflow-hidden aspect-[3/4]">
        {%- if section.settings.col1_image_mobile != blank -%}
          <img src="{{ section.settings.col1_image_mobile | image_url: width: 600 }}" alt="{{ section.settings.col1_collection.title | escape }}" class="img-placeholder absolute inset-0 w-full h-full object-cover">
        {%- elsif section.settings.col1_collection.featured_image -%}
          <img src="{{ section.settings.col1_collection.featured_image | image_url: width: 600 }}" alt="{{ section.settings.col1_collection.title | escape }}" class="img-placeholder absolute inset-0 w-full h-full object-cover">
        {%- else -%}
          <div class="img-placeholder w-full h-full" style="background:linear-gradient(160deg, #c2976a 0%, #6b4f2d 100%);"></div>
        {%- endif -%}
        <div class="absolute inset-0 bg-gradient-to-t from-[#131314]/50 via-transparent to-transparent"></div>
        <div class="absolute inset-2 border border-white/[0.06] pointer-events-none"></div>
        <div class="border-draw absolute inset-2 pointer-events-none"></div>
        <div class="absolute bottom-4 left-4 right-4"><span class="font-headline text-base font-[200] text-white block">{{ section.settings.col1_name | default: section.settings.col1_collection.title | default: 'Wall Lights' }}</span></div>
      </div>
    </a>
    <a href="{{ section.settings.col2_collection.url | default: '#' }}" class="collection-card group block bg-[#F9F9FB]">
      <div class="relative overflow-hidden aspect-[3/4]">
        {%- if section.settings.col2_image_mobile != blank -%}
          <img src="{{ section.settings.col2_image_mobile | image_url: width: 600 }}" alt="{{ section.settings.col2_collection.title | escape }}" class="img-placeholder absolute inset-0 w-full h-full object-cover">
        {%- elsif section.settings.col2_collection.featured_image -%}
          <img src="{{ section.settings.col2_collection.featured_image | image_url: width: 600 }}" alt="{{ section.settings.col2_collection.title | escape }}" class="img-placeholder absolute inset-0 w-full h-full object-cover">
        {%- else -%}
          <div class="img-placeholder w-full h-full" style="background:linear-gradient(160deg, #cfb48e 0%, #7d6038 100%);"></div>
        {%- endif -%}
        <div class="absolute inset-0 bg-gradient-to-t from-[#131314]/50 via-transparent to-transparent"></div>
        <div class="absolute inset-2 border border-white/[0.06] pointer-events-none"></div>
        <div class="border-draw absolute inset-2 pointer-events-none"></div>
        <div class="absolute bottom-4 left-4 right-4"><span class="font-headline text-base font-[200] text-white block">{{ section.settings.col2_name | default: section.settings.col2_collection.title | default: 'Landscape Lights' }}</span></div>
      </div>
    </a>
  </div>

</div>
</section>

{% schema %}
{
  "name": "Outdoor Lighting Grid",
  "class": "outdoor-grid-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Outdoor Lighting" },
    { "type": "url", "id": "view_all_url", "label": "View All link" },
    { "type": "header", "content": "Card 1 — Left (col-span-7)" },
    { "type": "collection", "id": "col1_collection", "label": "Collection 1" },
    { "type": "text", "id": "col1_name", "label": "Name override", "info": "Leave blank to use collection title" },
    { "type": "image_picker", "id": "col1_image_desktop", "label": "Desktop image override" },
    { "type": "image_picker", "id": "col1_image_mobile", "label": "Mobile image override" },
    { "type": "header", "content": "Card 2 — Right (col-span-5)" },
    { "type": "collection", "id": "col2_collection", "label": "Collection 2" },
    { "type": "text", "id": "col2_name", "label": "Name override" },
    { "type": "image_picker", "id": "col2_image_desktop", "label": "Desktop image override" },
    { "type": "image_picker", "id": "col2_image_mobile", "label": "Mobile image override" }
  ],
  "presets": [{ "name": "Outdoor Lighting Grid" }]
}
{% endschema %}
