<div class="bg-[#131314] mx-5 md:mx-12 mb-10 md:mb-16 px-6 md:px-12 py-8 md:py-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
  <div>
    <h3 class="heading-thin text-xl md:text-2xl text-[#F9F9FB] tracking-tight mb-2">{{ section.settings.heading }}</h3>
    <p class="font-body text-[0.8rem] md:text-[0.9rem] font-light text-[#F9F9FB]/40">{{ section.settings.subheading }}</p>
  </div>
  <a href="{{ section.settings.button_url }}" class="font-label text-[0.58rem] md:text-[0.65rem] uppercase tracking-[0.15em] text-[#131314] px-6 md:px-8 py-3 md:py-3.5 hover:brightness-90 transition-all w-full md:w-auto text-center" style="background:#C5A059;">{{ section.settings.button_label }}</a>
</div>

{% schema %}
{
  "name": "Support CTA",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Contact our team via email. We respond within 24 hours."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Contact Our Team"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Support CTA"
    }
  ]
}
{% endschema %}
