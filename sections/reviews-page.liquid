{%- comment -%}
  reviews-page.liquid — Editorial Reviews / Trust hub
  A full trust page: rating proof, guarantees, highlighted reviews (blocks),
  and the on-site review widget embed.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
{%- assign guarantee_blocks = section.blocks | where: 'type', 'guarantee' -%}

<style>
  #ed-revpage-{{ section.id }}{
    --ink:#131314;--paper:#F9F9FB;--gold:#C5A059;--warm:#f4f0eb;
    --body:#2d3338;--hairline:rgba(19,19,20,.14);--measure:1320px;
    display:block;background:var(--paper);font-family:'Manrope',sans-serif;
  }
  #ed-revpage-{{ section.id }} *{box-sizing:border-box;}
  #ed-revpage-{{ section.id }} .ed-wrap{
    max-width:var(--measure);margin:0 auto;padding:0 40px;
  }
  #ed-revpage-{{ section.id }} .ed-label{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:11px;
    letter-spacing:.26em;text-transform:uppercase;color:var(--body);
  }
  #ed-revpage-{{ section.id }} .ed-label--gold{color:var(--gold);}

  /* ---- Hero / proof ---- */
  #ed-revpage-{{ section.id }} .revhero{padding:78px 0 0;}
  #ed-revpage-{{ section.id }} .revhero__eyebrow{
    display:flex;align-items:center;gap:14px;margin-bottom:34px;
  }
  #ed-revpage-{{ section.id }} .revhero__eyebrow .rule{
    height:1px;width:48px;background:var(--gold);
  }
  #ed-revpage-{{ section.id }} .revhero__grid{
    display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:end;
  }
  #ed-revpage-{{ section.id }} .revhero h1{
    font-family:'Newsreader',serif;font-weight:200;
    font-size:clamp(2.9rem,6vw,5.6rem);line-height:1.02;letter-spacing:-.018em;
    color:var(--ink);margin:0;
  }
  #ed-revpage-{{ section.id }} .revhero h1 em{
    font-style:italic;font-weight:300;color:var(--gold);
  }
  #ed-revpage-{{ section.id }} .revhero__lede{
    margin:30px 0 0;max-width:420px;font-size:16px;line-height:1.72;
    color:var(--body);font-weight:300;
  }
  #ed-revpage-{{ section.id }} .revhero__score{
    border-top:1px solid var(--ink);padding-top:26px;
    display:flex;align-items:flex-start;gap:24px;
  }
  #ed-revpage-{{ section.id }} .revhero__num{
    font-family:'Newsreader',serif;font-weight:200;font-size:88px;
    line-height:.82;letter-spacing:-.01em;color:var(--ink);
  }
  #ed-revpage-{{ section.id }} .revhero__smeta{display:flex;flex-direction:column;gap:9px;padding-top:6px;}
  #ed-revpage-{{ section.id }} .revhero__stars{
    color:var(--gold);font-size:14px;letter-spacing:.28em;
  }
  #ed-revpage-{{ section.id }} .revhero__of{
    font-family:'Manrope',sans-serif;font-weight:400;font-size:10px;
    letter-spacing:.18em;text-transform:uppercase;color:var(--body);
  }
  #ed-revpage-{{ section.id }} .revhero__count{
    font-family:'Newsreader',serif;font-weight:300;font-size:19px;
    line-height:1.4;color:var(--ink);
  }
  #ed-revpage-{{ section.id }} .revhero__count b{color:var(--gold);font-weight:400;font-style:italic;}
  #ed-revpage-{{ section.id }} .revhero__source{
    font-family:'Manrope',sans-serif;font-weight:400;font-size:11px;
    letter-spacing:.06em;color:var(--body);margin-top:3px;
  }

  /* ---- Guarantees strip ---- */
  #ed-revpage-{{ section.id }} .guarantees{
    margin-top:64px;
    border-top:1px solid var(--ink);
    border-bottom:1px solid var(--hairline);
    display:grid;grid-template-columns:repeat(4,1fr);
  }
  #ed-revpage-{{ section.id }} .guar{
    padding:30px 26px 30px 0;display:flex;flex-direction:column;gap:8px;
  }
  #ed-revpage-{{ section.id }} .guar + .guar{
    border-left:1px solid var(--hairline);padding-left:26px;
  }
  #ed-revpage-{{ section.id }} .guar__title{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:10px;
    letter-spacing:.18em;text-transform:uppercase;color:var(--gold);
  }
  #ed-revpage-{{ section.id }} .guar__line{
    font-family:'Newsreader',serif;font-weight:300;font-size:20px;
    line-height:1.26;color:var(--ink);
  }
  #ed-revpage-{{ section.id }} .guar__line em{font-style:italic;color:var(--gold);}
  #ed-revpage-{{ section.id }} .guar__note{
    font-size:12.5px;line-height:1.6;color:var(--body);font-weight:300;
  }

  /* ---- Highlighted reviews ---- */
  #ed-revpage-{{ section.id }} .revsection{padding:96px 0 0;}
  #ed-revpage-{{ section.id }} .sec-head{
    display:flex;align-items:flex-start;gap:30px;margin-bottom:54px;
  }
  #ed-revpage-{{ section.id }} .sec-head__marker{flex:none;}
  #ed-revpage-{{ section.id }} .marker{
    font-family:'Newsreader',serif;font-weight:200;font-style:italic;
    font-size:clamp(2rem,4vw,3.1rem);color:var(--gold);line-height:1;display:inline-block;
  }
  #ed-revpage-{{ section.id }} .sec-head__text{flex:1;}
  #ed-revpage-{{ section.id }} .sec-head__label{margin-bottom:18px;display:block;}
  #ed-revpage-{{ section.id }} .sec-head h2{
    font-family:'Newsreader',serif;font-weight:200;
    font-size:clamp(2.3rem,4.6vw,3.6rem);line-height:1.04;letter-spacing:-.012em;
    max-width:15ch;color:var(--ink);margin:0;
  }
  #ed-revpage-{{ section.id }} .sec-head h2 em{font-style:italic;font-weight:300;color:var(--gold);}
  #ed-revpage-{{ section.id }} .sec-head__aside{
    flex:none;width:280px;padding-top:8px;border-top:1px solid var(--hairline);
  }
  #ed-revpage-{{ section.id }} .sec-head__aside p{
    font-size:14px;color:var(--body);line-height:1.7;padding-top:14px;
    font-weight:300;margin:0;
  }
  #ed-revpage-{{ section.id }} .reviews__grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--hairline);
    border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline);
  }
  #ed-revpage-{{ section.id }} .review{
    background:var(--paper);padding:42px 36px;display:flex;flex-direction:column;margin:0;
  }
  #ed-revpage-{{ section.id }} .review__stars{
    color:var(--gold);font-size:12px;letter-spacing:.28em;margin-bottom:22px;
  }
  #ed-revpage-{{ section.id }} .review__quote{
    font-family:'Newsreader',serif;font-weight:300;font-size:21px;line-height:1.5;
    letter-spacing:.005em;color:var(--ink);margin:0;
  }
  #ed-revpage-{{ section.id }} .review__quote .lead{font-style:italic;color:var(--gold);}
  #ed-revpage-{{ section.id }} .review__attr{margin-top:auto;padding-top:28px;}
  #ed-revpage-{{ section.id }} .review__name{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:12px;
    letter-spacing:.04em;color:var(--ink);
  }
  #ed-revpage-{{ section.id }} .review__loc{
    font-family:'Manrope',sans-serif;font-weight:400;font-size:11px;
    letter-spacing:.14em;text-transform:uppercase;color:var(--body);margin-top:5px;
  }
  #ed-revpage-{{ section.id }} .review__verified{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:9.5px;
    letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-top:9px;
  }
  #ed-revpage-{{ section.id }} .reviews__note{
    margin-top:24px;font-size:13px;color:var(--body);font-weight:300;
    max-width:60ch;
  }

  /* ---- Widget embed ---- */
  #ed-revpage-{{ section.id }} .widget{padding:96px 0 100px;}
  #ed-revpage-{{ section.id }} .widget__head{
    display:flex;align-items:baseline;gap:18px;
    border-top:1px solid var(--ink);padding-top:26px;margin-bottom:40px;
  }
  #ed-revpage-{{ section.id }} .widget__marker{
    font-family:'Newsreader',serif;font-weight:200;font-style:italic;
    font-size:clamp(1.6rem,3vw,2.4rem);color:var(--gold);line-height:1;
  }
  #ed-revpage-{{ section.id }} .widget__title{
    font-family:'Newsreader',serif;font-weight:300;
    font-size:clamp(1.5rem,2.6vw,2.1rem);line-height:1.2;color:var(--ink);margin:0;
  }
  #ed-revpage-{{ section.id }} #outlight-reviews{min-height:120px;}

  @media (max-width:880px){
    #ed-revpage-{{ section.id }} .ed-wrap{padding:0 22px;}
    #ed-revpage-{{ section.id }} .revhero__grid{
      grid-template-columns:1fr;gap:38px;align-items:start;
    }
    #ed-revpage-{{ section.id }} .guarantees{grid-template-columns:1fr 1fr;}
    #ed-revpage-{{ section.id }} .guar{padding:24px 18px 24px 0;}
    #ed-revpage-{{ section.id }} .guar:nth-child(odd){padding-left:0;border-left:none;}
    #ed-revpage-{{ section.id }} .guar:nth-child(even){
      border-left:1px solid var(--hairline);padding-left:18px;
    }
    #ed-revpage-{{ section.id }} .guar:nth-child(n+3){border-top:1px solid var(--hairline);}
    #ed-revpage-{{ section.id }} .revsection{padding-top:64px;}
    #ed-revpage-{{ section.id }} .sec-head{flex-direction:column;gap:20px;margin-bottom:40px;}
    #ed-revpage-{{ section.id }} .sec-head__aside{width:100%;}
    #ed-revpage-{{ section.id }} .reviews__grid{grid-template-columns:1fr;}
    #ed-revpage-{{ section.id }} .widget{padding:64px 0;}
  }
  @media (max-width:680px){
    #ed-revpage-{{ section.id }} .ed-wrap{padding:0 20px;}
    #ed-revpage-{{ section.id }} .revhero{padding-top:40px;}
    #ed-revpage-{{ section.id }} .revhero__eyebrow{margin-bottom:20px;gap:11px;}
    #ed-revpage-{{ section.id }} .revhero__eyebrow .rule{width:32px;}
    #ed-revpage-{{ section.id }} .revhero__eyebrow .ed-label{font-size:9.5px;letter-spacing:.18em;}
    #ed-revpage-{{ section.id }} .revhero__lede{max-width:none;}
    #ed-revpage-{{ section.id }} .revhero__num{font-size:64px;}
    #ed-revpage-{{ section.id }} .guarantees{margin-top:44px;}
    #ed-revpage-{{ section.id }} .guar__line{font-size:18px;}
    #ed-revpage-{{ section.id }} .marker{font-size:1.9rem;}
    #ed-revpage-{{ section.id }} .sec-head h2{max-width:none;}
    #ed-revpage-{{ section.id }} .review{padding:34px 24px;}
    #ed-revpage-{{ section.id }} .review__quote{font-size:19px;}
    #ed-revpage-{{ section.id }} .widget__head{flex-direction:column;gap:8px;}
  }
</style>

<section id="ed-revpage-{{ section.id }}">
  <div class="ed-wrap">

    {%- comment -%} ---- Hero / rating proof ---- {%- endcomment -%}
    <div class="revhero">
      {%- if s.eyebrow != blank -%}
        <div class="revhero__eyebrow">
          <span class="rule"></span>
          <span class="ed-label">{{ s.eyebrow | escape }}</span>
        </div>
      {%- endif -%}
      <div class="revhero__grid">
        <div class="revhero__type">
          {%- if s.heading != blank -%}
            <h1>{{ s.heading }}</h1>
          {%- endif -%}
          {%- if s.subheading != blank -%}
            <p class="revhero__lede">{{ s.subheading | escape }}</p>
          {%- endif -%}
        </div>
        <div class="revhero__score">
          <span class="revhero__num">{{ s.rating_display | escape }}</span>
          <div class="revhero__smeta">
            <span class="revhero__stars" aria-hidden="true">★★★★★</span>
            <span class="revhero__of">Average rating, out of 5</span>
            <span class="revhero__count">Across <b>{{ s.review_count | escape }}</b> reviews</span>
            {%- if s.review_source != blank -%}
              <span class="revhero__source">{{ s.review_source | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} ---- Guarantees strip ---- {%- endcomment -%}
    {%- if guarantee_blocks.size > 0 -%}
      <div class="guarantees">
        {%- for block in guarantee_blocks -%}
          <div class="guar" {{ block.shopify_attributes }}>
            <span class="guar__title">{{ block.settings.title | escape }}</span>
            <div class="guar__line">
              {%- if block.settings.emphasis != blank and block.settings.emphasis_position == 'after' -%}
                {{ block.settings.line | escape }} <em>{{ block.settings.emphasis | escape }}</em>
              {%- elsif block.settings.emphasis != blank -%}
                <em>{{ block.settings.emphasis | escape }}</em> {{ block.settings.line | escape }}
              {%- else -%}
                {{ block.settings.line | escape }}
              {%- endif -%}
            </div>
            {%- if block.settings.note != blank -%}
              <p class="guar__note">{{ block.settings.note | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---- Highlighted reviews ---- {%- endcomment -%}
    {%- if review_blocks.size > 0 -%}
      <div class="revsection">
        <div class="sec-head">
          {%- if s.reviews_marker != blank -%}
            <div class="sec-head__marker"><span class="marker">{{ s.reviews_marker | escape }}</span></div>
          {%- endif -%}
          <div class="sec-head__text">
            {%- if s.reviews_label != blank -%}
              <span class="sec-head__label ed-label">{{ s.reviews_label | escape }}</span>
            {%- endif -%}
            {%- if s.reviews_heading != blank -%}
              <h2>{{ s.reviews_heading }}</h2>
            {%- endif -%}
          </div>
          {%- if s.reviews_aside != blank -%}
            <div class="sec-head__aside">
              <p>{{ s.reviews_aside | escape }}</p>
            </div>
          {%- endif -%}
        </div>

        <div class="reviews__grid">
          {%- for block in review_blocks -%}
            <figure class="review" {{ block.shopify_attributes }}>
              <div class="review__stars" aria-hidden="true">★★★★★</div>
              <blockquote class="review__quote">
                {%- if block.settings.lead != blank -%}
                  <span class="lead">{{ block.settings.lead | escape }}</span>
                {%- endif -%}
                {{ block.settings.quote | escape }}
              </blockquote>
              <figcaption class="review__attr">
                <div class="review__name">{{ block.settings.name | escape }}</div>
                {%- if block.settings.role != blank -%}
                  <div class="review__loc">{{ block.settings.role | escape }}</div>
                {%- endif -%}
                <div class="review__verified">Verified Outlight customer</div>
              </figcaption>
            </figure>
          {%- endfor -%}
        </div>

        {%- if s.reviews_note != blank -%}
          <p class="reviews__note">{{ s.reviews_note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---- On-site review widget ---- {%- endcomment -%}
    <div class="widget">
      <div class="widget__head">
        {%- if s.widget_marker != blank -%}
          <span class="widget__marker">{{ s.widget_marker | escape }}</span>
        {%- endif -%}
        {%- if s.widget_title != blank -%}
          <h2 class="widget__title">{{ s.widget_title }}</h2>
        {%- endif -%}
      </div>
      <div id="outlight-reviews" data-product-handle=""></div>
    </div>

  </div>
</section>

<script src="https://shopify-ai-chatbot-production-9ab4.up.railway.app/widget/review-widget.js" defer></script>

