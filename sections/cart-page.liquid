{%- comment -%}
  Cart Page — Variation A: Minimal Split
  Clean rows, right-aligned summary, gold shipping progress
{%- endcomment -%}

{%- assign free_ship_threshold = settings.free_shipping_threshold | default: 200 -%}
{%- assign free_ship_cents = free_ship_threshold | times: 100 -%}
{%- assign remaining_cents = free_ship_cents | minus: cart.total_price -%}
{%- if remaining_cents < 0 -%}{%- assign remaining_cents = 0 -%}{%- endif -%}
{%- assign remaining_dollars = remaining_cents | divided_by: 100 -%}
{%- assign progress_pct = cart.total_price | times: 100 | divided_by: free_ship_cents -%}
{%- if progress_pct > 100 -%}{%- assign progress_pct = 100 -%}{%- endif -%}

<style>
  .cart-qty-btn { background:none !important; transition: color 0.15s ease; }
  .cart-qty-btn:hover { color: #131314 !important; }
</style>

<div style="background-color:#F9F9FB; min-height:60vh;" class="px-5 md:px-12" data-cart-page>
  <div class="max-w-[1920px] mx-auto" style="padding-top:40px;padding-bottom:80px;">

    {%- if cart.item_count > 0 -%}

      <!-- Header -->
      <div style="margin-bottom:6px;">
        <h1 class="heading-thin" style="font-size:2.2rem;color:#131314;">Your Cart</h1>
      </div>
      <p class="font-body" style="font-size:0.72rem;font-weight:300;color:#596065;margin-bottom:24px;">{{ cart.item_count }} item{{ cart.item_count | pluralize: '', 's' }}</p>

      <!-- Shipping progress -->
      <div style="margin-bottom:32px;max-width:480px;">
        {%- if remaining_cents > 0 -%}
          <p class="font-body" style="font-size:0.7rem;font-weight:300;color:#596065;margin-bottom:8px;">You're <strong style="color:#C5A059;font-weight:500;">${{ remaining_dollars }}</strong> away from free shipping</p>
        {%- else -%}
          <p class="font-body" style="font-size:0.7rem;font-weight:300;color:#596065;margin-bottom:8px;"><span style="color:#C5A059;">✓</span> You qualify for <strong style="color:#C5A059;font-weight:500;">free shipping!</strong></p>
        {%- endif -%}
        <div style="height:2px;background:rgba(19,19,20,0.06);position:relative;">
          <div style="height:100%;background:#C5A059;position:absolute;left:0;top:0;width:{{ progress_pct }}%;transition:width 0.5s ease;"></div>
        </div>
      </div>

      <!-- Cart items -->
      <div style="margin-bottom:40px;">
        {%- for item in cart.items -%}
          <div class="ol-cart-page-item flex gap-5 items-center" style="padding:24px 0;border-bottom:1px solid rgba(19,19,20,0.06);">
            <!-- Image -->
            <a href="{{ item.url }}" style="flex-shrink:0;width:80px;height:80px;overflow:hidden;display:block;">
              {%- if item.image -%}
                <img width="80" height="80" src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
              {%- else -%}
                <div style="width:100%;height:100%;background:linear-gradient(155deg,#e8ddd0,#d4c4b0);"></div>
              {%- endif -%}
            </a>
            <!-- Details -->
            <div style="flex:1;min-width:0;">
              <a href="{{ item.url }}" class="font-headline" style="font-weight:300;font-size:1rem;color:#131314;text-decoration:none;display:block;margin-bottom:2px;">{{ item.product.title | split: ' ' | first }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <span class="font-body" style="font-size:0.7rem;font-weight:300;color:#596065;">{{ item.variant.title }}</span>
              {%- endunless -%}
              <div style="margin-top:6px;">
                <a href="/cart/change?id={{ item.key }}&quantity=0" class="font-body" style="font-size:0.62rem;color:rgba(19,19,20,0.3);text-decoration:underline;text-underline-offset:2px;">Remove</a>
              </div>
            </div>
            <!-- Price -->
            <div class="hidden md:block font-headline" style="font-weight:300;font-size:1rem;color:#131314;min-width:90px;text-align:center;">
              {% render 'cart-line-price', item: item, unit: true %}
            </div>
            <!-- Qty -->
            <div class="flex items-center" style="border:1px solid rgba(19,19,20,0.06);">
              <a href="/cart/change?id={{ item.key }}&quantity={{ item.quantity | minus: 1 }}" class="cart-qty-btn flex items-center justify-center" style="width:28px;height:28px;font-size:0.8rem;color:rgba(19,19,20,0.3);border:none;text-decoration:none;text-align:center;line-height:28px;">−</a>
              <span class="font-body" style="width:28px;text-align:center;font-size:0.75rem;font-weight:400;color:#131314;border-left:1px solid rgba(19,19,20,0.06);border-right:1px solid rgba(19,19,20,0.06);line-height:28px;">{{ item.quantity }}</span>
              <a href="/cart/change?id={{ item.key }}&quantity={{ item.quantity | plus: 1 }}" class="cart-qty-btn flex items-center justify-center" style="width:28px;height:28px;font-size:0.8rem;color:rgba(19,19,20,0.3);border:none;text-decoration:none;text-align:center;line-height:28px;">+</a>
            </div>
            <!-- Line total -->
            <div class="font-headline" style="font-weight:300;font-size:1rem;color:#131314;min-width:80px;text-align:right;">
              {% render 'cart-line-price', item: item %}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <!-- Summary -->
      <div style="max-width:380px;margin-left:auto;">
        <div class="flex items-baseline justify-between" style="padding:16px 0;border-top:1px solid rgba(19,19,20,0.06);">
          <span class="heading-thin" style="font-size:1.1rem;color:#131314;">Subtotal</span>
          <span class="heading-thin" style="font-size:1.3rem;color:#131314;">{{ cart.total_price | money }}</span>
        </div>
        <p class="ol-cart-summary-note">{{ 'cart.shipping_note' | t }}</p>
{% render 'cart-purchase-assurance' %}
        <form action="/checkout" method="post">
          <button type="submit" class="font-label" style="display:flex;align-items:center;justify-content:center;width:100%;padding:15px;background:#131314;border:none;font-size:0.75rem;font-weight:500;text-transform:uppercase;letter-spacing:0.16em;color:#F9F9FB;cursor:pointer;margin-bottom:12px;transition:background 0.25s;" onmouseover="this.style.background='#C5A059'" onmouseout="this.style.background='#131314'">
            <span class="material-symbols-outlined ol-cart-checkout-icon" aria-hidden="true">lock</span>Proceed to Checkout
          </button>
        </form>

      </div>

    {%- else -%}

      <!-- Empty cart -->
      <div style="text-align:center;padding:80px 0 40px;">
        <h1 class="heading-thin" style="font-size:2.4rem;color:#131314;margin-bottom:8px;">Your cart is empty</h1>
        <p class="font-body" style="font-size:0.88rem;font-weight:300;color:#596065;margin-bottom:32px;">Not sure where to start? Try these collections:</p>
        <div class="flex justify-center gap-4" style="max-width:600px;margin:0 auto;">
          <a href="/collections/best-sellers" class="block" style="flex:1;text-decoration:none;">
            <div style="aspect-ratio:3/4;background:linear-gradient(155deg,#d4c4a8 0%,#b8a07a 40%,#a08960 100%);margin-bottom:12px;"></div>
            <span class="font-headline" style="font-weight:300;font-size:1rem;color:#131314;">Best Sellers</span>
          </a>
          <a href="/collections/best-sellers" class="block" style="flex:1;text-decoration:none;">
            <div style="aspect-ratio:3/4;background:linear-gradient(155deg,#c9b89a 0%,#a89070 40%,#8a7555 100%);margin-bottom:12px;"></div>
            <span class="font-headline" style="font-weight:300;font-size:1rem;color:#131314;">Clearance Sale</span>
          </a>
        </div>
      </div>

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "tag": "section",
  "class": "cart-page-section"
}
{% endschema %}

{% stylesheet %}
@media(max-width:767px){
  .ol-cart-page-item{display:grid;grid-template-columns:64px minmax(0,1fr) 80px;gap:8px 12px}
  .ol-cart-page-item>a:first-child{grid-column:1;grid-row:1/3;width:64px!important;height:64px!important}
  .ol-cart-page-item>div:nth-child(2){grid-column:2;grid-row:1}
  .ol-cart-page-item>div:nth-child(4){grid-column:2;grid-row:2;justify-self:start}
  .ol-cart-page-item>div:last-child{grid-column:3;grid-row:1/3}
}
{% endstylesheet %}
