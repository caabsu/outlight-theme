{%- liquid
  assign s = section.settings
  assign sale_code = s.sale_code | default: 'CLEARANCE60'
  assign discount_percent = s.discount_percent | default: 60
  assign sale_multiplier = 100 | minus: discount_percent
  assign product_handles = s.product_handles | default: 'aven,cade,calen,cielo,eira,fira,noa,olin,mira,aurevo,olin-shade' | split: ','
  assign available_count = 0
  assign hero_product = all_products[s.hero_product_handle]

  for raw_handle in product_handles
    assign handle = raw_handle | strip
    assign product_item = all_products[handle]
    if product_item != blank and product_item.available
      assign available_count = available_count | plus: 1
      if hero_product == blank or hero_product.featured_image == blank
        assign hero_product = product_item
      endif
    endif
  endfor
-%}

<style>
  #closing-sale-{{ section.id }}{
    --ink:#131314;
    --paper:#F9F9FB;
    --warm:#F3EEE8;
    --gold:#C5A059;
    --body:#2d3338;
    --sage:#65766E;
    --line:rgba(19,19,20,.12);
    --serif:'Newsreader',Georgia,serif;
    --sans:'Manrope',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    background:var(--paper);
    color:var(--ink);
    font-family:var(--sans);
  }
  #closing-sale-{{ section.id }} *{box-sizing:border-box;}
  #closing-sale-{{ section.id }} a{color:inherit;text-decoration:none;}
  #closing-sale-{{ section.id }} img{display:block;max-width:100%;}
  #closing-sale-{{ section.id }} .cs-wrap{
    width:100%;
    max-width:1320px;
    margin:0 auto;
    padding:0 32px;
  }
  #closing-sale-{{ section.id }} .cs-hero{
    position:relative;
    min-height:560px;
    overflow:hidden;
    background:var(--warm);
    isolation:isolate;
  }
  #closing-sale-{{ section.id }} .cs-hero__media{
    position:absolute;
    inset:0;
    z-index:-2;
  }
  #closing-sale-{{ section.id }} .cs-hero__media img{
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
  }
  #closing-sale-{{ section.id }} .cs-hero__media:after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(90deg,rgba(249,249,251,.98) 0%,rgba(249,249,251,.92) 38%,rgba(249,249,251,.48) 68%,rgba(249,249,251,.18) 100%);
    z-index:1;
  }
  #closing-sale-{{ section.id }} .cs-hero__inner{
    min-height:560px;
    display:flex;
    align-items:center;
    padding:64px 0;
  }
  #closing-sale-{{ section.id }} .cs-hero__copy{
    max-width:640px;
  }
  #closing-sale-{{ section.id }} .cs-eyebrow{
    display:inline-flex;
    align-items:center;
    gap:10px;
    font-size:11px;
    font-weight:600;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--sage);
    margin-bottom:22px;
  }
  #closing-sale-{{ section.id }} .cs-eyebrow:before{
    content:"";
    width:38px;
    height:1px;
    background:var(--gold);
  }
  #closing-sale-{{ section.id }} h1{
    font-family:var(--serif);
    font-weight:200;
    font-size:64px;
    line-height:1.04;
    letter-spacing:0;
    margin:0;
    color:var(--ink);
  }
  #closing-sale-{{ section.id }} h1 em{
    font-style:italic;
    font-weight:300;
    color:var(--gold);
  }
  #closing-sale-{{ section.id }} .cs-lede{
    margin:22px 0 0;
    max-width:46ch;
    color:var(--body);
    font-size:17px;
    line-height:1.7;
    font-weight:300;
  }
  #closing-sale-{{ section.id }} .cs-offer{
    display:flex;
    align-items:stretch;
    gap:1px;
    width:100%;
    max-width:540px;
    margin-top:30px;
    background:var(--line);
    border:1px solid var(--line);
  }
  #closing-sale-{{ section.id }} .cs-offer__cell{
    background:rgba(249,249,251,.94);
    padding:18px 20px;
    min-width:0;
  }
  #closing-sale-{{ section.id }} .cs-offer__cell:first-child{
    flex:0 0 190px;
  }
  #closing-sale-{{ section.id }} .cs-offer__number{
    font-family:var(--serif);
    font-size:44px;
    line-height:1;
    font-weight:300;
    color:var(--ink);
    white-space:nowrap;
  }
  #closing-sale-{{ section.id }} .cs-offer__label{
    display:block;
    margin-top:6px;
    font-size:10px;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--body);
  }
  #closing-sale-{{ section.id }} .cs-code{
    display:inline-flex;
    align-items:center;
    min-height:42px;
    padding:0 14px;
    border:1px solid var(--ink);
    font-size:12px;
    font-weight:700;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--ink);
    background:transparent;
    white-space:nowrap;
  }
  #closing-sale-{{ section.id }} .cs-offer__note{
    margin:10px 0 0;
    color:var(--body);
    font-size:12.5px;
    line-height:1.5;
    font-weight:300;
  }
  #closing-sale-{{ section.id }} .cs-actions{
    display:flex;
    gap:14px;
    flex-wrap:wrap;
    margin-top:28px;
  }
  #closing-sale-{{ section.id }} .cs-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:9px;
    min-height:50px;
    padding:0 24px;
    border:1px solid var(--ink);
    font-size:12px;
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    transition:background .2s ease,color .2s ease,border-color .2s ease;
  }
  #closing-sale-{{ section.id }} .cs-btn--primary{
    background:var(--ink);
    color:var(--paper);
  }
  #closing-sale-{{ section.id }} .cs-btn--primary:hover{
    background:var(--gold);
    border-color:var(--gold);
    color:var(--ink);
  }
  #closing-sale-{{ section.id }} .cs-btn--secondary{
    background:rgba(249,249,251,.72);
    color:var(--ink);
  }
  #closing-sale-{{ section.id }} .cs-btn--secondary:hover{
    background:var(--ink);
    color:var(--paper);
  }
  #closing-sale-{{ section.id }} .material-symbols-outlined{
    font-size:18px;
    line-height:1;
  }
  #closing-sale-{{ section.id }} .cs-band{
    border-top:1px solid var(--ink);
    border-bottom:1px solid var(--line);
    background:var(--paper);
  }
  #closing-sale-{{ section.id }} .cs-band__grid{
    display:grid;
    grid-template-columns:1.1fr .9fr .9fr;
    gap:1px;
    background:var(--line);
  }
  #closing-sale-{{ section.id }} .cs-band__item{
    background:var(--paper);
    padding:20px 26px;
  }
  #closing-sale-{{ section.id }} .cs-band__item strong{
    display:block;
    font-family:var(--serif);
    font-size:23px;
    line-height:1.15;
    font-weight:300;
    margin-bottom:8px;
  }
  #closing-sale-{{ section.id }} .cs-band__item span{
    display:block;
    color:var(--body);
    font-size:13.5px;
    line-height:1.55;
    font-weight:300;
  }
  #closing-sale-{{ section.id }} .cs-reason{
    padding:70px 0;
    background:var(--paper);
  }
  #closing-sale-{{ section.id }} .cs-reason__grid{
    display:grid;
    grid-template-columns:.88fr 1.12fr;
    gap:56px;
    align-items:start;
  }
  #closing-sale-{{ section.id }} .cs-section-label{
    display:block;
    color:var(--gold);
    font-size:11px;
    font-weight:600;
    letter-spacing:.18em;
    text-transform:uppercase;
    margin-bottom:18px;
  }
  #closing-sale-{{ section.id }} h2{
    font-family:var(--serif);
    font-weight:200;
    font-size:42px;
    line-height:1.12;
    letter-spacing:0;
    margin:0;
  }
  #closing-sale-{{ section.id }} h2 em{
    color:var(--gold);
    font-style:italic;
    font-weight:300;
  }
  #closing-sale-{{ section.id }} .cs-reason__copy{
    color:var(--body);
    font-size:15.5px;
    line-height:1.72;
    font-weight:300;
  }
  #closing-sale-{{ section.id }} .cs-reason__copy p{
    margin:0 0 18px;
  }
  #closing-sale-{{ section.id }} .cs-reason__copy p:last-child{
    margin-bottom:0;
  }
  #closing-sale-{{ section.id }} .cs-products{
    padding:72px 0 86px;
    background:#fff;
    border-top:1px solid var(--line);
  }
  #closing-sale-{{ section.id }} .cs-products__head{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:32px;
    margin-bottom:34px;
  }
  #closing-sale-{{ section.id }} .cs-products__intro{
    max-width:48ch;
    color:var(--body);
    font-size:15px;
    line-height:1.65;
    font-weight:300;
    margin:14px 0 0;
  }
  #closing-sale-{{ section.id }} .cs-count{
    color:var(--body);
    font-size:11px;
    font-weight:600;
    letter-spacing:.16em;
    text-transform:uppercase;
    white-space:nowrap;
  }
  #closing-sale-{{ section.id }} .cs-grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:34px 28px;
  }
  #closing-sale-{{ section.id }} .cs-card{
    display:flex;
    flex-direction:column;
    min-width:0;
    background:var(--paper);
    color:var(--ink);
    position:relative;
    text-decoration:none;
  }
  #closing-sale-{{ section.id }} .cs-card__media{
    position:relative;
    aspect-ratio:4/5;
    overflow:hidden;
    background:var(--warm);
  }
  #closing-sale-{{ section.id }} .cs-card__media img{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .9s cubic-bezier(.16,.84,.44,1);
  }
  #closing-sale-{{ section.id }} .cs-card:hover .cs-card__media img{
    transform:scale(1.045);
  }
  #closing-sale-{{ section.id }} .cs-card__ph{
    position:absolute;
    inset:0;
    background:linear-gradient(165deg,#e8ddd0 0%,#d4c4b0 100%);
  }
  #closing-sale-{{ section.id }} .cs-card__cat{
    position:absolute;
    left:14px;
    top:14px;
    background:rgba(249,249,251,.92);
    -webkit-backdrop-filter:blur(4px);
    backdrop-filter:blur(4px);
    color:var(--ink);
    font-size:9.5px;
    font-weight:500;
    letter-spacing:.15em;
    text-transform:uppercase;
    padding:6px 10px;
  }
  #closing-sale-{{ section.id }} .cs-card__flag{
    position:absolute;
    right:14px;
    top:14px;
    background:var(--ink);
    color:var(--paper);
    font-size:9px;
    font-weight:500;
    letter-spacing:.12em;
    text-transform:uppercase;
    padding:5px 9px;
  }
  #closing-sale-{{ section.id }} .cs-card__arrow{
    position:absolute;
    right:14px;
    bottom:14px;
    width:38px;
    height:38px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:var(--ink);
    color:var(--paper);
    border-radius:50%;
    font-size:14px;
    line-height:1;
    opacity:0;
    transform:translateY(8px);
    transition:opacity .4s ease,transform .4s cubic-bezier(.16,.84,.44,1);
  }
  #closing-sale-{{ section.id }} .cs-card:hover .cs-card__arrow{
    opacity:1;
    transform:none;
  }
  #closing-sale-{{ section.id }} .cs-card__body{
    display:flex;
    flex-direction:column;
    gap:8px;
    padding:16px 2px 0;
  }
  #closing-sale-{{ section.id }} .cs-card__title{
    font-family:var(--serif);
    font-size:25px;
    line-height:1.1;
    font-weight:300;
    color:var(--ink);
  }
  #closing-sale-{{ section.id }} .cs-card__prices{
    display:flex;
    align-items:baseline;
    flex-wrap:wrap;
    gap:9px;
    font-family:var(--serif);
    font-weight:300;
    font-size:20px;
    color:var(--ink);
  }
  #closing-sale-{{ section.id }} .cs-card__prices .was{
    font-size:14px;
    color:var(--body);
    opacity:.56;
    text-decoration:line-through;
  }
  #closing-sale-{{ section.id }} .cs-card__prices .now{
    color:var(--gold);
  }
  #closing-sale-{{ section.id }} .cs-empty{
    grid-column:1 / -1;
    padding:56px 0;
    color:var(--body);
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    font-size:15px;
    line-height:1.6;
  }
  #closing-sale-{{ section.id }} .cs-faq{
    padding:68px 0 76px;
    background:var(--warm);
    border-top:1px solid var(--line);
  }
  #closing-sale-{{ section.id }} .cs-faq__grid{
    display:grid;
    grid-template-columns:.82fr 1.18fr;
    gap:70px;
  }
  #closing-sale-{{ section.id }} details{
    border-top:1px solid rgba(19,19,20,.18);
  }
  #closing-sale-{{ section.id }} details:last-child{
    border-bottom:1px solid rgba(19,19,20,.18);
  }
  #closing-sale-{{ section.id }} summary{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;
    cursor:pointer;
    list-style:none;
    padding:22px 0;
    color:var(--ink);
    font-family:var(--serif);
    font-size:22px;
    line-height:1.24;
    font-weight:300;
  }
  #closing-sale-{{ section.id }} summary::-webkit-details-marker{
    display:none;
  }
  #closing-sale-{{ section.id }} summary .material-symbols-outlined{
    color:var(--gold);
    transition:transform .2s ease;
  }
  #closing-sale-{{ section.id }} details[open] summary .material-symbols-outlined{
    transform:rotate(45deg);
  }
  #closing-sale-{{ section.id }} details p{
    margin:0;
    padding:0 0 24px;
    color:var(--body);
    font-size:15px;
    line-height:1.75;
    font-weight:300;
  }
  @media (max-width:1100px){
    #closing-sale-{{ section.id }} h1{font-size:52px;}
    #closing-sale-{{ section.id }} .cs-grid{grid-template-columns:repeat(3,minmax(0,1fr));}
    #closing-sale-{{ section.id }} .cs-reason__grid,
    #closing-sale-{{ section.id }} .cs-faq__grid{gap:48px;}
  }
  @media (max-width:820px){
    #closing-sale-{{ section.id }} .cs-wrap{padding:0 22px;}
    #closing-sale-{{ section.id }} .cs-hero,
    #closing-sale-{{ section.id }} .cs-hero__inner{min-height:560px;}
    #closing-sale-{{ section.id }} .cs-hero__media:after{
      background:linear-gradient(180deg,rgba(249,249,251,.98) 0%,rgba(249,249,251,.9) 52%,rgba(249,249,251,.42) 100%);
    }
    #closing-sale-{{ section.id }} h1{font-size:42px;}
    #closing-sale-{{ section.id }} h2{font-size:34px;}
    #closing-sale-{{ section.id }} .cs-offer{
      flex-direction:column;
      max-width:420px;
    }
    #closing-sale-{{ section.id }} .cs-offer__cell:first-child{
      flex:auto;
    }
    #closing-sale-{{ section.id }} .cs-band__grid,
    #closing-sale-{{ section.id }} .cs-reason__grid,
    #closing-sale-{{ section.id }} .cs-faq__grid{
      grid-template-columns:1fr;
    }
    #closing-sale-{{ section.id }} .cs-products__head{
      align-items:flex-start;
      flex-direction:column;
      gap:14px;
    }
    #closing-sale-{{ section.id }} .cs-grid{
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:32px 18px;
    }
  }
  @media (max-width:520px){
    #closing-sale-{{ section.id }} .cs-wrap{padding:0 18px;}
    #closing-sale-{{ section.id }} .cs-hero,
    #closing-sale-{{ section.id }} .cs-hero__inner{min-height:0;}
    #closing-sale-{{ section.id }} .cs-hero__inner{padding:56px 0 64px;}
    #closing-sale-{{ section.id }} h1{font-size:34px;}
    #closing-sale-{{ section.id }} .cs-lede{font-size:15px;}
    #closing-sale-{{ section.id }} .cs-actions{flex-direction:column;}
    #closing-sale-{{ section.id }} .cs-btn{width:100%;}
    #closing-sale-{{ section.id }} .cs-band__item{padding:22px 18px;}
    #closing-sale-{{ section.id }} .cs-reason,
    #closing-sale-{{ section.id }} .cs-products,
    #closing-sale-{{ section.id }} .cs-faq{padding:58px 0;}
    #closing-sale-{{ section.id }} .cs-grid{
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:26px 14px;
    }
    #closing-sale-{{ section.id }} .cs-card__cat{left:9px;top:9px;font-size:8.5px;padding:5px 8px;}
    #closing-sale-{{ section.id }} .cs-card__flag{right:9px;top:9px;font-size:8px;padding:4px 7px;}
    #closing-sale-{{ section.id }} .cs-card__arrow{width:32px;height:32px;right:9px;bottom:9px;font-size:12px;}
    #closing-sale-{{ section.id }} .cs-card__body{padding:12px 0 0;gap:6px;}
    #closing-sale-{{ section.id }} .cs-card__title{font-size:19px;}
    #closing-sale-{{ section.id }} .cs-card__prices{font-size:17px;}
    #closing-sale-{{ section.id }} .cs-card__prices .was{font-size:12px;}
  }
</style>

<section id="closing-sale-{{ section.id }}" aria-labelledby="closing-sale-title-{{ section.id }}">
  <div class="cs-hero">
    <div class="cs-hero__media" aria-hidden="true">
      {%- if s.hero_image != blank -%}
        {{ s.hero_image | image_url: width: 2200 | image_tag: loading: 'eager', width: 2200, height: 1500, alt: '' }}
      {%- elsif hero_product != blank and hero_product.featured_image != blank -%}
        {{ hero_product.featured_image | image_url: width: 2200 | image_tag: loading: 'eager', width: 2200, height: 1500, alt: '' }}
      {%- endif -%}
    </div>
    <div class="cs-wrap">
      <div class="cs-hero__inner">
        <div class="cs-hero__copy">
          {%- if s.eyebrow != blank -%}
            <span class="cs-eyebrow">{{ s.eyebrow | escape }}</span>
          {%- endif -%}
          <h1 id="closing-sale-title-{{ section.id }}">{{ s.heading }}</h1>
          {%- if s.lede != blank -%}
            <p class="cs-lede">{{ s.lede | escape }}</p>
          {%- endif -%}
          <div class="cs-offer" aria-label="Fall sale offer">
            <div class="cs-offer__cell">
              <span class="cs-offer__number">{{ discount_percent }}% off</span>
              <span class="cs-offer__label">clearance sale</span>
            </div>
            <div class="cs-offer__cell">
              <span class="cs-code">No code needed</span>
              <p class="cs-offer__note">Prices shown include 60% off. No code needed.</p>
            </div>
          </div>
          <div class="cs-actions">
            <a class="cs-btn cs-btn--primary" href="#sale-collection-{{ section.id }}">
              Shop the sale
              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
            <a class="cs-btn cs-btn--secondary" href="/pages/support-center">
              Questions?
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="cs-band">
    <div class="cs-wrap">
      <div class="cs-band__grid">
        <div class="cs-band__item">
          <strong>{{ available_count }} styles to explore</strong>
          <span>Find the right light for your space.</span>
        </div>
        <div class="cs-band__item">
          <strong>Automatic savings</strong>
          <span>{{ discount_percent }}% off at checkout.</span>
        </div>
        <div class="cs-band__item">
          <strong>Here to help</strong>
          <span>Get help choosing a light or tracking an order.</span>
        </div>
      </div>
    </div>
  </div>

  <div class="cs-reason">
    <div class="cs-wrap">
      <div class="cs-reason__grid">
        <div>
          <span class="cs-section-label">{{ s.reason_label | escape }}</span>
          <h2>{{ s.reason_heading }}</h2>
        </div>
        <div class="cs-reason__copy">
          {{ s.reason_copy }}
        </div>
      </div>
    </div>
  </div>

  <div class="cs-products" id="sale-collection-{{ section.id }}">
    <div class="cs-wrap">
      <div class="cs-products__head">
        <div>
          <span class="cs-section-label">The collection</span>
          <h2>Lighting for fall.</h2>
          <p class="cs-products__intro">Explore our lighting collection. Prices shown include the 60% Clearance Sale discount.</p>
        </div>
        <span class="cs-count">{{ available_count }} styles to explore</span>
      </div>

      <div class="cs-grid">
        {%- assign rendered_products = 0 -%}
        {%- for raw_handle in product_handles -%}
          {%- liquid
            assign handle = raw_handle | strip
            assign product_item = all_products[handle]
          -%}
          {%- if product_item != blank and product_item.available -%}
            {%- liquid
              assign rendered_products = rendered_products | plus: 1
              assign sale_variant = product_item.selected_or_first_available_variant
              for variant in product_item.variants
                if variant.available
                  assign sale_variant = variant
                  break
                endif
              endfor
              assign sale_price = sale_variant.price | times: sale_multiplier | divided_by: 100
              assign product_kind = product_item.type | default: 'Lighting'
              case product_item.handle
                when 'aven', 'cade', 'calen', 'eira', 'fira', 'noa', 'olin'
                  assign product_kind = 'Floor lamp'
                when 'cielo', 'olin-shade'
                  assign product_kind = 'Table lamp'
                when 'mira', 'aurevo'
                  assign product_kind = 'Outdoor wall light'
              endcase
            -%}
            <a class="cs-card" href="{{ product_item.url }}" aria-label="{{ product_item.title | escape }}">
              <div class="cs-card__media">
                {%- if product_item.featured_image != blank -%}
                  <img
                    src="{{ product_item.featured_image | image_url: width: 700 }}"
                    srcset="{{ product_item.featured_image | image_url: width: 400 }} 400w, {{ product_item.featured_image | image_url: width: 700 }} 700w"
                    sizes="(max-width:680px) 50vw, 320px"
                    alt="{{ product_item.featured_image.alt | escape | default: product_item.title }}"
                    width="{{ product_item.featured_image.width }}"
                    height="{{ product_item.featured_image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="cs-card__ph"></div>
                {%- endif -%}
                <span class="cs-card__cat">{{ product_kind | escape }}</span>
                <span class="cs-card__flag">{{ discount_percent }}% off</span>
                <span class="cs-card__arrow" aria-hidden="true">&rarr;</span>
              </div>
              <div class="cs-card__body">
                <span class="cs-card__title">{{ product_item.title | split: ' ' | first | escape }}</span>
                <span class="cs-card__prices">
                  <span class="was">{{ sale_variant.price | money }}</span>
                  <span class="now">{{ sale_price | money }}</span>
                </span>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
        {%- if rendered_products == 0 -%}
          <div class="cs-empty">
            Nothing is available right now. Contact support if you have an order question.
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="cs-faq">
    <div class="cs-wrap">
      <div class="cs-faq__grid">
        <div>
          <span class="cs-section-label">Before you order</span>
          <h2>A few practical notes.</h2>
        </div>
        <div>
          <details open>
            <summary>
              How do I choose the right light?
              <span class="material-symbols-outlined" aria-hidden="true">add</span>
            </summary>
            <p>Check each product page for dimensions, finishes, and light specifications. Our support team can help with product questions.</p>
          </details>
          <details>
            <summary>
              How do I get the 60% discount?
              <span class="material-symbols-outlined" aria-hidden="true">add</span>
            </summary>
            <p>Prices shown include 60% off. Your clearance discount is applied automatically—no code needed.</p>
          </details>
          <details>
            <summary>
              Do I need a discount code?
              <span class="material-symbols-outlined" aria-hidden="true">add</span>
            </summary>
            <p>No code is needed. Your Clearance Sale savings are applied automatically to eligible lighting at checkout.</p>
          </details>
          <details>
            <summary>
              How can I contact support?
              <span class="material-symbols-outlined" aria-hidden="true">add</span>
            </summary>
            <p>Visit our support center for help with products, delivery, or an existing order.</p>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

