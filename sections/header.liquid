<!-- ============================================================
   Outlight — Header Section
   Includes: desktop nav, mobile nav, mega menu, mobile full-screen
   menu, and cart drawer trigger.
   ============================================================ -->

{%- liquid
  assign transparent_on_home = section.settings.transparent_header
  assign header_logo = section.settings.logo_image | default: settings.logo_image
  assign header_logo_light = settings.logo_image_light
  assign header_logo_height = section.settings.logo_width
  assign header_logo_light_height = section.settings.logo_width

  if header_logo != blank and header_logo.aspect_ratio != blank
    assign header_logo_height = section.settings.logo_width | divided_by: header_logo.aspect_ratio | round
  endif

  if header_logo_light != blank and header_logo_light.aspect_ratio != blank
    assign header_logo_light_height = section.settings.logo_width | divided_by: header_logo_light.aspect_ratio | round
  endif
-%}

{%- comment -%} Announcement bar + global header offsets (CSS-variable driven) {%- endcomment -%}
<style>
  :root{ --ann-h:40px; --hdr-h:72px; }
  @media (min-width:768px){ :root{ --hdr-h:88px; } }
  html.ann-dismissed{ --ann-h:0px; }
  #ann-bar{
    position:fixed; top:0; left:0; right:0; z-index:51;
    height:var(--ann-h); overflow:hidden;
    background:#131314; color:#F9F9FB;
    display:flex; align-items:center; justify-content:center;
    transition:height .25s ease;
  }
  #ann-bar p{
    font-family:'Manrope',sans-serif; margin:0; padding:0 46px; text-align:center;
    font-size:11px; font-weight:400; letter-spacing:.07em; text-transform:none;
  }
  #ann-bar p strong{ color:#ead1a5; font-weight:500; }
  #ann-bar a{
    color:inherit; text-decoration:none; display:inline-flex; align-items:center; justify-content:center;
    min-height:100%;
  }
  #ann-bar a:hover strong{ color:#d7b66d; }
  #ann-bar .ann-close{
    position:absolute; right:14px; top:50%; transform:translateY(-50%);
    background:none; border:none; color:#F9F9FB; opacity:.6; cursor:pointer;
    font-size:20px; line-height:1; padding:6px;
  }
  #ann-bar .ann-close:hover{ opacity:1; }
  #site-header{ top:var(--ann-h) !important; }
  #site-header > nav{
    max-width:1360px !important;
    padding-left:20px !important; padding-right:20px !important;
  }
  @media (min-width:768px){
    #site-header > nav{ padding-left:32px !important; padding-right:32px !important; }
  }
  #mega-menu, #search-overlay{ top:calc(var(--ann-h) + var(--hdr-h)) !important; }
  #main-content{
    padding-top:calc(var(--ann-h) + var(--hdr-h));
    transition:padding-top .25s ease;
  }
  @media (max-width:400px){
    #ann-bar p{ font-size:10px; letter-spacing:.03em; padding:0 38px; }
  }
</style>
<script>
  (function(){ try{ if(localStorage.getItem('ol_ann_dismissed')==='1'){ document.documentElement.classList.add('ann-dismissed'); } }catch(e){} })();
</script>
<div id="ann-bar" role="region" aria-label="Store announcement">
  <a href="/collections/best-sellers" aria-label="Shop the Outlight Clearance Sale">
    <p>Clearance Sale <span aria-hidden="true">&nbsp;·&nbsp;</span> <strong>60% off all lighting</strong></p>
  </a>
  <button class="ann-close" type="button" aria-label="Dismiss announcement" onclick="document.documentElement.classList.add('ann-dismissed');try{localStorage.setItem('ol_ann_dismissed','1');}catch(e){}">&times;</button>
</div>

<header id="site-header" data-transparent-home="{% if template.name == 'index' and transparent_on_home %}true{% else %}false{% endif %}" class="fixed top-0 left-0 right-0 z-50 bg-[#F9F9FB] transition-all duration-500{% if template.name == 'index' and transparent_on_home %} header-wrapper--transparent{% endif %}">
  <nav class="flex justify-between items-center w-full px-5 md:px-12 py-4 md:py-6 max-w-[1920px] mx-auto">

    <!-- Mobile: hamburger LEFT -->
    <button
      class="md:hidden text-[#2d3338]"
      aria-label="Open menu"
      onclick="document.getElementById('mobile-menu').classList.add('open');document.getElementById('menu-backdrop').classList.add('open');"
    >
      <span class="material-symbols-outlined text-2xl">menu</span>
    </button>

    <!-- Desktop: logo LEFT -->
    <div class="hidden md:block font-headline text-[1.25rem] font-light text-[#131314] tracking-tight">
      <a href="{{ routes.root_url }}">
        {%- if header_logo != blank -%}
          {%- if template.name == 'index' and transparent_on_home and header_logo_light != blank -%}
            <img
              id="desktop-logo-light"
              src="{{ header_logo_light | image_url: width: section.settings.logo_width }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="{{ header_logo_light_height }}"
              loading="eager"
              class="block"
            >
            <img
              id="desktop-logo-dark"
              src="{{ header_logo | image_url: width: section.settings.logo_width }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="{{ header_logo_height }}"
              loading="eager"
              class="block hidden"
            >
          {%- else -%}
            <img
              src="{{ header_logo | image_url: width: section.settings.logo_width }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="{{ header_logo_height }}"
              loading="eager"
              class="block"
            >
          {%- endif -%}
        {%- else -%}
          Outlight
        {%- endif -%}
      </a>
    </div>

    <!-- Mobile: logo CENTERED (absolute) -->
    <div class="md:hidden font-headline text-[1.1rem] font-light text-[#131314] tracking-tight absolute left-1/2 -translate-x-1/2">
      <a href="{{ routes.root_url }}">
        {%- if header_logo != blank -%}
          {%- if template.name == 'index' and transparent_on_home and header_logo_light != blank -%}
            <img
              id="mobile-logo-light"
              src="{{ header_logo_light | image_url: width: section.settings.logo_width }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="{{ header_logo_light_height }}"
              loading="eager"
              class="block"
            >
            <img
              id="mobile-logo-dark"
              src="{{ header_logo | image_url: width: section.settings.logo_width }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="{{ header_logo_height }}"
              loading="eager"
              class="block hidden"
            >
          {%- else -%}
            <img
              src="{{ header_logo | image_url: width: section.settings.logo_width }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="{{ header_logo_height }}"
              loading="eager"
              class="block"
            >
          {%- endif -%}
        {%- else -%}
          Outlight
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop: nav CENTER -->
    <div class="hidden md:flex items-center gap-8">
      <button
        id="shop-trigger"
        class="font-label text-[0.75rem] uppercase tracking-[0.1em] text-[#2d3338]/60 hover:text-[#131314] transition-colors duration-300"
        aria-haspopup="true"
        aria-expanded="false"
        onclick="
          var mm = document.getElementById('mega-menu');
          var hdr = document.getElementById('site-header');
          mm.classList.toggle('open');
          document.getElementById('mega-backdrop').classList.toggle('open');
          var isOpen = mm.classList.contains('open');
          this.setAttribute('aria-expanded', isOpen);
          if (isOpen) {
            hdr.classList.remove('header-wrapper--transparent');
            hdr.classList.add('header-mega-open');
          } else if (window.scrollY <= 80 && hdr.dataset.transparentHome === 'true') {
            hdr.classList.add('header-wrapper--transparent');
            hdr.classList.remove('header-mega-open');
          } else {
            hdr.classList.remove('header-mega-open');
          }
        "
      >{{ section.settings.nav1_label | default: 'Shop' }}</button>

      <a
        href="{{ section.settings.nav2_url | default: '/pages/about-us' }}"
        class="font-label text-[0.75rem] uppercase tracking-[0.1em] text-[#2d3338]/60 hover:text-[#131314] transition-colors duration-300"
      >{{ section.settings.nav2_label | default: 'About Us' }}</a>

      <a
        href="{{ section.settings.nav3_url | default: '/pages/support-center' }}"
        class="font-label text-[0.75rem] uppercase tracking-[0.1em] text-[#2d3338]/60 hover:text-[#131314] transition-colors duration-300"
      >{{ section.settings.nav3_label | default: 'Support' }}</a>

      <a
        href="{{ section.settings.nav4_url | default: '/pages/trade-program-application' }}"
        class="font-label text-[0.75rem] uppercase tracking-[0.1em] text-[#2d3338]/60 hover:text-[#131314] transition-colors duration-300"
      >{{ section.settings.nav4_label | default: 'Trade' }}</a>

      {%- if section.settings.nav5_label != blank -%}
        <a
          href="{{ section.settings.nav5_url | default: '/collections/best-sellers' }}"
          class="font-label text-[0.75rem] uppercase tracking-[0.1em] text-[#C5A059] hover:text-[#b8903f] transition-colors duration-300"
        >{{ section.settings.nav5_label }}</a>
      {%- endif -%}
    </div>

    <!-- Icons RIGHT -->
    <div class="flex items-center gap-4">
      <!-- Search (desktop only) -->
      <button
        type="button"
        class="hidden md:flex text-[#2d3338] hover:opacity-80 transition-opacity duration-300"
        aria-label="Search"
        onclick="openSearchOverlay()"
      >
        <span class="material-symbols-outlined text-[1.4rem]">search</span>
      </button>

      <!-- Account (desktop only) -->
      <a
        href="{{ routes.account_url }}"
        class="hidden md:flex text-[#2d3338] hover:opacity-80 transition-opacity duration-300"
        aria-label="Account"
      >
        <span class="material-symbols-outlined text-[1.4rem]">person</span>
      </a>

      <!-- Cart — triggers cart drawer -->
      <button
        class="relative text-[#2d3338] hover:opacity-80 transition-opacity duration-300"
        aria-label="Open cart"
        onclick="document.getElementById('cart-drawer').classList.add('open');document.getElementById('cart-backdrop').classList.add('open');"
      >
        <span class="material-symbols-outlined text-2xl">shopping_bag</span>
        {%- if cart.item_count > 0 -%}
          <span
            id="cart-count-badge"
            class="absolute -top-1 -right-1 w-4 h-4 flex items-center justify-center bg-[#C5A059] text-white font-label text-[0.45rem] leading-none"
          >{{ cart.item_count }}</span>
        {%- endif -%}
      </button>
    </div>

  </nav>
</header>


<!-- ============================================================
   Mega menu backdrop
   ============================================================ -->
<div
  id="mega-backdrop"
  class="overlay-backdrop fixed inset-0 bg-[#131314]/20 z-[45]"
  onclick="
    document.getElementById('mega-menu').classList.remove('open');
    this.classList.remove('open');
    document.getElementById('shop-trigger').setAttribute('aria-expanded', 'false');
    var hdr = document.getElementById('site-header');
    hdr.classList.remove('header-mega-open');
    if (window.scrollY <= 80 && hdr.dataset.transparentHome === 'true') {
      hdr.classList.add('header-wrapper--transparent');
    }
  "
></div>


<!-- ============================================================
   Mega menu dropdown
   ============================================================ -->
<div id="mega-menu" class="mega-menu fixed top-[72px] md:top-[88px] left-0 right-0 z-[48] bg-[#F9F9FB] border-t border-[#131314]/5 shadow-lg">
  <div class="max-w-[1920px] mx-auto px-12 py-10 grid grid-cols-12 gap-10">

    <!-- Indoor Lighting -->
    <div class="col-span-2">
      <span class="font-label text-[0.6rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-4">Indoor</span>
      <div class="w-full h-px bg-[#131314]/6 mb-5"></div>
      <ul class="space-y-3">
        <li><a href="{{ routes.collections_url }}/floor-table-lamps" class="font-headline text-[1rem] font-[300] text-[#2d3338]/60 hover:text-[#131314] transition-colors">Floor Lamps</a></li>
        <li><a href="{{ routes.collections_url }}/desk-lamp"      class="font-headline text-[1rem] font-[300] text-[#2d3338]/60 hover:text-[#131314] transition-colors">Table &amp; Bedside Lamps</a></li>
        <li><a href="{{ routes.collections_url }}/indoor-wall-lights" class="font-headline text-[1rem] font-[300] text-[#2d3338]/60 hover:text-[#131314] transition-colors">Wall Lights</a></li>
      </ul>
    </div>

    <!-- Outdoor Lighting -->
    <div class="col-span-2">
      <span class="font-label text-[0.6rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-4">Outdoor</span>
      <div class="w-full h-px bg-[#131314]/6 mb-5"></div>
      <ul class="space-y-3">
        <li><a href="{{ routes.collections_url }}/wall-lights" class="font-headline text-[1rem] font-[300] text-[#2d3338]/60 hover:text-[#131314] transition-colors">Outdoor Wall Lights</a></li>
        <li><a href="{{ routes.collections_url }}/outdoor-lighting" class="font-headline text-[1rem] font-[300] text-[#2d3338]/60 hover:text-[#131314] transition-colors">Outdoor Lighting</a></li>
        <li><a href="{{ routes.collections_url }}/path-lights"         class="font-headline text-[1rem] font-[300] text-[#2d3338]/60 hover:text-[#131314] transition-colors">Path &amp; Landscape</a></li>
      </ul>
    </div>

    <!-- Promo cards -->
    <div class="col-span-8 grid grid-cols-2 gap-4">

      <a href="{{ routes.collections_url }}/best-sellers" class="block relative overflow-hidden group" style="aspect-ratio:16/9;">
        {%- if section.settings.mega_image_1 != blank -%}
          <img src="{{ section.settings.mega_image_1 | image_url: width: 800 }}" alt="Best Sellers" width="800" height="450" class="absolute inset-0 w-full h-full object-cover" loading="lazy">
        {%- else -%}
          <div class="mega-img absolute inset-0 w-full h-full"></div>
        {%- endif -%}
        <div class="absolute inset-0 bg-gradient-to-t from-[#131314]/60 via-transparent to-transparent"></div>
        <div class="absolute bottom-5 left-5">
          <span class="font-label text-[0.5rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-1">Shop Now</span>
          <span class="font-headline text-xl font-[200] text-white group-hover:text-[#C5A059] transition-colors">Best Sellers</span>
        </div>
      </a>

      <a href="/collections/best-sellers" class="block relative overflow-hidden group" style="aspect-ratio:16/9;">
        {%- if section.settings.mega_image_2 != blank -%}
          <img src="{{ section.settings.mega_image_2 | image_url: width: 800 }}" alt="Clearance Sale" width="800" height="450" class="absolute inset-0 w-full h-full object-cover" loading="lazy">
        {%- else -%}
          <div class="mega-img-2 absolute inset-0 w-full h-full"></div>
        {%- endif -%}
        <div class="absolute inset-0 bg-gradient-to-t from-[#131314]/60 via-transparent to-transparent"></div>
        <div class="absolute bottom-5 left-5">
          <span class="font-label text-[0.5rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-1">Shop Now</span>
          <span class="font-headline text-xl font-[200] text-white group-hover:text-[#C5A059] transition-colors">Clearance Sale</span>
        </div>
      </a>

    </div>
  </div>
</div>


<!-- ============================================================
   Search overlay (desktop)
   ============================================================ -->
<style>
  .ol-search-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }
  .ol-search-panel.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>
<div
  id="search-backdrop"
  class="overlay-backdrop fixed inset-0 bg-[#131314]/20 z-[46]"
  onclick="closeSearchOverlay()"
></div>
<div id="search-overlay" class="ol-search-panel fixed top-[72px] md:top-[88px] left-0 right-0 z-[47] bg-[#F9F9FB] border-t border-[#131314]/5 shadow-lg">
  <div class="max-w-[1920px] mx-auto px-5 md:px-12 py-6">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <div class="flex items-center gap-4 border-b border-[#131314]/15 pb-3">
        <span class="material-symbols-outlined text-[#2d3338]/50">search</span>
        <input
          id="search-overlay-input"
          type="search"
          name="q"
          placeholder="Search floor lamps, wall lights, outdoor…"
          class="flex-1 bg-transparent border-none outline-none font-body text-[1rem] font-light text-[#131314] placeholder:text-[#2d3338]/40 focus:ring-0 p-0"
        >
        <button type="button" aria-label="Close search" onclick="closeSearchOverlay()" class="text-[#2d3338]/50 hover:text-[#131314] transition-colors">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
    </form>
  </div>
</div>


<!-- ============================================================
   Mobile menu backdrop
   ============================================================ -->
<div
  id="menu-backdrop"
  class="overlay-backdrop fixed inset-0 bg-[#131314]/40 z-[60]"
  onclick="
    document.getElementById('mobile-menu').classList.remove('open');
    this.classList.remove('open');
  "
></div>


<!-- ============================================================
   Mobile menu — V1 Full Screen
   ============================================================ -->
<div id="mobile-menu" class="mobile-menu fixed top-0 left-0 right-0 bottom-0 w-full bg-[#F9F9FB] z-[70] flex flex-col overflow-y-auto">

  <!-- Header row -->
  <div class="flex items-center justify-between px-5 py-4 border-b border-[#131314]/5">
    <span class="font-headline text-[1.1rem] font-light text-[#131314] tracking-tight">
      {%- if header_logo != blank -%}
        <img
          src="{{ header_logo | image_url: width: section.settings.logo_width }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width }}"
          height="{{ header_logo_height }}"
          loading="lazy"
          class="block"
        >
      {%- else -%}
        Outlight
      {%- endif -%}
    </span>
    <button
      aria-label="Close menu"
      onclick="document.getElementById('mobile-menu').classList.remove('open');document.getElementById('menu-backdrop').classList.remove('open');"
    >
      <span class="material-symbols-outlined text-[#2d3338] text-xl">close</span>
    </button>
  </div>

  <!-- Search -->
  <div class="px-5 py-4 border-b border-[#131314]/5">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <div class="flex items-center gap-3 border border-[#131314]/8 px-4 py-2.5">
        <span class="material-symbols-outlined text-[#2d3338]/60 text-lg">search</span>
        <input
          type="search"
          name="q"
          placeholder="What can we help you find?"
          class="flex-1 bg-transparent border-none outline-none font-body text-[0.82rem] font-light text-[#131314] placeholder:text-[#2d3338]/60 focus:ring-0 p-0"
        />
      </div>
    </form>
  </div>

  <!-- Indoor Lighting -->
  <div class="px-5 pt-6 pb-4">
    <span class="font-label text-[0.55rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-3">Indoor</span>
    <div class="h-px bg-[#C5A059]/20 mb-4"></div>
    <div class="space-y-4">
      <a href="{{ routes.collections_url }}/floor-table-lamps" class="font-headline text-[1.05rem] font-[300] text-[#2d3338]/55 block">Floor Lamps</a>
      <a href="{{ routes.collections_url }}/desk-lamp"      class="font-headline text-[1.05rem] font-[300] text-[#2d3338]/55 block">Table &amp; Bedside Lamps</a>
      <a href="{{ routes.collections_url }}/indoor-wall-lights" class="font-headline text-[1.05rem] font-[300] text-[#2d3338]/55 block">Wall Lights</a>
    </div>
  </div>

  <!-- Outdoor Lighting -->
  <div class="px-5 pb-4">
    <span class="font-label text-[0.55rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-3">Outdoor</span>
    <div class="h-px bg-[#C5A059]/20 mb-4"></div>
    <div class="space-y-4">
      <a href="{{ routes.collections_url }}/wall-lights" class="font-headline text-[1.05rem] font-[300] text-[#2d3338]/55 block">Outdoor Wall Lights</a>
      <a href="{{ routes.collections_url }}/outdoor-lighting" class="font-headline text-[1.05rem] font-[300] text-[#2d3338]/55 block">Outdoor Lighting</a>
      <a href="{{ routes.collections_url }}/path-lights"         class="font-headline text-[1.05rem] font-[300] text-[#2d3338]/55 block">Path &amp; Landscape</a>
    </div>
  </div>

  <!-- Promo cards -->
  <div class="px-5 pt-4 pb-5 space-y-3">

    <a href="{{ routes.collections_url }}/best-sellers" class="block relative overflow-hidden" style="aspect-ratio:2.5/1;">
      {%- if section.settings.mega_image_1 != blank -%}
        <img src="{{ section.settings.mega_image_1 | image_url: width: 600 }}" alt="Best Sellers" width="600" height="338" class="absolute inset-0 w-full h-full object-cover" loading="lazy">
      {%- else -%}
        <div class="mega-img absolute inset-0 w-full h-full"></div>
      {%- endif -%}
      <div class="absolute inset-0 bg-gradient-to-t from-[#131314]/60 via-transparent to-transparent"></div>
      <div class="absolute bottom-4 left-4">
        <span class="font-label text-[0.45rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-1">Shop Now</span>
        <span class="font-headline text-lg font-[200] text-white">Best Sellers</span>
      </div>
    </a>

    <a href="/collections/best-sellers" class="block relative overflow-hidden" style="aspect-ratio:2.5/1;">
      {%- if section.settings.mega_image_2 != blank -%}
        <img src="{{ section.settings.mega_image_2 | image_url: width: 600 }}" alt="Clearance Sale" width="600" height="338" class="absolute inset-0 w-full h-full object-cover" loading="lazy">
      {%- else -%}
        <div class="mega-img-2 absolute inset-0 w-full h-full"></div>
      {%- endif -%}
      <div class="absolute inset-0 bg-gradient-to-t from-[#131314]/60 via-transparent to-transparent"></div>
      <div class="absolute bottom-4 left-4">
        <span class="font-label text-[0.45rem] uppercase tracking-[0.2em] text-[#C5A059] block mb-1">Shop Now</span>
        <span class="font-headline text-lg font-[200] text-white">Clearance Sale</span>
      </div>
    </a>

  </div>

  <!-- Bottom icon nav -->
  <div class="mt-auto border-t border-[#131314]/5 px-5 py-4 flex items-center justify-between">
    <a href="/pages/support-center" class="flex flex-col items-center gap-1">
      <span class="material-symbols-outlined text-[#2d3338]/55 text-xl">headset_mic</span>
      <span class="font-label text-[0.45rem] uppercase tracking-[0.1em] text-[#2d3338]/65">Support</span>
    </a>
    <a href="{{ routes.account_url }}" class="flex flex-col items-center gap-1">
      <span class="material-symbols-outlined text-[#2d3338]/55 text-xl">person</span>
      <span class="font-label text-[0.45rem] uppercase tracking-[0.1em] text-[#2d3338]/65">Account</span>
    </a>
    <a href="{{ section.settings.nav2_url | default: '/pages/about-us' }}" class="flex flex-col items-center gap-1">
      <span class="material-symbols-outlined text-[#2d3338]/55 text-xl">info</span>
      <span class="font-label text-[0.45rem] uppercase tracking-[0.1em] text-[#2d3338]/65">About</span>
    </a>
    <a href="{{ section.settings.nav4_url | default: '/pages/trade-program-application' }}" class="flex flex-col items-center gap-1">
      <span class="material-symbols-outlined text-[#C5A059]/60 text-xl">verified</span>
      <span class="font-label text-[0.45rem] uppercase tracking-[0.1em] text-[#C5A059]/50">Trade</span>
    </a>
  </div>

</div>


<script>
(function() {
  var header = document.getElementById('site-header');
  var isIndex = {{ template.name | json }} === 'index';
  var transparentOnHome = {{ transparent_on_home | json }};
  var hasLightLogo = !!(document.getElementById('desktop-logo-light'));

  window.addEventListener('scroll', function() {
    var scrolled = window.scrollY > 80;
    var megaOpen = header.classList.contains('header-mega-open');

    if (scrolled) {
      header.classList.add('header-scrolled');
      header.classList.remove('header-wrapper--transparent');
      if (hasLightLogo) {
        var dl = document.getElementById('desktop-logo-light');
        var dd = document.getElementById('desktop-logo-dark');
        var ml = document.getElementById('mobile-logo-light');
        var md = document.getElementById('mobile-logo-dark');
        if (dl) { dl.classList.add('hidden'); }
        if (dd) { dd.classList.remove('hidden'); }
        if (ml) { ml.classList.add('hidden'); }
        if (md) { md.classList.remove('hidden'); }
      }
    } else {
      header.classList.remove('header-scrolled');
      if (isIndex && transparentOnHome && !megaOpen) {
        header.classList.add('header-wrapper--transparent');
      }
      if (hasLightLogo && isIndex && transparentOnHome) {
        var dl = document.getElementById('desktop-logo-light');
        var dd = document.getElementById('desktop-logo-dark');
        var ml = document.getElementById('mobile-logo-light');
        var md = document.getElementById('mobile-logo-dark');
        if (dl) { dl.classList.remove('hidden'); }
        if (dd) { dd.classList.add('hidden'); }
        if (ml) { ml.classList.remove('hidden'); }
        if (md) { md.classList.add('hidden'); }
      }
    }
  });
})();
</script>

<script>
  function openSearchOverlay() {
    var o = document.getElementById('search-overlay');
    var b = document.getElementById('search-backdrop');
    if (o) o.classList.add('open');
    if (b) b.classList.add('open');
    var i = document.getElementById('search-overlay-input');
    if (i) setTimeout(function () { i.focus(); }, 60);
  }
  function closeSearchOverlay() {
    var o = document.getElementById('search-overlay');
    var b = document.getElementById('search-backdrop');
    if (o) o.classList.remove('open');
    if (b) b.classList.remove('open');
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeSearchOverlay();
  });
</script>

