{%- comment -%}
  testimonials.liquid — Homepage reviews (catalog redesign round 2, variation 1)
  Three-column quote grid on warm background. Reviews are editable blocks.
  Grid: 3 cols, 1 col at <=900px.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign review_blocks = section.blocks | where: 'type', 'review' -%}

<style>
  #ol-rev-{{ section.id }}{
    --ink:#131314;--paper:#F9F9FB;--gold:#C5A059;--warm:#f4f0eb;--body:#2d3338;
    --serif:'Newsreader',Georgia,serif;
    --sans:'Manrope',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    display:block;
    background:var(--warm);
    font-family:var(--sans);
    padding:80px 0;
  }
  #ol-rev-{{ section.id }} *{box-sizing:border-box;margin:0;padding:0;}
  #ol-rev-{{ section.id }} a{color:inherit;text-decoration:none;}
  #ol-rev-{{ section.id }} .ol-container{
    width:100%;max-width:1360px;margin:0 auto;padding:0 32px;
  }
  #ol-rev-{{ section.id }} .section-head{
    display:flex;align-items:flex-end;justify-content:space-between;
    gap:32px;margin-bottom:48px;
  }
  #ol-rev-{{ section.id }} .eyebrow{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:.18em;text-transform:uppercase;color:var(--gold);
  }
  #ol-rev-{{ section.id }} .section-head h2{
    font-family:var(--serif);font-weight:200;
    font-size:clamp(28px,3.4vw,42px);line-height:1.08;letter-spacing:-0.01em;
    margin-top:16px;color:var(--ink);
  }
  #ol-rev-{{ section.id }} .section-head h2 em{font-style:italic;color:var(--gold);}
  #ol-rev-{{ section.id }} .head-link{
    font-size:13px;font-weight:500;letter-spacing:.04em;white-space:nowrap;
    padding-bottom:3px;border-bottom:1px solid var(--ink);
    transition:color .2s,border-color .2s;color:var(--ink);
  }
  #ol-rev-{{ section.id }} .head-link:hover{color:var(--gold);border-color:var(--gold);}
  #ol-rev-{{ section.id }} .review-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:24px;
  }
  #ol-rev-{{ section.id }} .review-card{
    background:var(--paper);padding:48px 32px;
    border:1px solid rgba(19,19,20,.07);
    display:flex;flex-direction:column;
  }
  #ol-rev-{{ section.id }} .stars{
    color:var(--gold);font-size:15px;letter-spacing:2px;line-height:1;
    margin-bottom:24px;
  }
  #ol-rev-{{ section.id }} .review-card blockquote{
    font-family:var(--serif);font-weight:300;font-size:21px;line-height:1.32;
    color:var(--ink);flex:1;
  }
  #ol-rev-{{ section.id }} .review-card cite{
    font-style:normal;font-size:12px;font-weight:600;letter-spacing:.06em;
    text-transform:uppercase;color:var(--body);margin-top:32px;
  }
  #ol-rev-{{ section.id }} .review-card cite span{color:var(--gold);}
  @media (max-width:900px){
    #ol-rev-{{ section.id }} .ol-container{padding:0 24px;}
    #ol-rev-{{ section.id }} .review-grid{grid-template-columns:1fr;}
  }
  @media (max-width:600px){
    #ol-rev-{{ section.id }} .ol-container{padding:0 20px;}
    #ol-rev-{{ section.id }} .section-head{
      flex-direction:column;align-items:flex-start;gap:16px;
    }
    #ol-rev-{{ section.id }} .section-head h2{margin-top:8px;}
  }
</style>

<section id="ol-rev-{{ section.id }}">
  <div class="ol-container">
    <div class="section-head">
      <div>
        {%- if s.eyebrow != blank -%}
          <span class="eyebrow">{{ s.eyebrow | escape }}</span>
        {%- endif -%}
        <h2>{{ s.heading }}</h2>
      </div>
      {%- if s.link_text != blank -%}
        <a href="{{ s.link_url | default: '/collections/best-sellers' }}" class="head-link">{{ s.link_text | escape }}</a>
      {%- endif -%}
    </div>

    <div class="review-grid">
      {%- for block in review_blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <span class="stars" aria-hidden="true">★★★★★</span>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <cite>{{ block.settings.name | escape }}{% if block.settings.location != blank %} — <span>{{ block.settings.location | escape }}</span>{% endif %}</cite>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "ol-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Verified Reviews"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading (italic = gold accent)",
      "default": "<p>From <em>real rooms</em></p>"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Read all reviews"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 6,
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "“The corner finally makes sense.”"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name",
          "default": "Marielle R."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Reviewer location",
          "default": "Portland, OR"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "“The corner finally makes sense.”",
            "name": "Marielle R.",
            "location": "Portland, OR"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "“Warmer than I expected. It changed the whole room.”",
            "name": "David O.",
            "location": "Austin, TX"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "“Shipped in four days. The entry reads intentional now.”",
            "name": "Priya N.",
            "location": "San Diego, CA"
          }
        }
      ]
    }
  ]
}
{% endschema %}
