{%- comment -%}
  hero-banner.liquid — Homepage hero (catalog redesign round 2, variation 1)
  Split layout: copy left, image right. Stacks (image first) below 900px.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign hero_cta_url = s.cta_url | default: '/collections/best-sellers' -%}
{%- if request.page_type == 'index' -%}
  {%- assign hero_cta_url = '/collections/best-sellers' -%}
{%- endif -%}
{%- assign hero_fallback = 'https://outlight.us/cdn/shop/files/custom_nano-banana-2_1774342531115.png' -%}

<style>
  #ol-hero-{{ section.id }}{
    --ink:#131314;--paper:#F9F9FB;--gold:#C5A059;--warm:#f4f0eb;--body:#2d3338;
    --serif:'Newsreader',Georgia,serif;
    --sans:'Manrope',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    display:block;
    background:var(--warm);
    border-bottom:1px solid rgba(19,19,20,.07);
    font-family:var(--sans);
  }
  #ol-hero-{{ section.id }} *{box-sizing:border-box;margin:0;padding:0;}
  #ol-hero-{{ section.id }} img{display:block;max-width:100%;}
  #ol-hero-{{ section.id }} a{color:inherit;text-decoration:none;}
  #ol-hero-{{ section.id }} .ol-container{
    width:100%;max-width:1360px;margin:0 auto;padding:0 32px;
    display:grid;
    grid-template-columns:1fr 1.08fr;
    align-items:stretch;
    gap:0;
    min-height:min(70vh,640px);
  }
  #ol-hero-{{ section.id }} .hero-copy{
    display:flex;flex-direction:column;justify-content:center;
    padding:80px 64px 80px 0;
    max-width:520px;
  }
  #ol-hero-{{ section.id }} .eyebrow{
    font-family:var(--sans);font-size:11px;font-weight:600;
    letter-spacing:.18em;text-transform:uppercase;color:var(--gold);
    margin-bottom:24px;
  }
  #ol-hero-{{ section.id }} h1{
    font-family:var(--serif);font-weight:200;
    font-size:clamp(34px,4.6vw,58px);line-height:1.04;letter-spacing:-0.015em;
    color:var(--ink);
  }
  #ol-hero-{{ section.id }} h1 em{font-style:italic;color:var(--gold);}
  #ol-hero-{{ section.id }} .subhead{
    font-size:15px;color:var(--body);margin-top:24px;max-width:42ch;line-height:1.55;
  }
  #ol-hero-{{ section.id }} .hero-ctas{
    display:flex;gap:16px;margin-top:48px;flex-wrap:wrap;
  }
  #ol-hero-{{ section.id }} .btn{
    display:inline-flex;align-items:center;justify-content:center;
    font-size:13px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;
    padding:15px 28px;min-height:48px;
    transition:transform .18s ease,background .2s,color .2s,border-color .2s;
  }
  #ol-hero-{{ section.id }} .btn-primary{background:var(--ink);color:var(--paper);}
  #ol-hero-{{ section.id }} .btn-primary:hover{background:var(--gold);color:var(--ink);transform:translateY(-2px);}
  #ol-hero-{{ section.id }} .btn-secondary{
    background:transparent;color:var(--ink);border:1px solid rgba(19,19,20,.32);
  }
  #ol-hero-{{ section.id }} .btn-secondary:hover{border-color:var(--ink);background:var(--ink);color:var(--paper);transform:translateY(-2px);}
  #ol-hero-{{ section.id }} .hero-media{
    position:relative;overflow:hidden;min-height:340px;
  }
  #ol-hero-{{ section.id }} .hero-media img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  }
  @media (max-width:900px){
    #ol-hero-{{ section.id }} .ol-container{
      grid-template-columns:1fr;min-height:0;padding:0 24px;
    }
    #ol-hero-{{ section.id }} .hero-copy{
      padding:40px 0 48px;max-width:none;order:2;
    }
    #ol-hero-{{ section.id }} .hero-media{
      order:1;
      position:relative;
      overflow:hidden;
      min-height:0;
      aspect-ratio:auto;
      height:auto;
    }
    #ol-hero-{{ section.id }} .hero-media img{
      position:static;
      inset:auto;
      width:100%;
      height:auto;
      display:block;
      aspect-ratio:16/10;
      object-fit:cover;
    }
  }
  @media (max-width:600px){
    #ol-hero-{{ section.id }} .ol-container{padding:0 20px;}
    #ol-hero-{{ section.id }} .hero-ctas .btn{flex:1;min-width:140px;}
    #ol-hero-{{ section.id }} .hero-copy{padding:32px 0 40px;}
    #ol-hero-{{ section.id }} .hero-media img{aspect-ratio:5/4;}
  }
</style>

<section id="ol-hero-{{ section.id }}">
  <div class="ol-container">
    <div class="hero-copy">
      {%- if s.eyebrow != blank -%}
        <span class="eyebrow">{{ s.eyebrow | escape }}</span>
      {%- endif -%}
      <h1>{{ s.heading }}</h1>
      {%- if s.subheading != blank -%}
        <p class="subhead">{{ s.subheading | escape }}</p>
      {%- endif -%}
      <div class="hero-ctas">
        {%- if s.cta_text != blank -%}
          <a href="{{ hero_cta_url | escape }}" class="btn btn-primary">{{ s.cta_text | escape }}</a>
        {%- endif -%}
        {%- if s.cta_secondary_text != blank -%}
          <a href="{{ s.cta_secondary_url | default: '/collections/best-sellers' }}" class="btn btn-secondary">{{ s.cta_secondary_text | escape }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="hero-media">
      {%- if s.image != blank -%}
        <img
          src="{{ s.image | image_url: width: 1400 }}"
          srcset="{{ s.image | image_url: width: 800 }} 800w, {{ s.image | image_url: width: 1400 }} 1400w, {{ s.image | image_url: width: 2000 }} 2000w"
          sizes="(max-width:900px) 100vw, 52vw"
          width="1400"
          height="1280"
          alt="{{ s.image.alt | default: 'Outlight lighting in a finished room' | escape }}"
          loading="eager">
      {%- else -%}
        <img src="{{ hero_fallback }}" width="1400" height="1280" alt="A modern glass house at dusk with Outlight floor lamps glowing warmly inside" loading="eager">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "ol-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Los Angeles · Est. 2024"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading (italic = gold accent)",
      "default": "<p>Lighting that makes the room <em>feel finished.</em></p>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Warm, sculptural floor lamps, table lights and wall fixtures — curated for real rooms."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Primary button text",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary button link",
      "info": "On the homepage, this button always opens Best Sellers. This link setting applies only on other pages."
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary button text",
      "default": "Browse All Lighting"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Falls back to the approved mockup image when blank."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
