{%- comment -%}
  about-philosophy.liquid — Editorial "what we curate" section
  Section head + a numbered grid of curation standards (editable value blocks).
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign value_blocks = section.blocks | where: 'type', 'value' -%}

<style>
  #ed-aboutphil-{{ section.id }}{
    --ink:#131314;--paper:#F9F9FB;--gold:#C5A059;--warm:#f4f0eb;
    --body:#2d3338;--hairline:rgba(19,19,20,.14);--measure:1320px;
    display:block;background:var(--paper);font-family:'Manrope',sans-serif;
    padding:96px 0;
  }
  #ed-aboutphil-{{ section.id }} *{box-sizing:border-box;}
  #ed-aboutphil-{{ section.id }} .ed-wrap{
    max-width:var(--measure);margin:0 auto;padding:0 40px;
  }
  #ed-aboutphil-{{ section.id }} .ed-label{
    font-family:'Manrope',sans-serif;font-weight:500;font-size:11px;
    letter-spacing:.26em;text-transform:uppercase;color:var(--body);
  }
  #ed-aboutphil-{{ section.id }} .sec-head{
    display:flex;align-items:flex-start;gap:30px;margin-bottom:54px;
  }
  #ed-aboutphil-{{ section.id }} .sec-head__marker{flex:none;}
  #ed-aboutphil-{{ section.id }} .marker{
    font-family:'Newsreader',serif;font-weight:200;font-style:italic;
    font-size:clamp(2rem,4vw,3.1rem);color:var(--gold);line-height:1;display:inline-block;
  }
  #ed-aboutphil-{{ section.id }} .sec-head__text{flex:1;}
  #ed-aboutphil-{{ section.id }} .sec-head__label{margin-bottom:18px;display:block;}
  #ed-aboutphil-{{ section.id }} .sec-head h2{
    font-family:'Newsreader',serif;font-weight:200;
    font-size:clamp(2.3rem,4.6vw,3.6rem);line-height:1.04;letter-spacing:-.012em;
    max-width:16ch;color:var(--ink);margin:0;
  }
  #ed-aboutphil-{{ section.id }} .sec-head h2 em{font-style:italic;font-weight:300;color:var(--gold);}
  #ed-aboutphil-{{ section.id }} .sec-head__aside{
    flex:none;width:280px;padding-top:8px;border-top:1px solid var(--hairline);
  }
  #ed-aboutphil-{{ section.id }} .sec-head__aside p{
    font-size:14px;color:var(--body);line-height:1.7;padding-top:14px;
    font-weight:300;margin:0;
  }
  #ed-aboutphil-{{ section.id }} .phil__grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--hairline);
    border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline);
  }
  #ed-aboutphil-{{ section.id }} .phil__cell{
    background:var(--paper);padding:42px 36px;display:flex;flex-direction:column;
  }
  #ed-aboutphil-{{ section.id }} .phil__num{
    font-family:'Newsreader',serif;font-style:italic;font-weight:300;
    font-size:20px;color:var(--gold);margin-bottom:22px;
  }
  #ed-aboutphil-{{ section.id }} .phil__title{
    font-family:'Newsreader',serif;font-weight:300;font-size:23px;line-height:1.25;
    color:var(--ink);margin:0;
  }
  #ed-aboutphil-{{ section.id }} .phil__desc{
    font-size:14px;color:var(--body);line-height:1.7;font-weight:300;
    margin:14px 0 0;
  }
  @media (max-width:880px){
    #ed-aboutphil-{{ section.id }}{padding:64px 0;}
    #ed-aboutphil-{{ section.id }} .ed-wrap{padding:0 22px;}
    #ed-aboutphil-{{ section.id }} .sec-head{flex-direction:column;gap:20px;margin-bottom:40px;}
    #ed-aboutphil-{{ section.id }} .sec-head__aside{width:100%;}
    #ed-aboutphil-{{ section.id }} .phil__grid{grid-template-columns:1fr;}
  }
  @media (max-width:680px){
    #ed-aboutphil-{{ section.id }} .ed-wrap{padding:0 20px;}
    #ed-aboutphil-{{ section.id }} .marker{font-size:1.9rem;}
    #ed-aboutphil-{{ section.id }} .sec-head h2{max-width:none;}
    #ed-aboutphil-{{ section.id }} .phil__cell{padding:34px 24px;}
    #ed-aboutphil-{{ section.id }} .phil__title{font-size:21px;}
  }
</style>

<section id="ed-aboutphil-{{ section.id }}">
  <div class="ed-wrap">

    <div class="sec-head">
      {%- if s.marker != blank -%}
        <div class="sec-head__marker"><span class="marker">{{ s.marker | escape }}</span></div>
      {%- endif -%}
      <div class="sec-head__text">
        {%- if s.label != blank -%}
          <span class="sec-head__label ed-label">{{ s.label | escape }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2>{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if s.aside_text != blank -%}
        <div class="sec-head__aside">
          <p>{{ s.aside_text | escape }}</p>
        </div>
      {%- endif -%}
    </div>

    {%- if value_blocks.size > 0 -%}
      <div class="phil__grid">
        {%- for block in value_blocks -%}
          <div class="phil__cell" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}
              <span class="phil__num">{{ block.settings.number | escape }}</span>
            {%- endif -%}
            <h3 class="phil__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="phil__desc">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "About Philosophy",
  "tag": "section",
  "class": "ed-aboutphil-section",
  "settings": [
    {
      "type": "text",
      "id": "marker",
      "label": "Section number marker",
      "default": "02"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "What we curate"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>We don't make the light. <em>We choose it well.</em></p>"
    },
    {
      "type": "textarea",
      "id": "aside_text",
      "label": "Aside text",
      "default": "Outlight is a curated range. We select for one quality of light, quality-check every piece, and stand behind what we ship."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Selected for warm light"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Every lamp earns its place by one test — a soft, warm glow that flatters a room, never a cool, clinical wash."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Philosophy",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "number": "01",
            "title": "Selected for warm light",
            "description": "Every lamp earns its place by one test — a soft, warm glow that flatters a room, never a cool, clinical wash."
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "02",
            "title": "Sculptural, not loud",
            "description": "We look for forms that hold a corner and age with a space — quiet silhouettes that read considered, not decorative."
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "03",
            "title": "Quality-checked, then backed",
            "description": "Each piece is inspected before it ships and supported by our customer care team. Outdoor fixtures carry a two-year warranty under our published policy."
          }
        }
      ]
    }
  ]
}
{% endschema %}
