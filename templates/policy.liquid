{% comment %}
  Policy Page Template
  Renders Shopify legal pages (Privacy Policy, Refund Policy, etc.)
  from Admin → Settings → Policies.
{% endcomment %}

<div class="max-w-3xl mx-auto px-4 py-16 md:py-24">
  <h1 class="font-heading text-3xl md:text-4xl font-[300] text-[#131314] mb-8">{{ policy.title }}</h1>
  <div class="policy-body font-body text-sm md:text-base font-[300] text-[#2d3338] leading-relaxed space-y-4">
    {{ policy.body }}
  </div>
</div>

<style>
  .policy-body h2 {
    font-size: 1.25rem;
    font-weight: 400;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #131314;
  }
  .policy-body h3 {
    font-size: 1.1rem;
    font-weight: 400;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #131314;
  }
  .policy-body p {
    margin-bottom: 1rem;
  }
  .policy-body ul, .policy-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .policy-body li {
    margin-bottom: 0.25rem;
  }
  .policy-body a {
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }
  .policy-body a:hover {
    color: #131314;
  }
</style>
