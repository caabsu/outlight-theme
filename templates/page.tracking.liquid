{% layout none %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="refresh" content="0;url={{ shop.url }}/pages/support-center">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <link rel="canonical" href="{{ shop.url }}/pages/support-center">
    <title>Redirecting to Support Center</title>
    <script>
      window.location.replace({{ shop.url | append: '/pages/support-center' | json }});
    </script>
  </head>
  <body>
    <p>Redirecting to the <a href="{{ shop.url }}/pages/support-center">Support Center</a>.</p>
  </body>
</html>
